#!/bin/sh
# Versioned after vendor media startup: S99 runs after vendor S* services.
set -eu

PREFIX=/opt/ls200-zoom/current
STATE=/var/lib/cbox/ls200-zoom
RUNTIME_STATE=/run/ls200-zoom-state
PID_DIR=/var/run/ls200-zoom
CONTROL_DIR=/run/ls200-sipd
GATEWAY_DIR=/run/ls200-console
READY_MARKER=${LS200_VENDOR_MEDIA_READY_MARKER:-/var/run/cbox/vendor-media.ready}
RESOLVER_FILE=/etc/resolv.conf

sip_dns_servers() {
    # Read DHCP state while still privileged: vendor /etc and /var are 0700.
    [ -e "$RESOLVER_FILE" ] || return 0
    resolver=$(readlink -f "$RESOLVER_FILE") || return 1
    [ -f "$resolver" ] && [ -O "$resolver" ] || return 1
    find "$resolver" -prune \( -perm -020 -o -perm -002 \) | grep -q . && return 1
    [ "$(wc -c < "$resolver")" -le 4096 ] || return 1
    awk '$1 == "nameserver" {
        if (NF < 2 || ++count > 3) exit 1
        printf "%s%s", (count == 1 ? "" : ","), $2
    }' "$resolver"
}

prepare_state_view() {
    mkdir -p "$RUNTIME_STATE"
    if awk -v path="$RUNTIME_STATE" '$2 == path { found = 1 } END { exit !found }' \
        /proc/mounts; then
        return 0
    fi
    mount -o bind "$STATE" "$RUNTIME_STATE" || {
        printf '%s\n' 'cannot expose owned persistent state to unprivileged services' >&2
        return 1
    }
}

release_state_view() {
    if awk -v path="$RUNTIME_STATE" '$2 == path { found = 1 } END { exit !found }' \
        /proc/mounts; then
        umount "$RUNTIME_STATE" || return 1
    fi
    rmdir "$RUNTIME_STATE" 2>/dev/null || true
}

start_one() {
    name=$1
    identity=$2
    pid=$PID_DIR/$name.pid
    [ ! -e "$pid" ] && [ ! -L "$pid" ] || {
        printf '%s\n' "refusing existing PID path: $pid" >&2
        return 1
    }
    unset LS200_SIPD_DNS_SERVERS
    if [ "$name" = sip ]; then
        dns_servers=$(sip_dns_servers) || return 1
        if [ -n "$dns_servers" ]; then
            LS200_SIPD_DNS_SERVERS=$dns_servers
            export LS200_SIPD_DNS_SERVERS
        fi
    fi
    start-stop-daemon -S -b -m -p "$pid" -c "$identity" \
        -x "$PREFIX/bin/ls200-zoom-service" -- "$name" || return 1
    unset LS200_SIPD_DNS_SERVERS
}

pid_is_live() {
    pid_file=$1
    [ -f "$pid_file" ] && [ ! -L "$pid_file" ] || return 1
    service_pid=$(cat "$pid_file") || return 1
    case $service_pid in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ -r "/proc/$service_pid/stat" ] || return 1
    process_state=$(awk '{ print $3; exit }' "/proc/$service_pid/stat") || return 1
    [ "$process_state" != Z ] && kill -0 "$service_pid" 2>/dev/null
}

service_executable_name() {
    case $1 in
        web) printf '%s\n' nginx ;;
        gateway) printf '%s\n' ls200-gateway-fcgi ;;
        device) printf '%s\n' ls200-device-control ;;
        sip) printf '%s\n' ls200-sipd ;;
        *) return 1 ;;
    esac
    return 0
}

resolve_service_executable() {
    name=$1
    executable_name=$(service_executable_name "$name") || return 1
    release_prefix=$(CDPATH='' cd -P "$PREFIX" 2>/dev/null && pwd) || {
        printf '%s\n' 'cannot resolve active release for service shutdown' >&2
        return 1
    }
    release_base=${PREFIX%/current}/releases
    case $release_prefix in
        "$release_base"/*) ;;
        *) printf '%s\n' 'active release resolved outside owned releases' >&2; return 1 ;;
    esac
    release_version=${release_prefix#"$release_base"/}
    case $release_version in
        ''|*/*|*[!A-Za-z0-9._-]*)
            printf '%s\n' 'active release version is unsafe' >&2
            return 1 ;;
    esac
    printf '%s/bin/%s\n' "$release_prefix" "$executable_name"
}

read_owned_pid() {
    pid=$1
    [ -f "$pid" ] && [ ! -L "$pid" ] && [ -O "$pid" ] || {
        printf '%s\n' "refusing unsafe PID path: $pid" >&2
        return 1
    }
    if find "$pid" -prune \( -perm -002 -o -perm -020 \) | grep -q .; then
        printf '%s\n' "refusing writable PID file: $pid" >&2
        return 1
    fi
    service_pid=$(cat "$pid") || return 1
    case $service_pid in
        ''|*[!0-9]*)
            printf '%s\n' "refusing invalid PID contents: $pid" >&2
            return 1 ;;
    esac
    printf '%s\n' "$service_pid"
}

terminate_owned_pid() {
    name=$1
    pid=$2
    service_pid=$3
    executable=$4
    kill "$service_pid" 2>/dev/null || true
    attempts=0
    while pid_is_live "$pid" && [ "$attempts" -lt 10 ]; do
        sleep 1
        attempts=$((attempts + 1))
    done
    if pid_is_live "$pid"; then
        actual_executable=$(readlink "/proc/$service_pid/exe") || return 1
        [ "$actual_executable" = "$executable" ] || return 1
        kill -KILL "$service_pid" 2>/dev/null || true
        sleep 1
    fi
    pid_is_live "$pid" && {
        printf '%s\n' "owned service did not stop: $name" >&2
        return 1
    }
    return 0
}

stop_one() {
    name=$1
    pid=$PID_DIR/$name.pid
    service_executable_name "$name" >/dev/null || return 1
    [ -e "$pid" ] || return 0
    executable=$(resolve_service_executable "$name") || return 1
    service_pid=$(read_owned_pid "$pid") || return 1
    if [ ! -e "/proc/$service_pid/exe" ]; then
        rm -f "$pid"
        return 0
    fi
    actual_executable=$(readlink "/proc/$service_pid/exe") || return 1
    [ "$actual_executable" = "$executable" ] || {
        printf '%s\n' "refusing PID with unexpected executable: $pid" >&2
        return 1
    }
    terminate_owned_pid "$name" "$pid" "$service_pid" "$executable" || return 1
    rm -f "$pid"
}

stop_all() {
    stop_failed=0
    stop_one web || stop_failed=1
    stop_one gateway || stop_failed=1
    stop_one sip || stop_failed=1
    stop_one device || stop_failed=1
    release_state_view || stop_failed=1
    [ "$stop_failed" = 0 ]
}

fail_startup() {
    failed_service=$1
    printf '%s\n' "service failed during startup: $failed_service" >&2
    stop_all || printf '%s\n' 'service cleanup failed after startup failure' >&2
    exit 1
}

case ${1:-start} in
    start)
        mkdir -p "$PID_DIR" "$CONTROL_DIR" "$GATEWAY_DIR" "$STATE" "$STATE/sip"
        chown root:root "$PID_DIR"
        chmod 0755 "$PID_DIR"
        chown ls200-sip:ls200-control "$CONTROL_DIR"
        chmod 2750 "$CONTROL_DIR"
        chown ls200-gateway:ls200-web-gateway "$GATEWAY_DIR"
        chmod 2750 "$GATEWAY_DIR"
        chown ls200-sip "$STATE/sip"
        chmod 0700 "$STATE/sip"
        # A production target supplies this marker after its vendor media init.
        # In the prototype no media runtime is claimed, so starting is refused.
        [ -e "$READY_MARKER" ] || { printf '%s\n' 'vendor media is not ready' >&2; exit 1; }
        [ -d "$STATE/device" ] && [ ! -L "$STATE/device" ] || fail_startup device
        prepare_state_view
        start_one device root || fail_startup device
        sleep 1
        start_one sip ls200-sip || fail_startup sip
        sleep 1
        start_one gateway ls200-gateway || fail_startup gateway
        sleep 1
        start_one web ls200-web || fail_startup web
        sleep 1
        for service in device sip gateway web; do
            pid=$PID_DIR/$service.pid
            pid_is_live "$pid" || fail_startup "$service"
        done
        ;;
    stop)
        stop_all
        ;;
    restart) "$0" stop; "$0" start ;;
    *) printf '%s\n' "usage: $0 {start|stop|restart}" >&2; exit 2 ;;
esac
