#!/bin/sh
# Dispatches only fixed, version-owned production component paths.
set -eu

case ${1:-} in
    web)
        executable=/opt/ls200-zoom/current/bin/nginx
        log=/run/ls200-zoom-state/nginx/service.log
        set -- "$executable" -p /run/ls200-zoom-state/nginx \
            -e /run/ls200-zoom-state/nginx/nginx-error.log \
            -c /opt/ls200-zoom/current/etc/nginx/nginx.conf \
            -g 'daemon off;'
        ;;
    gateway)
        executable=/opt/ls200-zoom/current/bin/ls200-gateway-fcgi
        log=/run/ls200-zoom-state/gateway/service.log
        set -- "$executable" --policy \
            /run/ls200-zoom-state/gateway.conf --listen \
            /run/ls200-console/gateway.fcgi.sock
        ;;
    device)
        executable=/opt/ls200-zoom/current/bin/ls200-device-control
        log=/run/ls200-zoom-state/device/service.log
        set -- "$executable" --launch
        ;;
    sip)
        executable=/opt/ls200-zoom/current/bin/ls200-sipd
        log=/run/ls200-zoom-state/sip/service.log
        export LS200_SIPD_ENABLE_LOCAL_RTSP=1
        set -- "$executable" --foreground --config \
            /run/ls200-zoom-state/ls200-sipd.conf
        ;;
    *) printf '%s\n' 'error: service must be web, gateway, device, or sip' >&2; exit 2 ;;
esac
[ -x "$executable" ] || {
    printf '%s\n' "error: production component is absent: $executable" >&2
    exit 78
}
exec "$@" >> "$log" 2>&1
