#!/bin/sh
# Verify a release payload before it becomes an immutable installed version.
set -eu

ROOT=$(CDPATH='' cd "$(dirname "$0")/.." && pwd)
MANIFEST=$ROOT/payload-manifest.tsv
[ -f "$MANIFEST" ] && [ ! -L "$MANIFEST" ] || {
    printf '%s\n' 'error: payload manifest is absent or unsafe' >&2
    exit 1
}
IFS= read -r header < "$MANIFEST" || true
[ "$header" = 'aula-ti8168-sip-endpoint-payload-v1' ] || {
    printf '%s\n' 'error: unsupported payload manifest' >&2
    exit 1
}
count=0
tab=$(printf '\t')
for required in \
    bin/aula-sipd bin/aula-gateway-fcgi bin/aula-device-control bin/nginx bin/aula-atomic-replace \
    bin/aula-service bin/verify-aula-ti8168-sip-endpoint-payload \
    etc/init.d/S99aula etc/nginx/nginx.conf etc/nginx/mime.types \
    etc/nginx/fastcgi_params \
    etc/aula-ti8168-sip-endpoint/aula-sipd.conf.example \
    etc/aula-ti8168-sip-endpoint/gateway.conf.example ui/zoom/index.html
do
    awk -F "$tab" -v required="$required" '$1 == required { found = 1 } END { exit !found }' \
        "$MANIFEST" || { printf '%s\n' "error: payload manifest lacks required path: $required" >&2; exit 1; }
done
entries=$(mktemp "${TMPDIR:-/tmp}/aula-ti8168-sip-endpoint-manifest.XXXXXX") || exit 1
trap 'rm -f "$entries"' 0 1 2 15
sed '1d' "$MANIFEST" > "$entries"
while IFS="$tab" read -r relative mode expected size; do
    case $relative in ''|/*|*'..'*|*'//'*) exit 1 ;; esac
    case $mode in [0-7][0-7][0-7][0-7]) ;; *) exit 1 ;; esac
    [ "${#expected}" -eq 64 ] || exit 1
    case $expected in *[!0-9a-f]*) exit 1 ;; esac
    case $size in ''|*[!0-9]*) exit 1 ;; esac
    file=$ROOT/$relative
    [ -f "$file" ] && [ ! -L "$file" ] || exit 1
    [ "$(wc -c < "$file" | tr -d ' ')" = "$size" ] || exit 1
    permissions=$(LC_ALL=C ls -ld "$file" | awk '{print $1}')
    permissions=${permissions%@}
    permissions=${permissions%+}
    case "$mode:$permissions" in
        0444:-r--r--r--|0555:-r-xr-xr-x) ;;
        *) exit 1 ;;
    esac
    [ "$(sha256sum "$file" | awk '{print $1}')" = "$expected" ] || exit 1
    count=$((count + 1))
done < "$entries"
[ "$count" -gt 0 ] || { printf '%s\n' 'error: payload manifest has no entries' >&2; exit 1; }
rm -f "$entries"
trap - 0 1 2 15
printf '%s\n' 'Aula Zoom payload verified' || true
exit 0
