+#define EMAC_MAX_FRAME                  2048
+
+typedef struct TI8168CPDMADesc {
+    uint32_t next;
+    uint32_t buffer;
+    uint32_t buflen;
+    uint32_t mode;
+} QEMU_PACKED TI8168CPDMADesc;
+
+typedef struct TI8168EMACState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    MemoryRegion regs;
+    MemoryRegion ctrl_ram;
+    qemu_irq rx_thresh_irq;
+    qemu_irq rx_irq;
+    qemu_irq tx_irq;
+    qemu_irq misc_irq;
+    NICConf conf;
+    NICState *nic;
+    QEMUBH *tx_bh;
+    uint32_t mdio_control;
+    uint32_t mdio_access;
+    uint32_t mdio_int_raw;
+    uint32_t mdio_int_mask;
+    uint16_t phy[TI8168_EMAC_PHY_COUNT][32];
+    uint32_t tx_control;
+    uint32_t rx_control;
+    uint32_t dma_control;
+    uint32_t rx_buffer_offset;
+    uint32_t rx_mbp_enable;
+    uint32_t rx_unicast;
+    uint32_t rx_max_len;
+    uint32_t mac_control;
+    uint32_t mac_src_addr_lo;
+    uint32_t mac_src_addr_hi;
+    uint32_t mac_addr_lo[8];
+    uint32_t mac_addr_hi[8];
+    uint32_t mac_index;
+    uint32_t tx_hdp;
+    uint32_t rx_hdp;
+    uint32_t tx_cp;
+    uint32_t rx_cp;
+    uint32_t tx_raw;
+    uint32_t tx_mask;
+    uint32_t rx_raw;
+    uint32_t rx_mask;
+    uint32_t dma_raw;
+    uint32_t dma_mask;
+    uint32_t rx_int_enable;
+    uint32_t tx_int_enable;
+} TI8168EMACState;
+
+#define TI8168_EMAC(obj) OBJECT_CHECK(TI8168EMACState, (obj), TYPE_TI8168_EMAC)
+
+static void ti8168_emac_update_irqs(TI8168EMACState *s)
+{
+    qemu_set_irq(s->rx_thresh_irq, 0);
+    /*
+     * TI8168 routes the v0 CPDMA RX and TX events to separate SoC IRQ
+     * inputs.  The modeled interrupt registers enable those inputs through
+     * platform-style callbacks, rather than CPDMA's v1 mask
+     * registers.  Do not suppress a pending v0 event when those optional
+     * diagnostic masks remain clear.
+     */
+    qemu_set_irq(s->rx_irq, !!(s->rx_int_enable & s->rx_raw & BIT(0)));
+    qemu_set_irq(s->tx_irq, !!(s->tx_int_enable & s->tx_raw & BIT(0)));
+    qemu_set_irq(s->misc_irq, !!s->dma_raw);
+}
+
+static int ti8168_emac_phy_index(unsigned phy)
+{
+    switch (phy) {
+    case TI8168_EMAC_PHY_ADDR_ETH0:
+        return 0;
+    case TI8168_EMAC_PHY_ADDR_ETH1:
+        return 1;
+    default:
+        return -1;
+    }
+}
+
+static void ti8168_emac_seed_mac(TI8168EMACState *s)
+{
+    const uint8_t *mac = s->conf.macaddr.a;
+    uint32_t lo = mac[0] | (mac[1] << 8) | (mac[2] << 16) | (mac[3] << 24);
+    uint32_t hi = mac[4] | (mac[5] << 8);
+
+    /* The driver obtains its permanent address from MACADDR[0]. */
+    s->mac_addr_lo[0] = lo;
+    s->mac_addr_hi[0] = hi;
+    s->mac_src_addr_hi = lo;
+    s->mac_src_addr_lo = hi;
+}
+
+static void ti8168_emac_clear_dma(TI8168EMACState *s)
+{
+    s->tx_control = 0;
+    s->rx_control = 0;
+    s->dma_control = 0;
+    s->rx_buffer_offset = 0;
+    s->tx_hdp = 0;
+    s->rx_hdp = 0;
+    s->tx_cp = 0;
+    s->rx_cp = 0;
+    s->tx_raw = 0;
+    s->tx_mask = 0;
+    s->rx_raw = 0;
+    s->rx_mask = 0;
+    s->dma_raw = 0;
+    s->dma_mask = 0;
+}
+
+static void ti8168_emac_reset_state(TI8168EMACState *s)
+{
+    unsigned i;
+
+    memset(s->phy, 0, sizeof(s->phy));
+    for (i = 0; i < TI8168_EMAC_PHY_COUNT; i++) {
+        s->phy[i][0] = 0x1140;
+        s->phy[i][1] = 0x786d;
+        s->phy[i][2] = 0x2000;
+        s->phy[i][3] = 0x5c90;
+        s->phy[i][4] = 0x01e1;
+        s->phy[i][5] = 0x01e1;
+        s->phy[i][9] = 0x0200;
+    }
+    s->mdio_control = MDIO_CONTROL_IDLE;
+    s->mdio_access = 0;
+    s->mdio_int_raw = 0;
+    s->mdio_int_mask = 0;
+    ti8168_emac_clear_dma(s);
+    s->rx_mbp_enable = 0;
+    s->rx_unicast = 0;
+    s->rx_max_len = EMAC_DEFAULT_RX_MAX_LEN;
+    s->mac_control = 0;
+    s->mac_src_addr_lo = 0;
+    s->mac_src_addr_hi = 0;
+    memset(s->mac_addr_lo, 0, sizeof(s->mac_addr_lo));
+    memset(s->mac_addr_hi, 0, sizeof(s->mac_addr_hi));
+    ti8168_emac_seed_mac(s);
+    s->mac_index = 0;
+    s->rx_int_enable = 0;
+    s->tx_int_enable = 0;
+    ti8168_emac_update_irqs(s);
+}
+
+static void ti8168_emac_reset(DeviceState *dev)
+{
+    ti8168_emac_reset_state(TI8168_EMAC(dev));
+}
+
+static void ti8168_emac_cpdma_reset(TI8168EMACState *s)
+{
+    ti8168_emac_clear_dma(s);
+    ti8168_emac_update_irqs(s);
+}
+
+static bool ti8168_emac_read_desc(dma_addr_t addr, TI8168CPDMADesc *desc)
+{
+    TI8168CPDMADesc le_desc;
+
+    if (dma_memory_read(&address_space_memory, addr, &le_desc, sizeof(le_desc),
+                        MEMTXATTRS_UNSPECIFIED)) {
+        return false;
+    }
+    desc->next = le32_to_cpu(le_desc.next);
+    desc->buffer = le32_to_cpu(le_desc.buffer);
+    desc->buflen = le32_to_cpu(le_desc.buflen);
+    desc->mode = le32_to_cpu(le_desc.mode);
+    return true;
+}
+
+/* The TI81xx kernel supplies CPDMA buffer addresses in its direct-map view. */
+static dma_addr_t ti8168_emac_buffer_addr(uint32_t addr)
+{
+    if (addr >= TI8168_DMA_DIRECT_BASE && addr < TI8168_DMA_DIRECT_END) {
+        return (dma_addr_t)addr + TI8168_DMA_QEMU_OFFSET;
+    }
+    return addr;
+}
+
+static bool ti8168_emac_write_desc(dma_addr_t addr, const TI8168CPDMADesc *desc)
+{
+    TI8168CPDMADesc le_desc = {
+        .next = cpu_to_le32(desc->next),
+        .buffer = cpu_to_le32(desc->buffer),
+        .buflen = cpu_to_le32(desc->buflen),
+        .mode = cpu_to_le32(desc->mode),
+    };
+
+    return !dma_memory_write(&address_space_memory, addr, &le_desc,
+                             sizeof(le_desc), MEMTXATTRS_UNSPECIFIED);
+}
+
+static void ti8168_emac_host_error(TI8168EMACState *s, const char *what)
+{
+    qemu_log_mask(LOG_GUEST_ERROR, "ti8168-emac: %s\n", what);
+    s->dma_raw |= CPDMA_HOST_ERROR;
+    ti8168_emac_update_irqs(s);
+}
+
+static void ti8168_emac_schedule_tx(TI8168EMACState *s);
+
+static void ti8168_emac_process_tx(void *opaque)
+{
+    TI8168EMACState *s = opaque;
+    TI8168CPDMADesc desc;
+    uint8_t *frame;
+    uint32_t length;
+    uint32_t addr = s->tx_hdp;
+
+    if (!(s->tx_control & 1) || !addr) {
+        return;
+    }
+    if (!ti8168_emac_read_desc(addr, &desc)) {
+        ti8168_emac_host_error(s, "cannot read TX descriptor");
+        return;
+    }
+    length = desc.buflen & CPDMA_DESC_LEN;
+    if (!(desc.mode & CPDMA_OWNER) || !desc.buffer || !length ||
+        length > EMAC_MAX_FRAME) {
+        ti8168_emac_host_error(s, "unsupported TX descriptor");
+        return;
+    }
+    frame = g_malloc(length);
+    if (dma_memory_read(&address_space_memory,
+                        ti8168_emac_buffer_addr(desc.buffer), frame, length,
+                        MEMTXATTRS_UNSPECIFIED)) {
+        g_free(frame);
+        ti8168_emac_host_error(s, "cannot read TX frame");
+        return;
+    }
+    qemu_send_packet(qemu_get_queue(s->nic), frame, length);
+    g_free(frame);
+    desc.mode &= ~(CPDMA_OWNER | CPDMA_EOQ);
+    if (!desc.next) {
+        desc.mode |= CPDMA_EOQ;
+    }
+    if (!ti8168_emac_write_desc(addr, &desc)) {
+        ti8168_emac_host_error(s, "cannot complete TX descriptor");
+        return;
+    }
+    s->tx_hdp = desc.next;
+    s->tx_cp = addr;
+    s->tx_raw |= BIT(0);
+    ti8168_emac_update_irqs(s);
+    if (s->tx_hdp) {
+        ti8168_emac_schedule_tx(s);
+    }
+}
+
+static void ti8168_emac_schedule_tx(TI8168EMACState *s)
+{
+    qemu_bh_schedule(s->tx_bh);
+}
+
+static void ti8168_emac_mac(const TI8168EMACState *s, uint8_t mac[ETH_ALEN])
+{
+    mac[0] = s->mac_src_addr_hi;
+    mac[1] = s->mac_src_addr_hi >> 8;
+    mac[2] = s->mac_src_addr_hi >> 16;
+    mac[3] = s->mac_src_addr_hi >> 24;
+    mac[4] = s->mac_src_addr_lo;
+    mac[5] = s->mac_src_addr_lo >> 8;
+}
+
+static bool ti8168_emac_accept(const TI8168EMACState *s, const uint8_t *buf,
+                                size_t size)
+{
+    uint8_t mac[ETH_ALEN];
+
+    if (size < ETH_ALEN || !s->rx_mbp_enable) {
+        return false;
+    }
+    if (s->rx_mbp_enable & RXMBP_PROMISC) {
+        return true;
+    }
+    if (!memcmp(buf, "\377\377\377\377\377\377", ETH_ALEN)) {
+        return s->rx_mbp_enable & RXMBP_BROADCAST;
+    }
+    if (buf[0] & 1) {
+        return s->rx_mbp_enable & RXMBP_MULTICAST;
+    }
+    ti8168_emac_mac(s, mac);
+    return (s->rx_unicast & BIT(0)) && !memcmp(buf, mac, ETH_ALEN);
+}
+
+static bool ti8168_emac_can_receive(NetClientState *nc)
+{
+    TI8168EMACState *s = qemu_get_nic_opaque(nc);
+    TI8168CPDMADesc desc;
+
+    return (s->rx_control & 1) && s->rx_hdp &&
+           ti8168_emac_read_desc(s->rx_hdp, &desc) &&
+           (desc.mode & CPDMA_OWNER) && desc.buffer &&
+           (desc.buflen & CPDMA_DESC_LEN);
+}
+
+static ssize_t ti8168_emac_receive(NetClientState *nc, const uint8_t *buf,
+                                    size_t size)
+{
+    TI8168EMACState *s = qemu_get_nic_opaque(nc);
+    TI8168CPDMADesc desc;
+    uint32_t addr = s->rx_hdp;
+    uint32_t length;
+    bool oversized = size > s->rx_max_len;
+
+    if (!ti8168_emac_can_receive(nc) || !ti8168_emac_accept(s, buf, size) ||
+        (oversized && !(s->rx_mbp_enable & RXMBP_ERROR_FRAMES))) {
+        return size;
+    }
+    if (!ti8168_emac_read_desc(addr, &desc)) {
+        ti8168_emac_host_error(s, "cannot read RX descriptor");
+        return -1;
+    }
+    length = MIN(MIN(size, s->rx_max_len),
+                 desc.buflen & CPDMA_DESC_LEN);
+    if (dma_memory_write(&address_space_memory,
+                         ti8168_emac_buffer_addr(desc.buffer +
+                                                 s->rx_buffer_offset),
+                         buf, length, MEMTXATTRS_UNSPECIFIED)) {
+        ti8168_emac_host_error(s, "cannot write RX frame");
+        return -1;
+    }
+    desc.mode = (desc.mode & ~(CPDMA_OWNER | CPDMA_EOQ | CPDMA_OVERSIZE |
+                               CPDMA_DESC_LEN)) |
+                CPDMA_SOP | CPDMA_EOP | length;
+    if (oversized) {
+        desc.mode |= CPDMA_OVERSIZE;
+    }
+    if (!desc.next) {
+        desc.mode |= CPDMA_EOQ;
+    }
+    if (!ti8168_emac_write_desc(addr, &desc)) {
+        ti8168_emac_host_error(s, "cannot complete RX descriptor");
+        return -1;
+    }
+    s->rx_hdp = desc.next;
+    s->rx_cp = addr;
+    s->rx_raw |= BIT(0);
+    ti8168_emac_update_irqs(s);
+    return size;
+}
+
+#include "ti8168_emac_regs.inc"
+
+static NetClientInfo ti8168_emac_net_info = {
+    .type = NET_CLIENT_DRIVER_NIC,
+    .size = sizeof(NICState),
+    .can_receive = ti8168_emac_can_receive,
+    .receive = ti8168_emac_receive,
+};
+
+static void ti8168_emac_realize(DeviceState *dev, Error **errp)
+{
+    TI8168EMACState *s = TI8168_EMAC(dev);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
+
+    memory_region_init(&s->iomem, OBJECT(dev), TYPE_TI8168_EMAC, EMAC_SIZE);
+    memory_region_init_io(&s->regs, OBJECT(dev), &ti8168_emac_ops, s,
+                          TYPE_TI8168_EMAC "-regs", CPDMA_CTRL_RAM);
+    memory_region_init_ram(&s->ctrl_ram, OBJECT(dev), TYPE_TI8168_EMAC
+                           "-ctrl-ram", CPDMA_CTRL_RAM_SIZE, &error_fatal);
+    memory_region_add_subregion(&s->iomem, 0, &s->regs);
+    memory_region_add_subregion(&s->iomem, CPDMA_CTRL_RAM, &s->ctrl_ram);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->rx_thresh_irq);
+    sysbus_init_irq(sbd, &s->rx_irq);
+    sysbus_init_irq(sbd, &s->tx_irq);
+    sysbus_init_irq(sbd, &s->misc_irq);
+    qemu_macaddr_default_if_unset(&s->conf.macaddr);
+    s->tx_bh = qemu_bh_new(ti8168_emac_process_tx, s);
+    s->nic = qemu_new_nic(&ti8168_emac_net_info, &s->conf, TYPE_TI8168_EMAC,
+                          dev->id, &dev->mem_reentrancy_guard, s);
+    qemu_format_nic_info_str(qemu_get_queue(s->nic), s->conf.macaddr.a);
+}
+
+static void ti8168_emac_unrealize(DeviceState *dev)
+{
+    TI8168EMACState *s = TI8168_EMAC(dev);
+
+    qemu_bh_delete(s->tx_bh);
+    qemu_del_nic(s->nic);
+}
+
+static const Property ti8168_emac_properties[] = {
+    DEFINE_NIC_PROPERTIES(TI8168EMACState, conf),
+};
+
+static void ti8168_emac_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    set_bit(DEVICE_CATEGORY_NETWORK, dc->categories);
+    dc->desc = "TI81xx DaVinci EMAC/CPDMA/MDIO";
+    dc->realize = ti8168_emac_realize;
+    dc->unrealize = ti8168_emac_unrealize;
+    device_class_set_legacy_reset(dc, ti8168_emac_reset);
+    device_class_set_props(dc, ti8168_emac_properties);
+}
+
+static const TypeInfo ti8168_emac_type_info = {
+    .name = TYPE_TI8168_EMAC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(TI8168EMACState),
+    .class_init = ti8168_emac_class_init,
+};
+
+void ti8168_emac_create(Object *parent, const char *child_name, hwaddr base,
+                        qemu_irq rx_thresh_irq, qemu_irq rx_irq,
+                        qemu_irq tx_irq, qemu_irq misc_irq)
+{
+    DeviceState *dev = qdev_new(TYPE_TI8168_EMAC);
+
+    object_property_add_child(parent, child_name, OBJECT(dev));
+    qemu_configure_nic_device(dev, true, NULL);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(dev), 0, base);
+    sysbus_connect_irq(SYS_BUS_DEVICE(dev), 0, rx_thresh_irq);
+    sysbus_connect_irq(SYS_BUS_DEVICE(dev), 1, rx_irq);
+    sysbus_connect_irq(SYS_BUS_DEVICE(dev), 2, tx_irq);
+    sysbus_connect_irq(SYS_BUS_DEVICE(dev), 3, misc_irq);
+}
+
+static void ti8168_emac_register_types(void)
+{
+    type_register_static(&ti8168_emac_type_info);
+}
+
+type_init(ti8168_emac_register_types)
diff --git a/hw/arm/ti8168_emac_regs.inc b/hw/arm/ti8168_emac_regs.inc
new file mode 100644
index 0000000..7225ac1
--- /dev/null
+++ b/hw/arm/ti8168_emac_regs.inc
@@ -0,0 +1,285 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+static void ti8168_emac_mdio_access(TI8168EMACState *s, uint32_t value)
+{
+    /*
+     * A modeled MDIO callback encodes its
+     * phy_id argument in bits 16..20 and its register argument in
+     * bits 21..25.  Preserve that guest-visible TI81xx layout.
+     */
+    unsigned phy = (value >> 16) & 0x1f;
+    unsigned reg = (value >> 21) & 0x1f;
+    int phy_index = ti8168_emac_phy_index(phy);
+
+    s->mdio_access = value & ~(MDIO_ACCESS_GO | MDIO_ACCESS_ACK);
+    if (phy_index >= 0) {
+        if (value & MDIO_ACCESS_WRITE) {
+            s->phy[phy_index][reg] = value;
+            if (reg == 0 && (s->phy[phy_index][reg] & BIT(15))) {
+                s->phy[phy_index][reg] &= ~BIT(15);
+            }
+        }
+        s->mdio_access |= MDIO_ACCESS_ACK | s->phy[phy_index][reg];
+    } else {
+        s->mdio_access |= 0xffff;
+    }
+}
+
+static uint64_t ti8168_emac_mdio_read(TI8168EMACState *s, hwaddr offset)
+{
+    switch (offset) {
+    case MDIO_VERSION: return 1;
+    case MDIO_CONTROL: return s->mdio_control | MDIO_CONTROL_IDLE;
+    case MDIO_ALIVE:
+    case MDIO_LINK: return TI8168_EMAC_PHY_ALIVE;
+    case MDIO_USERINTRAW: return s->mdio_int_raw;
+    case MDIO_USERINTMASKED: return s->mdio_int_raw & s->mdio_int_mask;
+    case MDIO_USERINTMASKSET:
+    case MDIO_USERINTMASKCLEAR: return s->mdio_int_mask;
+    case MDIO_USERACCESS0: return s->mdio_access;
+    default: return 0;
+    }
+}
+
+static void ti8168_emac_mdio_write(TI8168EMACState *s, hwaddr offset,
+                                   uint32_t value)
+{
+    switch (offset) {
+    case MDIO_CONTROL:
+        s->mdio_control = value & (MDIO_CONTROL_ENABLE | 0xffff);
+        break;
+    case MDIO_USERINTMASKSET:
+        s->mdio_int_mask |= value;
+        break;
+    case MDIO_USERINTMASKCLEAR:
+        s->mdio_int_mask &= ~value;
+        s->mdio_int_raw &= ~value;
+        break;
+    case MDIO_USERACCESS0:
+        if (value & MDIO_ACCESS_GO) {
+            ti8168_emac_mdio_access(s, value);
+        }
+        break;
+    default:
+        break;
+    }
+    ti8168_emac_update_irqs(s);
+}
+
+static bool ti8168_emac_read_control(TI8168EMACState *s, hwaddr offset,
+                                    uint64_t *value)
+{
+    switch (offset) {
+    case CPDMA_TXIDVER:
+    case CPDMA_RXIDVER: *value = 0x100; return true;
+    case CPDMA_TXCONTROL: *value = s->tx_control; return true;
+    case CPDMA_RXCONTROL: *value = s->rx_control; return true;
+    case CPDMA_SOFTRESET:
+    case EMAC_SOFTRESET: *value = 0; return true;
+    case CPDMA_DMACONTROL: *value = s->dma_control; return true;
+    case CPDMA_DMASTATUS: *value = 0; return true;
+    case CPDMA_RXBUFFOFS:
+    case EMAC_RXBUFFEROFFSET: *value = s->rx_buffer_offset; return true;
+    default: return false;
+    }
+}
+
+static bool ti8168_emac_read_mac(TI8168EMACState *s, hwaddr offset,
+                                 uint64_t *value)
+{
+    switch (offset) {
+    case EMAC_RXMBPENABLE: *value = s->rx_mbp_enable; return true;
+    case EMAC_RXUNICASTSET: *value = s->rx_unicast; return true;
+    case EMAC_RXUNICASTCLEAR: *value = ~s->rx_unicast; return true;
+    case EMAC_RXMAXLEN: *value = s->rx_max_len; return true;
+    case EMAC_MACCONTROL: *value = s->mac_control; return true;
+    case EMAC_MACSTATUS: *value = 0; return true;
+    case EMAC_MACSRCADDRLO: *value = s->mac_src_addr_lo; return true;
+    case EMAC_MACSRCADDRHI: *value = s->mac_src_addr_hi; return true;
+    case EMAC_MACADDRLO: *value = s->mac_addr_lo[s->mac_index & 7]; return true;
+    case EMAC_MACADDRHI: *value = s->mac_addr_hi[s->mac_index & 7]; return true;
+    case EMAC_MACINDEX: *value = s->mac_index; return true;
+    default: return false;
+    }
+}
+
+static bool ti8168_emac_read_interrupt(TI8168EMACState *s, hwaddr offset,
+                                       uint64_t *value)
+{
+    switch (offset) {
+    case CPDMA_TXINTSTATRAW: *value = s->tx_raw; return true;
+    case CPDMA_TXINTSTATMASKED: *value = s->tx_raw & s->tx_mask; return true;
+    case CPDMA_TXINTMASKSET:
+    case CPDMA_TXINTMASKCLEAR: *value = s->tx_mask; return true;
+    case CPDMA_RXINTSTATRAW: *value = s->rx_raw; return true;
+    case CPDMA_RXINTSTATMASKED: *value = s->rx_raw & s->rx_mask; return true;
+    case CPDMA_RXINTMASKSET:
+    case CPDMA_RXINTMASKCLEAR: *value = s->rx_mask; return true;
+    default: return false;
+    }
+}
+
+static bool ti8168_emac_read_completion(TI8168EMACState *s, hwaddr offset,
+                                        uint64_t *value)
+{
+    switch (offset) {
+    case CPDMA_DMAINTSTATRAW: *value = s->dma_raw; return true;
+    case CPDMA_DMAINTSTATMASKED: *value = s->dma_raw & s->dma_mask; return true;
+    case CPDMA_DMAINTMASKSET:
+    case CPDMA_DMAINTMASKCLEAR: *value = s->dma_mask; return true;
+    case CPDMA_MACINVECTOR:
+        /* Synthetic compatibility value; no board version claim. */
+        *value = (s->rx_raw ? BIT(0) : 0) |
+                 (s->tx_raw ? BIT(16) : 0) |
+                 (s->dma_raw ? BIT(26) : 0);
+        return true;
+    case CPDMA_TXHDP: *value = s->tx_hdp; return true;
+    case CPDMA_RXHDP: *value = s->rx_hdp; return true;
+    case CPDMA_TXCP: *value = s->tx_cp; return true;
+    case CPDMA_RXCP: *value = s->rx_cp; return true;
+    default: return false;
+    }
+}
+
+static uint64_t ti8168_emac_cpdma_read(TI8168EMACState *s, hwaddr offset)
+{
+    uint64_t value;
+
+    if (ti8168_emac_read_control(s, offset, &value) ||
+        ti8168_emac_read_mac(s, offset, &value) ||
+        ti8168_emac_read_interrupt(s, offset, &value) ||
+        ti8168_emac_read_completion(s, offset, &value)) {
+        return value;
+    }
+    return 0;
+}
+
+static bool ti8168_emac_write_control(TI8168EMACState *s, hwaddr offset,
+                                      uint32_t value)
+{
+    switch (offset) {
+    case CPDMA_SOFTRESET:
+        if (value & 1) {
+            ti8168_emac_cpdma_reset(s);
+        }
+        return true;
+    case EMAC_SOFTRESET:
+        if (value & 1) {
+            ti8168_emac_reset_state(s);
+        }
+        return true;
+    case CPDMA_TXCONTROL: s->tx_control = value & 1; ti8168_emac_schedule_tx(s); return true;
+    case CPDMA_RXCONTROL: s->rx_control = value & 1; return true;
+    case CPDMA_DMACONTROL: s->dma_control = value; return true;
+    case CPDMA_RXBUFFOFS:
+    case EMAC_RXBUFFEROFFSET: s->rx_buffer_offset = value & CPDMA_DESC_LEN; return true;
+    default: return false;
+    }
+}
+
+static bool ti8168_emac_write_interrupt(TI8168EMACState *s, hwaddr offset,
+                                        uint32_t value)
+{
+    switch (offset) {
+    case CPDMA_TXINTMASKSET: s->tx_mask |= value; return true;
+    case CPDMA_TXINTMASKCLEAR: s->tx_mask &= ~value; return true;
+    case CPDMA_RXINTMASKSET: s->rx_mask |= value; return true;
+    case CPDMA_RXINTMASKCLEAR: s->rx_mask &= ~value; return true;
+    case CPDMA_DMAINTMASKSET: s->dma_mask |= value; return true;
+    case CPDMA_DMAINTMASKCLEAR: s->dma_mask &= ~value; return true;
+    default: return false;
+    }
+}
+
+static bool ti8168_emac_write_mac(TI8168EMACState *s, hwaddr offset,
+                                  uint32_t value)
+{
+    switch (offset) {
+    case EMAC_RXMBPENABLE: s->rx_mbp_enable = value; return true;
+    case EMAC_RXUNICASTSET: s->rx_unicast |= value; return true;
+    case EMAC_RXUNICASTCLEAR: s->rx_unicast &= ~value; return true;
+    case EMAC_RXMAXLEN: s->rx_max_len = value & CPDMA_DESC_LEN; return true;
+    case EMAC_MACCONTROL: s->mac_control = value; return true;
+    case EMAC_MACSRCADDRLO: s->mac_src_addr_lo = value; return true;
+    case EMAC_MACSRCADDRHI: s->mac_src_addr_hi = value; return true;
+    case EMAC_MACINDEX: s->mac_index = value & 7; return true;
+    case EMAC_MACADDRLO: s->mac_addr_lo[s->mac_index & 7] = value; return true;
+    case EMAC_MACADDRHI: s->mac_addr_hi[s->mac_index & 7] = value; return true;
+    default: return false;
+    }
+}
+
+static bool ti8168_emac_write_completion(TI8168EMACState *s, hwaddr offset,
+                                         uint32_t value)
+{
+    switch (offset) {
+    case CPDMA_TXHDP: s->tx_hdp = value & ~3U; ti8168_emac_schedule_tx(s); return true;
+    case CPDMA_RXHDP: s->rx_hdp = value & ~3U; return true;
+    case CPDMA_TXCP:
+        /* One modelled TX channel has one pending completion event. */
+        s->tx_raw &= ~BIT(0);
+        return true;
+    case CPDMA_RXCP:
+        /* One modelled RX channel has one pending completion event. */
+        s->rx_raw &= ~BIT(0);
+        return true;
+    default: return false;
+    }
+}
+
+static void ti8168_emac_cpdma_write(TI8168EMACState *s, hwaddr offset,
+                                    uint32_t value)
+{
+    ti8168_emac_write_control(s, offset, value) ||
+        ti8168_emac_write_interrupt(s, offset, value) ||
+        ti8168_emac_write_mac(s, offset, value) ||
+        ti8168_emac_write_completion(s, offset, value);
+    ti8168_emac_update_irqs(s);
+    if ((offset == CPDMA_RXCONTROL || offset == CPDMA_RXHDP) &&
+        ti8168_emac_can_receive(qemu_get_queue(s->nic))) {
+        qemu_flush_queued_packets(qemu_get_queue(s->nic));
+    }
+}
+
+static uint64_t ti8168_emac_read(void *opaque, hwaddr offset, unsigned size)
+{
+    TI8168EMACState *s = opaque;
+
+    if (offset == EMAC_CTRL_CMRXINTEN) {
+        return s->rx_int_enable;
+    }
+    if (offset == EMAC_CTRL_CMTXINTEN) {
+        return s->tx_int_enable;
+    }
+    if (offset >= MDIO_REGS && offset < MDIO_REGS + MDIO_SIZE) {
+        return ti8168_emac_mdio_read(s, offset - MDIO_REGS);
+    }
+    return offset >= EMAC_REGS ? ti8168_emac_cpdma_read(s, offset - EMAC_REGS) :
+           ti8168_emac_cpdma_read(s, offset);
+}
+
+static void ti8168_emac_write(void *opaque, hwaddr offset, uint64_t value,
+                              unsigned size)
+{
+    TI8168EMACState *s = opaque;
+
+    if (offset == EMAC_CTRL_CMRXINTEN) {
+        s->rx_int_enable = value;
+        ti8168_emac_update_irqs(s);
+    } else if (offset == EMAC_CTRL_CMTXINTEN) {
+        s->tx_int_enable = value;
+        ti8168_emac_update_irqs(s);
+    } else if (offset >= MDIO_REGS && offset < MDIO_REGS + MDIO_SIZE) {
+        ti8168_emac_mdio_write(s, offset - MDIO_REGS, value);
+    } else if (offset >= EMAC_REGS) {
+        ti8168_emac_cpdma_write(s, offset - EMAC_REGS, value);
+    } else {
+        ti8168_emac_cpdma_write(s, offset, value);
+    }
+}
+
+static const MemoryRegionOps ti8168_emac_ops = {
+    .read = ti8168_emac_read,
+    .write = ti8168_emac_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4, .unaligned = false },
+};
diff --git a/hw/arm/ti8168_gpmc.c b/hw/arm/ti8168_gpmc.c
new file mode 100644
index 0000000..effbd7e
--- /dev/null
+++ b/hw/arm/ti8168_gpmc.c
@@ -0,0 +1,289 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* TI8168 GPMC compatibility device. */
+
+#include "qemu/osdep.h"
+#include "ti8168_internal.h"
+
+OBJECT_DECLARE_SIMPLE_TYPE(TI8168GPMCState, TI8168_GPMC)
+
+enum {
+    TI8168_GPMC_NAND_COMMAND = 0x7c,
+    TI8168_GPMC_NAND_ADDRESS = 0x80,
+    TI8168_GPMC_NAND_DATA = 0x84,
+    TI8168_GPMC_CS0_CONFIG1 = 0x60,
+    TI8168_GPMC_CS0_CONFIG7 = 0x78,
+    TI8168_GPMC_STATUS = 0x54,
+    TI8168_GPMC_PREFETCH_CONFIG1 = 0x1e0,
+    TI8168_GPMC_PREFETCH_CONFIG2 = 0x1e4,
+    TI8168_GPMC_PREFETCH_CONTROL = 0x1ec,
+    TI8168_GPMC_PREFETCH_STATUS = 0x1f0,
+    TI8168_GPMC_PREFETCH_FIFO_BYTES = 64,
+    TI8168_GPMC_CSVALID = BIT(6),
+    TI8168_GPMC_APERTURE_SIZE = 16 * MiB,
+};
+struct TI8168GPMCState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    MemoryRegion aperture;
+    DeviceState *nand;
+    uint32_t sysconfig;
+    uint32_t config[7];
+    uint32_t prefetch_config1;
+    uint32_t prefetch_count;
+    uint32_t prefetch_control;
+    uint32_t prefetch_remaining;
+    bool aperture_mapped;
+    hwaddr aperture_base;
+};
+
+static uint8_t ti8168_gpmc_nand_read(TI8168GPMCState *s)
+{
+    uint8_t value = s->nand ? ti8168_synthetic_nand_data_read(s->nand) : 0xff;
+
+    if (s->prefetch_control && s->prefetch_remaining) {
+        s->prefetch_remaining--;
+    }
+    return value;
+}
+
+static void ti8168_gpmc_nand_write(TI8168GPMCState *s, uint8_t value)
+{
+    if (s->nand) {
+        ti8168_synthetic_nand_data_write(s->nand, value);
+    }
+    if (s->prefetch_control && s->prefetch_remaining) {
+        s->prefetch_remaining--;
+    }
+}
+
+static void ti8168_gpmc_remap(TI8168GPMCState *s)
+{
+    uint32_t config7 = s->config[6];
+    hwaddr base = (hwaddr)(config7 & 0x3f) << 24;
+
+    if (s->aperture_mapped) {
+        memory_region_del_subregion(get_system_memory(), &s->aperture);
+        s->aperture_mapped = false;
+    }
+    if (s->nand && (config7 & TI8168_GPMC_CSVALID)) {
+        s->aperture_base = base;
+        memory_region_add_subregion(get_system_memory(), base, &s->aperture);
+        s->aperture_mapped = true;
+    }
+}
+
+static uint64_t ti8168_gpmc_aperture_read(void *opaque, hwaddr offset,
+                                           unsigned size)
+{
+    TI8168GPMCState *s = opaque;
+    uint64_t value = 0;
+    unsigned i;
+
+    for (i = 0; i < size; i++) {
+        value |= (uint64_t)ti8168_gpmc_nand_read(s) << (i * 8);
+    }
+    return value;
+}
+
+static void ti8168_gpmc_aperture_write(void *opaque, hwaddr offset,
+                                       uint64_t value, unsigned size)
+{
+    TI8168GPMCState *s = opaque;
+    unsigned i;
+
+    if (s->nand) {
+        for (i = 0; i < size; i++) {
+            ti8168_gpmc_nand_write(s, value >> (i * 8));
+        }
+    }
+}
+
+static const MemoryRegionOps ti8168_gpmc_aperture_ops = {
+    .read = ti8168_gpmc_aperture_read,
+    .write = ti8168_gpmc_aperture_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static uint64_t ti8168_gpmc_read(void *opaque, hwaddr offset, unsigned size)
+{
+    TI8168GPMCState *s = opaque;
+
+    if (offset >= TI8168_GPMC_CS0_CONFIG1 &&
+        offset <= TI8168_GPMC_CS0_CONFIG7 && !(offset & 3)) {
+        return s->config[(offset - TI8168_GPMC_CS0_CONFIG1) / 4];
+    }
+    switch (offset) {
+    case 0x00: return 0x50;
+    case 0x10: return s->sysconfig;
+    case 0x14: return 1;
+    case TI8168_GPMC_STATUS: return 1;
+    case TI8168_GPMC_PREFETCH_CONFIG1: return s->prefetch_config1;
+    case TI8168_GPMC_PREFETCH_CONFIG2: return s->prefetch_count;
+    case TI8168_GPMC_PREFETCH_CONTROL: return s->prefetch_control;
+    case TI8168_GPMC_PREFETCH_STATUS:
+        return (MIN(s->prefetch_remaining,
+                    (uint32_t)TI8168_GPMC_PREFETCH_FIFO_BYTES) << 24) |
+               (s->prefetch_remaining & 0x3fff);
+    case TI8168_GPMC_NAND_DATA: {
+        uint64_t value = 0;
+        unsigned i;
+
+        for (i = 0; i < size; i++) {
+            value |= (uint64_t)ti8168_gpmc_nand_read(s) << (i * 8);
+        }
+        return value;
+    }
+    default: return 0;
+    }
+}
+
+static bool ti8168_gpmc_write_nand(TI8168GPMCState *s, hwaddr offset,
+                                   uint64_t value, unsigned size)
+{
+    unsigned i;
+
+    switch (offset) {
+    case TI8168_GPMC_NAND_COMMAND:
+        if (s->nand) {
+            ti8168_synthetic_nand_command(s->nand, value);
+        }
+        return true;
+    case TI8168_GPMC_NAND_ADDRESS:
+        if (s->nand) {
+            ti8168_synthetic_nand_address(s->nand, value);
+        }
+        return true;
+    case TI8168_GPMC_NAND_DATA:
+        for (i = 0; s->nand && i < size; i++) {
+            ti8168_gpmc_nand_write(s, value >> (i * 8));
+        }
+        return true;
+    default:
+        return false;
+    }
+}
+
+static void ti8168_gpmc_write(void *opaque, hwaddr offset, uint64_t value,
+                              unsigned size)
+{
+    TI8168GPMCState *s = opaque;
+
+    if (offset >= TI8168_GPMC_CS0_CONFIG1 &&
+        offset <= TI8168_GPMC_CS0_CONFIG7 && !(offset & 3)) {
+        s->config[(offset - TI8168_GPMC_CS0_CONFIG1) / 4] = value;
+        if (offset == TI8168_GPMC_CS0_CONFIG7) {
+            ti8168_gpmc_remap(s);
+        }
+        return;
+    }
+    if (ti8168_gpmc_write_nand(s, offset, value, size)) {
+        return;
+    }
+    switch (offset) {
+    case 0x10:
+        s->sysconfig = value & 0x1;
+        break;
+    case TI8168_GPMC_PREFETCH_CONFIG1:
+        s->prefetch_config1 = value;
+        break;
+    case TI8168_GPMC_PREFETCH_CONFIG2:
+        s->prefetch_count = value & 0x3fff;
+        break;
+    case TI8168_GPMC_PREFETCH_CONTROL:
+        s->prefetch_control = value & 1;
+        s->prefetch_remaining = s->prefetch_control ? s->prefetch_count : 0;
+        break;
+    default:
+        break;
+    }
+}
+
+static bool ti8168_gpmc_accepts(void *opaque, hwaddr offset, unsigned size,
+                                bool is_write, MemTxAttrs attrs)
+{
+    if (offset == TI8168_GPMC_NAND_COMMAND ||
+        offset == TI8168_GPMC_NAND_ADDRESS) {
+        return size == 1;
+    }
+    if (offset == TI8168_GPMC_NAND_DATA) {
+        return size == 1 || size == 2 || size == 4;
+    }
+    return size == 4 && !(offset & 3);
+}
+
+static const MemoryRegionOps ti8168_gpmc_ops = {
+    .read = ti8168_gpmc_read,
+    .write = ti8168_gpmc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {
+        .min_access_size = 1,
+        .max_access_size = 4,
+        .accepts = ti8168_gpmc_accepts,
+    },
+};
+
+static void ti8168_gpmc_reset(DeviceState *dev)
+{
+    TI8168GPMCState *s = TI8168_GPMC(dev);
+
+    s->sysconfig = 0;
+    memset(s->config, 0, sizeof(s->config));
+    s->prefetch_config1 = 0;
+    s->prefetch_count = 0;
+    s->prefetch_control = 0;
+    s->prefetch_remaining = 0;
+    ti8168_gpmc_remap(s);
+}
+
+static void ti8168_gpmc_realize(DeviceState *dev, Error **errp)
+{
+    TI8168GPMCState *s = TI8168_GPMC(dev);
+
+    memory_region_init_io(&s->iomem, OBJECT(dev), &ti8168_gpmc_ops, s,
+                          "ti8168.gpmc", 0x1000);
+    memory_region_init_io(&s->aperture, OBJECT(dev),
+                          &ti8168_gpmc_aperture_ops, s,
+                          "ti8168.gpmc.cs0-synthetic-nand",
+                          TI8168_GPMC_APERTURE_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->iomem);
+}
+
+static void ti8168_gpmc_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = ti8168_gpmc_realize;
+    device_class_set_legacy_reset(dc, ti8168_gpmc_reset);
+}
+
+static const TypeInfo ti8168_gpmc_type_info = {
+    .name = TYPE_TI8168_GPMC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(TI8168GPMCState),
+    .class_init = ti8168_gpmc_class_init,
+};
+
+void ti8168_gpmc_create(Object *parent, DeviceState *nand, hwaddr base)
+{
+    TI8168GPMCState *gpmc = TI8168_GPMC(qdev_new(TYPE_TI8168_GPMC));
+
+    object_property_add_child(parent, "gpmc", OBJECT(gpmc));
+    gpmc->nand = nand;
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(gpmc), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(gpmc), 0, base);
+}
+
+static void ti8168_gpmc_register_types(void)
+{
+    type_register_static(&ti8168_gpmc_type_info);
+}
+
+type_init(ti8168_gpmc_register_types)
+
+/*
+ * The synthetic probe clears the CC+0x4000..0x7fff PaRAM array
+ * byte-by-byte, then stores its region configuration at CC+0x280 and +0x284.
+ * This object retains only that bootstrap storage contract.  It deliberately
+ * has no channel, event, transfer-controller, or interrupt behaviour.
+ */
diff --git a/hw/arm/ti8168_intc.c b/hw/arm/ti8168_intc.c
new file mode 100644
index 0000000..2c84c2b
--- /dev/null
+++ b/hw/arm/ti8168_intc.c
@@ -0,0 +1,318 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* TI8168 INTCPS compatibility device. */
+
+#include "qemu/osdep.h"
+#include "ti8168_internal.h"
+
+OBJECT_DECLARE_SIMPLE_TYPE(TI8168IntcState, TI8168_INTC)
+
+enum {
+    TI8168_NUM_IRQS = 128,
+};
+struct TI8168IntcState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq parent_irq;
+    qemu_irq parent_fiq;
+    /* Hardware input levels and software IRQ requests are independent. */
+    uint32_t line_level[4];
+    uint32_t soft_pending[4];
+    uint32_t mask[4];
+    uint32_t ilr[TI8168_NUM_IRQS];
+    uint32_t sysconfig;
+    uint32_t protection;
+    uint32_t idle;
+    uint32_t threshold;
+    int irq_in_service;
+    int fiq_in_service;
+};
+
+static void ti8168_intc_reset(DeviceState *dev);
+static void ti8168_intc_update(TI8168IntcState *s);
+
+static void ti8168_intc_reset_state(TI8168IntcState *s, bool cold_reset)
+{
+    if (cold_reset) {
+        memset(s->line_level, 0, sizeof(s->line_level));
+    }
+    memset(s->soft_pending, 0, sizeof(s->soft_pending));
+    memset(s->mask, 0xff, sizeof(s->mask));
+    memset(s->ilr, 0, sizeof(s->ilr));
+    s->sysconfig = 0;
+    s->protection = 0;
+    s->idle = 0;
+    s->threshold = 0x3f;
+    s->irq_in_service = -1;
+    s->fiq_in_service = -1;
+    ti8168_intc_update(s);
+}
+
+static uint32_t ti8168_intc_pending(const TI8168IntcState *s, unsigned bank)
+{
+    return s->line_level[bank] | s->soft_pending[bank];
+}
+
+static int ti8168_intc_active(TI8168IntcState *s, bool fiq)
+{
+    int irq;
+    int selected = -1;
+    unsigned selected_priority = 0x40;
+
+    for (irq = 0; irq < TI8168_NUM_IRQS; irq++) {
+        unsigned bank = irq >> 5;
+        unsigned bit = irq & 31;
+        bool route_fiq = s->ilr[irq] & 1;
+        unsigned priority = (s->ilr[irq] >> 2) & 0x3f;
+
+        if (route_fiq != fiq || priority > s->threshold ||
+            !(ti8168_intc_pending(s, bank) & ~s->mask[bank] & BIT(bit))) {
+            continue;
+        }
+        if (priority < selected_priority) {
+            selected_priority = priority;
+            selected = irq;
+        }
+    }
+    return selected;
+}
+
+static void ti8168_intc_update(TI8168IntcState *s)
+{
+    qemu_set_irq(s->parent_irq, s->irq_in_service < 0 &&
+                 ti8168_intc_active(s, false) >= 0);
+    qemu_set_irq(s->parent_fiq, s->fiq_in_service < 0 &&
+                 ti8168_intc_active(s, true) >= 0);
+}
+
+static void ti8168_intc_set_irq(void *opaque, int irq, int level)
+{
+    TI8168IntcState *s = opaque;
+    unsigned bank = irq >> 5;
+    uint32_t bit = BIT(irq & 31);
+
+    if (level) {
+        s->line_level[bank] |= bit;
+    } else {
+        s->line_level[bank] &= ~bit;
+    }
+    ti8168_intc_update(s);
+}
+
+static uint32_t ti8168_intc_claim(TI8168IntcState *s, bool fiq)
+{
+    int irq = ti8168_intc_active(s, fiq);
+
+    if (irq >= 0) {
+        if (fiq) {
+            s->fiq_in_service = irq;
+        } else {
+            s->irq_in_service = irq;
+        }
+        ti8168_intc_update(s);
+    }
+    return irq < 0 ? 0x80 : irq;
+}
+
+static bool ti8168_intc_read_primary(TI8168IntcState *s, hwaddr offset,
+                                     uint64_t *value)
+{
+    int irq;
+
+    switch (offset) {
+    case 0x00: *value = 0x40; return true; /* INTCPS revision 4.0 */
+    case 0x10: *value = s->sysconfig; return true;
+    case 0x14: *value = 1; return true; /* reset complete */
+    case 0x40: *value = ti8168_intc_claim(s, false); return true;
+    case 0x44: *value = ti8168_intc_claim(s, true); return true;
+    case 0x48: *value = 0; return true;
+    case 0x4c: *value = s->protection; return true;
+    case 0x50: *value = s->idle; return true;
+    case 0x60:
+        irq = ti8168_intc_active(s, false);
+        *value = irq < 0 ? 0x3f : (s->ilr[irq] >> 2) & 0x3f;
+        return true;
+    case 0x64:
+        irq = ti8168_intc_active(s, true);
+        *value = irq < 0 ? 0x3f : (s->ilr[irq] >> 2) & 0x3f;
+        return true;
+    case 0x68: *value = s->threshold; return true;
+    default: return false;
+    }
+}
+
+static uint64_t ti8168_intc_read_bank(TI8168IntcState *s, hwaddr offset)
+{
+    unsigned bank = (offset - 0x80) >> 5;
+
+    switch ((offset - 0x80) & 0x1f) {
+    case 0x00: return ti8168_intc_pending(s, bank);
+    case 0x04: return s->mask[bank];
+    case 0x18: return ti8168_intc_pending(s, bank) & ~s->mask[bank];
+    default: return 0;
+    }
+}
+
+static uint64_t ti8168_intc_read(void *opaque, hwaddr offset, unsigned size)
+{
+    TI8168IntcState *s = opaque;
+    uint64_t value;
+
+    if (ti8168_intc_read_primary(s, offset, &value)) {
+        return value;
+    }
+    if (offset >= 0x80 && offset < 0x100) {
+        return ti8168_intc_read_bank(s, offset);
+    }
+    if (offset >= 0x100 && offset < 0x300 && !(offset & 3)) {
+        return s->ilr[(offset - 0x100) >> 2];
+    }
+    qemu_log_mask(LOG_UNIMP, "ti8168-intc: read offset 0x%" HWADDR_PRIx "\n",
+                  offset);
+    return 0;
+}
+
+static bool ti8168_intc_write_primary(TI8168IntcState *s, hwaddr offset,
+                                      uint64_t value)
+{
+    switch (offset) {
+    case 0x10:
+        if (value & 2) {
+            /* SOFTRESET is self-clearing but does not deassert device lines. */
+            ti8168_intc_reset_state(s, false);
+            return true;
+        }
+        s->sysconfig = value & 1;
+        return true;
+    case 0x48:
+        /*
+         * SIR reads claim the selected source; CONTROL bit 0 releases IRQ
+         * service and bit 1 releases FIQ service.  A level source that remains asserted is eligible
+         * again after acknowledgement.  This is deliberately conservative
+         * rather than a claim of cycle-accurate INTCPS arbitration.
+         */
+        if (value & 1) {
+            s->irq_in_service = -1;
+        }
+        if (value & 2) {
+            s->fiq_in_service = -1;
+        }
+        ti8168_intc_update(s);
+        return true;
+    case 0x4c:
+        s->protection = value & 1;
+        return true;
+    case 0x50:
+        s->idle = value & 1;
+        return true;
+    case 0x68:
+        s->threshold = value & 0x3f;
+        return true;
+    default: return false;
+    }
+}
+
+static void ti8168_intc_write_bank(TI8168IntcState *s, hwaddr offset,
+                                    uint64_t value)
+{
+    unsigned bank = (offset - 0x80) >> 5;
+
+    switch ((offset - 0x80) & 0x1f) {
+    case 0x04: s->mask[bank] = value; break;
+    case 0x08: s->mask[bank] &= ~value; break;
+    case 0x0c: s->mask[bank] |= value; break;
+    case 0x10: s->soft_pending[bank] |= value; break;
+    case 0x14: s->soft_pending[bank] &= ~value; break;
+    default: break;
+    }
+    ti8168_intc_update(s);
+}
+
+static void ti8168_intc_write(void *opaque, hwaddr offset, uint64_t value,
+                              unsigned size)
+{
+    TI8168IntcState *s = opaque;
+
+    if (ti8168_intc_write_primary(s, offset, value)) {
+        return;
+    }
+    if (offset >= 0x80 && offset < 0x100) {
+        ti8168_intc_write_bank(s, offset, value);
+        return;
+    }
+    if (offset >= 0x100 && offset < 0x300 && !(offset & 3)) {
+        s->ilr[(offset - 0x100) >> 2] = value & 0xff;
+        ti8168_intc_update(s);
+        return;
+    }
+    qemu_log_mask(LOG_UNIMP,
+                  "ti8168-intc: write offset 0x%" HWADDR_PRIx " = 0x%" PRIx64 "\n",
+                  offset, value);
+}
+
+static const MemoryRegionOps ti8168_intc_ops = {
+    .read = ti8168_intc_read,
+    .write = ti8168_intc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void ti8168_intc_reset(DeviceState *dev)
+{
+    TI8168IntcState *s = TI8168_INTC(dev);
+
+    ti8168_intc_reset_state(s, true);
+}
+
+static void ti8168_intc_init(Object *obj)
+{
+    TI8168IntcState *s = TI8168_INTC(obj);
+    DeviceState *dev = DEVICE(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->iomem, obj, &ti8168_intc_ops, s,
+                          "ti8168.intc", 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->parent_irq);
+    sysbus_init_irq(sbd, &s->parent_fiq);
+    qdev_init_gpio_in(dev, ti8168_intc_set_irq, TI8168_NUM_IRQS);
+}
+
+static void ti8168_intc_class_init(ObjectClass *klass, const void *data)
+{
+    device_class_set_legacy_reset(DEVICE_CLASS(klass), ti8168_intc_reset);
+}
+
+static const TypeInfo ti8168_intc_type_info = {
+    .name = TYPE_TI8168_INTC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(TI8168IntcState),
+    .instance_init = ti8168_intc_init,
+    .class_init = ti8168_intc_class_init,
+};
+
+DeviceState *ti8168_intc_create(Object *parent, hwaddr base,
+                                qemu_irq irq, qemu_irq fiq)
+{
+    DeviceState *dev = qdev_new(TYPE_TI8168_INTC);
+
+    object_property_add_child(parent, "intc", OBJECT(dev));
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(dev), 0, base);
+    sysbus_connect_irq(SYS_BUS_DEVICE(dev), 0, irq);
+    sysbus_connect_irq(SYS_BUS_DEVICE(dev), 1, fiq);
+    return dev;
+}
+
+qemu_irq ti8168_intc_get_irq(DeviceState *dev, unsigned irq)
+{
+    return qdev_get_gpio_in(dev, irq);
+}
+
+static void ti8168_intc_register_types(void)
+{
+    type_register_static(&ti8168_intc_type_info);
+}
+
+type_init(ti8168_intc_register_types)
+
+/* Minimal OMAP dual-mode timer with overflow and auto-reload. */
