+    if (smm->serial.lcr == OMAP_UART_LCR_CONF_MODE_B) {
+        switch (reg) {
+        case 2: smm->omap_efr = value; return true;
+        case 4: smm->omap_xon1 = value; return true;
+        case 5: smm->omap_xon2 = value; return true;
+        case 6: smm->omap_xoff1 = value; return true;
+        case 7: smm->omap_xoff2 = value; return true;
+        default: break;
+        }
+    }
+    if (smm->serial.lcr == OMAP_UART_LCR_CONF_MODE_A &&
+        smm->omap_mcr_extra & OMAP_UART_MCR_TCRTLR) {
+        if (reg == 6) {
+            smm->omap_tcr = value;
+            return true;
+        }
+        if (reg == 7) {
+            smm->omap_tlr = value;
+            return true;
+        }
+    }
+    if (reg == 4) {
+        smm->omap_mcr_extra = value & OMAP_UART_MCR_TCRTLR;
+    }
+    return false;
+}
