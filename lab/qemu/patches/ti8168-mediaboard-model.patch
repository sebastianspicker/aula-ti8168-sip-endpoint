+#define TYPE_TI8168_PCIESS_BOOTSTRAP "ti8168-pciess-bootstrap"
+#define TYPE_TI8168_MCSPI_BOOTSTRAP "ti8168-mcspi-bootstrap"
+#define TYPE_TI8168_EMAC "ti8168-emac"
+
+#define TI8168_NAND_MTD_COUNT 2
+
+enum TI8168ProbeRole {
+    PROBE_CONTROL,
+    PROBE_PRCM,
+    PROBE_GPMC,
+    PROBE_UART,
+    PROBE_ELM,
+};
+
+DeviceState *ti8168_intc_create(Object *parent, hwaddr base,
+                                qemu_irq irq, qemu_irq fiq);
+qemu_irq ti8168_intc_get_irq(DeviceState *dev, unsigned irq);
+DeviceState *ti8168_timer_create(Object *parent, hwaddr base, qemu_irq irq,
+                                  Clock *fclk);
+void ti8168_watchdog_create(Object *parent, hwaddr base);
+DeviceState *ti8168_prcm_create(Object *parent, hwaddr base);
+Clock *ti8168_prcm_timer_clock(DeviceState *dev, unsigned index);
+DeviceState *ti8168_synthetic_nand_create(
+    Object *parent, char *const images[TI8168_NAND_MTD_COUNT],
+    char *const oob_images[TI8168_NAND_MTD_COUNT],
+    bool read_only, bool cow);
+uint8_t ti8168_synthetic_nand_data_read(DeviceState *dev);
+void ti8168_synthetic_nand_data_write(DeviceState *dev, uint8_t value);
+void ti8168_synthetic_nand_command(DeviceState *dev, uint8_t command);
+void ti8168_synthetic_nand_address(DeviceState *dev, uint8_t value);
+void ti8168_gpmc_create(Object *parent, DeviceState *nand, hwaddr base);
+void ti8168_edma_cc_bootstrap_create(Object *parent, hwaddr base);
+void ti8168_pciess_bootstrap_create(Object *parent, hwaddr base);
+void ti8168_mcspi_bootstrap_create(Object *parent, hwaddr base);
+DeviceState *ti8168_probe_create(Object *parent, const char *child_name,
+                                 hwaddr base, uint32_t size,
+                                 enum TI8168ProbeRole role);
+DeviceState *ti8168_control_create(Object *parent, const char *child_name,
+                                   hwaddr base, uint32_t size,
+                                   const char *initial_registers);
+void ti8168_emac_create(Object *parent, const char *child_name, hwaddr base,
+                        qemu_irq rx_thresh_irq, qemu_irq rx_irq,
+                        qemu_irq tx_irq, qemu_irq misc_irq);
