+    if (smm->serial.lcr == OMAP_UART_LCR_CONF_MODE_B) {
+        switch (reg) {
+        case 2: *value = smm->omap_efr; return true;
+        case 4: *value = smm->omap_xon1; return true;
+        case 5: *value = smm->omap_xon2; return true;
+        case 6: *value = smm->omap_xoff1; return true;
+        case 7: *value = smm->omap_xoff2; return true;
+        default: break;
