diff --git a/hw/gpio/ti8168_gpio.c b/hw/gpio/ti8168_gpio.c
new file mode 100644
index 0000000..ad820b5
--- /dev/null
+++ b/hw/gpio/ti8168_gpio.c
@@ -0,0 +1,392 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * TI8168 GPIO register/event model, based on public TI SPRUGX8C chapter 8.
+ * https://www.ti.com/lit/ug/sprugx8c/sprugx8c.pdf
+ *
+ * Implements the register file, two independent event/interrupt paths, sampled
+ * inputs and output-latch/direction signals. GPIO_OE configures pads, not the
+ * controller's input detector (8.2.4.3). No pad feedback, pull, pinmux or PCB
+ * connections are implied. Input changes are sampled immediately: interface
+ * clock latency, gated-clock ratios, debounce filtering and PRCM/wakeup/power
+ * integration are not modeled. Debounce configuration is retained, not applied.
+ *
+ * Figure 8-7 and table 8-2 disagree about RTL/MINOR revision reset fields. The
+ * default below follows figure 8-7; the revision property permits another
+ * explicitly selected revision without claiming a physical silicon snapshot.
+ *
+ * Copyright (c) 2026 Sebastian Spicker
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/bitops.h"
+#include "qemu/error-report.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qapi/error.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/sysbus.h"
+#include "hw/gpio/ti8168_gpio.h"
+#include "migration/vmstate.h"
+
+OBJECT_DECLARE_SIMPLE_TYPE(TI8168GPIOState, TI8168_GPIO)
+
+struct TI8168GPIOState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq[2];
+    qemu_irq output[32];
+    qemu_irq output_enable[32];
+    uint32_t revision;
+    uint32_t sysconfig;
+    uint32_t ctrl;
+    uint32_t oe;
+    uint32_t pins;
+    uint32_t datain;
+    uint32_t dataout;
+    uint32_t raw[2];
+    uint32_t enable[2];
+    uint32_t level[2];
+    uint32_t rising;
+    uint32_t falling;
+    uint32_t debounce_enable;
+    uint32_t debounce_time;
+};
+
+static void ti8168_gpio_irq(TI8168GPIOState *s)
+{
+    for (unsigned line = 0; line < 2; line++) {
+        qemu_set_irq(s->irq[line], !!(s->raw[line] & s->enable[line]));
+    }
+}
+
+static void ti8168_gpio_outputs(TI8168GPIOState *s)
+{
+    for (unsigned pin = 0; pin < 32; pin++) {
+        qemu_set_irq(s->output[pin], extract32(s->dataout, pin, 1));
+        qemu_set_irq(s->output_enable[pin], !extract32(s->oe, pin, 1));
+    }
+}
+
+static void ti8168_gpio_sample(TI8168GPIOState *s)
+{
+    uint32_t events, changed;
+
+    if (!(s->ctrl & 1)) {
+        changed = s->datain ^ s->pins;
+        events = (changed & s->pins & s->rising) |
+                 (changed & ~s->pins & s->falling) |
+                 (~s->pins & s->level[0]) | (s->pins & s->level[1]);
+        s->datain = s->pins;
+        s->raw[0] |= events;
+        s->raw[1] |= events;
+    }
+    ti8168_gpio_irq(s);
+}
+
+static void ti8168_gpio_input(void *opaque, int pin, int value)
+{
+    TI8168GPIOState *s = opaque;
+
+        s->pins = deposit32(s->pins, pin, 1, !!value);
+    ti8168_gpio_sample(s);
+}
+
+static void ti8168_gpio_reset(DeviceState *dev)
+{
+    TI8168GPIOState *s = TI8168_GPIO(dev);
+
+        s->sysconfig = 0;
+        s->ctrl = 2;
+        s->oe = UINT32_MAX;
+    /* DATAIN's hardware reset value is unspecified (8.3.15). Sample inputs. */
+        s->datain = s->pins;
+        s->dataout = 0;
+        s->raw[0] = s->raw[1] = 0;
+        s->enable[0] = s->enable[1] = 0;
+        s->level[0] = s->level[1] = 0;
+        s->rising = s->falling = 0;
+        s->debounce_enable = s->debounce_time = 0;
+    ti8168_gpio_outputs(s);
+    ti8168_gpio_irq(s);
+}
+
+static uint64_t ti8168_gpio_read(void *opaque, hwaddr offset, unsigned size)
+{
+    TI8168GPIOState *s = opaque;
+    uint32_t value = 0;
+
+    switch (offset & ~3) {
+    case 0x000:
+        value = s->revision;
+        break;
+    case 0x010:
+        value = s->sysconfig;
+        break;
+    case 0x020:
+        break; /* EOI has no memory (8.3.3). */
+    case 0x024:
+        value = s->raw[0];
+        break;
+    case 0x028:
+        value = s->raw[1];
+        break;
+    case 0x02c:
+        value = s->raw[0] & s->enable[0];
+        break;
+    case 0x030:
+        value = s->raw[1] & s->enable[1];
+        break;
+    case 0x034:
+    case 0x03c:
+        value = s->enable[0];
+        break;
+    case 0x038:
+    case 0x040:
+        value = s->enable[1];
+        break;
+    case 0x114:
+        value = 1;
+        break; /* Reset completes without modeled latency. */
+    case 0x130:
+        value = s->ctrl;
+        break;
+    case 0x134:
+        value = s->oe;
+        break;
+    case 0x138:
+        value = s->datain;
+        break;
+    case 0x13c:
+    case 0x190:
+    case 0x194:
+        value = s->dataout;
+        break;
+    case 0x140:
+        value = s->level[0];
+        break;
+    case 0x144:
+        value = s->level[1];
+        break;
+    case 0x148:
+        value = s->rising;
+        break;
+    case 0x14c:
+        value = s->falling;
+        break;
+    case 0x150:
+        value = s->debounce_enable;
+        break;
+    case 0x154:
+        value = s->debounce_time;
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP,
+                      "ti8168-gpio: unimplemented read 0x%" HWADDR_PRIx "\n",
+                      offset);
+        break;
+    }
+    return extract32(value, (offset & 3) * 8, size * 8);
+}
+
+static uint32_t merge(uint32_t prior, uint32_t value, uint32_t mask)
+{
+    return (prior & ~mask) | (value & mask);
+}
+
+static void ti8168_gpio_write(void *opaque, hwaddr offset, uint64_t data,
+                              unsigned size)
+{
+    TI8168GPIOState *s = opaque;
+    unsigned shift = (offset & 3) * 8;
+    uint32_t mask = size == 4 ? UINT32_MAX : MAKE_64BIT_MASK(shift, size * 8);
+    uint32_t value = data << shift;
+
+    switch (offset & ~3) {
+    case 0x000:
+    case 0x114:
+    case 0x138:
+        return; /* Read only. */
+    case 0x010:
+        if (value & 2) {
+            ti8168_gpio_reset(DEVICE(s));
+        } else {
+            s->sysconfig = merge(s->sysconfig, value, mask) & 0x19;
+        }
+        return;
+    case 0x020:
+        /* EOI acknowledges a line, never a source. Pending sources reassert. */
+        ti8168_gpio_irq(s);
+        return;
+    case 0x024:
+        s->raw[0] |= value;
+        break;
+    case 0x028:
+        s->raw[1] |= value;
+        break;
+    case 0x02c:
+        s->raw[0] &= ~value;
+        break;
+    case 0x030:
+        s->raw[1] &= ~value;
+        break;
+    case 0x034:
+        s->enable[0] |= value;
+        break;
+    case 0x038:
+        s->enable[1] |= value;
+        break;
+    case 0x03c:
+        s->enable[0] &= ~value;
+        break;
+    case 0x040:
+        s->enable[1] &= ~value;
+        break;
+    case 0x130:
+        s->ctrl = merge(s->ctrl, value, mask) & 7;
+        break;
+    case 0x134:
+        s->oe = merge(s->oe, value, mask);
+        ti8168_gpio_outputs(s);
+        return;
+    case 0x13c:
+        s->dataout = merge(s->dataout, value, mask);
+        ti8168_gpio_outputs(s);
+        return;
+    case 0x140:
+        s->level[0] = merge(s->level[0], value, mask);
+        break;
+    case 0x144:
+        s->level[1] = merge(s->level[1], value, mask);
+        break;
+    case 0x148:
+        s->rising = merge(s->rising, value, mask);
+        break;
+    case 0x14c:
+        s->falling = merge(s->falling, value, mask);
+        break;
+    case 0x150:
+        s->debounce_enable = merge(s->debounce_enable, value, mask);
+        if (s->debounce_enable) {
+            qemu_log_mask(LOG_UNIMP,
+                          "ti8168-gpio: debounce timing is not modeled\n");
+        }
+        return;
+    case 0x154:
+        s->debounce_time = merge(s->debounce_time, value, mask) & 0xff;
+        return;
+    case 0x190:
+        s->dataout &= ~value;
+        ti8168_gpio_outputs(s);
+        return;
+    case 0x194:
+        s->dataout |= value;
+        ti8168_gpio_outputs(s);
+        return;
+    default:
+        qemu_log_mask(LOG_UNIMP,
+                      "ti8168-gpio: unimplemented write 0x%" HWADDR_PRIx "\n",
+                      offset);
+        return;
+    }
+    /* Levels remain pending after W1C until the selected input deasserts. */
+    ti8168_gpio_sample(s);
+}
+
+static const MemoryRegionOps ti8168_gpio_ops = {
+    .read = ti8168_gpio_read,
+    .write = ti8168_gpio_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+    .impl = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static int ti8168_gpio_post_load(void *opaque, int version_id)
+{
+    TI8168GPIOState *s = opaque;
+
+    ti8168_gpio_outputs(s);
+    ti8168_gpio_irq(s);
+    return 0;
+}
+
+static const VMStateDescription vmstate_ti8168_gpio = {
+    .name = TYPE_TI8168_GPIO,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = ti8168_gpio_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32_EQUAL(revision, TI8168GPIOState, NULL),
+        VMSTATE_UINT32(sysconfig, TI8168GPIOState),
+        VMSTATE_UINT32(ctrl, TI8168GPIOState),
+        VMSTATE_UINT32(oe, TI8168GPIOState),
+        VMSTATE_UINT32(pins, TI8168GPIOState),
+        VMSTATE_UINT32(datain, TI8168GPIOState),
+        VMSTATE_UINT32(dataout, TI8168GPIOState),
+        VMSTATE_UINT32_ARRAY(raw, TI8168GPIOState, 2),
+        VMSTATE_UINT32_ARRAY(enable, TI8168GPIOState, 2),
+        VMSTATE_UINT32_ARRAY(level, TI8168GPIOState, 2),
+        VMSTATE_UINT32(rising, TI8168GPIOState),
+        VMSTATE_UINT32(falling, TI8168GPIOState),
+        VMSTATE_UINT32(debounce_enable, TI8168GPIOState),
+        VMSTATE_UINT32(debounce_time, TI8168GPIOState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void ti8168_gpio_init(Object *obj)
+{
+    TI8168GPIOState *s = TI8168_GPIO(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->iomem, obj, &ti8168_gpio_ops, s,
+                          TYPE_TI8168_GPIO, 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    for (unsigned line = 0; line < 2; line++) {
+        sysbus_init_irq(sbd, &s->irq[line]);
+    }
+    qdev_init_gpio_in_named(DEVICE(obj), ti8168_gpio_input, "gpio-in", 32);
+    qdev_init_gpio_out_named(DEVICE(obj), s->output, "gpio-out", 32);
+    qdev_init_gpio_out_named(DEVICE(obj), s->output_enable, "gpio-oe", 32);
+}
+
+static const Property ti8168_gpio_properties[] = {
+    DEFINE_PROP_UINT32("revision", TI8168GPIOState, revision, 0x50600801),
+};
+
+static void ti8168_gpio_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    device_class_set_legacy_reset(dc, ti8168_gpio_reset);
+    device_class_set_props(dc, ti8168_gpio_properties);
+    dc->vmsd = &vmstate_ti8168_gpio;
+}
+
+static const TypeInfo ti8168_gpio_type_info = {
+    .name = TYPE_TI8168_GPIO,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(TI8168GPIOState),
+    .instance_init = ti8168_gpio_init,
+    .class_init = ti8168_gpio_class_init,
+};
+
+DeviceState *ti8168_gpio_create(Object *parent, const char *name, hwaddr base,
+                                qemu_irq irq0, qemu_irq irq1)
+{
+    DeviceState *dev = qdev_new(TYPE_TI8168_GPIO);
+
+    object_property_add_child(parent, name, OBJECT(dev));
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(dev), 0, base);
+    sysbus_connect_irq(SYS_BUS_DEVICE(dev), 0, irq0);
+    sysbus_connect_irq(SYS_BUS_DEVICE(dev), 1, irq1);
+    return dev;
+}
+
+static void ti8168_gpio_register_types(void)
+{
+    type_register_static(&ti8168_gpio_type_info);
+}
+
+type_init(ti8168_gpio_register_types)
