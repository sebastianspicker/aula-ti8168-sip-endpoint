--- /dev/null
+++ b/include/hw/gpio/ti8168_gpio.h
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Public-manual TI8168 GPIO controller; no board pad or PCB wiring. */
+#ifndef HW_GPIO_TI8168_GPIO_H
+#define HW_GPIO_TI8168_GPIO_H
+
+#include "qemu/typedefs.h"
+#include "exec/hwaddr.h"
+#include "hw/core/irq.h"
+
+#define TYPE_TI8168_GPIO "ti8168-gpio"
+
+/*
+ * Named gpio-in, gpio-out and gpio-oe groups each contain 32 lines.
+ * gpio-out is the DATAOUT latch; gpio-oe is high when the driver is enabled.
+ * A board may connect these to a pad model, but no input feedback is implicit.
+ */
+DeviceState *ti8168_gpio_create(Object *parent, const char *name, hwaddr base,
+                                qemu_irq irq0, qemu_irq irq1);
+
+#endif
