+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Partial TI81xx DaVinci EMAC, CPDMA, and MDIO model.
+ * The two PHY slots use synthetic addresses 0 and 1.
+ */
+
+#include "qemu/osdep.h"
+#include "ti8168_internal.h"
+
+#define EMAC_SIZE                       0x4000
+#define EMAC_REGS                       0x1000
+#define MDIO_REGS                       0x0800
+#define MDIO_SIZE                       0x0100
+#define EMAC_CTRL_CMRXINTEN              0x0914
+#define EMAC_CTRL_CMTXINTEN              0x0918
+#define CPDMA_CTRL_RAM                  0x2000
+#define CPDMA_CTRL_RAM_SIZE             0x2000
+#define TI8168_DMA_DIRECT_BASE          0x41000000U
+#define TI8168_DMA_DIRECT_END           0x61000000U
+#define TI8168_DMA_QEMU_OFFSET          0x3f000000U
+#define TI8168_EMAC_PHY_ADDR_ETH0       0
+#define TI8168_EMAC_PHY_ADDR_ETH1       1
+#define TI8168_EMAC_PHY_COUNT            2
+#define TI8168_EMAC_PHY_ALIVE            \
+    (BIT(TI8168_EMAC_PHY_ADDR_ETH0) | BIT(TI8168_EMAC_PHY_ADDR_ETH1))
+
+#define MDIO_VERSION                    0x000
+#define MDIO_CONTROL                    0x004
+#define MDIO_ALIVE                      0x008
+#define MDIO_LINK                       0x00c
+#define MDIO_USERINTRAW                 0x020
+#define MDIO_USERINTMASKED              0x024
+#define MDIO_USERINTMASKSET             0x028
+#define MDIO_USERINTMASKCLEAR           0x02c
+#define MDIO_USERACCESS0                0x080
+#define MDIO_CONTROL_IDLE               BIT(31)
+#define MDIO_CONTROL_ENABLE             BIT(30)
+#define MDIO_ACCESS_GO                  BIT(31)
+#define MDIO_ACCESS_WRITE               BIT(30)
+#define MDIO_ACCESS_ACK                 BIT(29)
+
+#define CPDMA_TXIDVER                   0x000
+#define CPDMA_TXCONTROL                 0x004
+#define CPDMA_RXIDVER                   0x010
+#define CPDMA_RXCONTROL                 0x014
+#define CPDMA_SOFTRESET                 0x01c
+#define CPDMA_DMACONTROL                0x020
+#define CPDMA_DMASTATUS                 0x024
+#define CPDMA_RXBUFFOFS                 0x028
+#define CPDMA_EMCONTROL                 0x02c
+#define CPDMA_TXINTSTATRAW              0x080
+#define CPDMA_TXINTSTATMASKED           0x084
+#define CPDMA_TXINTMASKSET              0x088
+#define CPDMA_TXINTMASKCLEAR            0x08c
+#define CPDMA_MACINVECTOR               0x090
+#define CPDMA_MACEOIVECTOR              0x094
+#define CPDMA_RXINTSTATRAW              0x0a0
+#define CPDMA_RXINTSTATMASKED           0x0a4
+#define CPDMA_RXINTMASKSET              0x0a8
+#define CPDMA_RXINTMASKCLEAR            0x0ac
+#define CPDMA_DMAINTSTATRAW             0x0b0
+#define CPDMA_DMAINTSTATMASKED          0x0b4
+#define CPDMA_DMAINTMASKSET             0x0b8
+#define CPDMA_DMAINTMASKCLEAR           0x0bc
+#define EMAC_RXMBPENABLE                0x100
+#define EMAC_RXUNICASTSET               0x104
+#define EMAC_RXUNICASTCLEAR             0x108
+#define EMAC_RXMAXLEN                   0x10c
+#define EMAC_RXBUFFEROFFSET             0x110
+#define EMAC_MACCONTROL                 0x160
+#define EMAC_MACSTATUS                  0x164
+#define EMAC_EMCONTROL                  0x168
+#define EMAC_FIFOCONTROL                0x16c
+#define EMAC_MACCONFIG                  0x170
+#define EMAC_SOFTRESET                  0x174
+#define EMAC_MACSRCADDRLO               0x1d0
+#define EMAC_MACSRCADDRHI               0x1d4
+#define EMAC_MACADDRLO                  0x500
+#define EMAC_MACADDRHI                  0x504
+#define EMAC_MACINDEX                   0x508
+#define CPDMA_TXHDP                     0x600
+#define CPDMA_RXHDP                     0x620
+#define CPDMA_TXCP                      0x640
+#define CPDMA_RXCP                      0x660
+
+#define CPDMA_SOP                       BIT(31)
+#define CPDMA_EOP                       BIT(30)
+#define CPDMA_OWNER                     BIT(29)
+#define CPDMA_EOQ                       BIT(28)
+#define CPDMA_OVERSIZE                  BIT(24)
+#define CPDMA_DESC_LEN                  0xffff
+#define CPDMA_HOST_ERROR                BIT(1)
