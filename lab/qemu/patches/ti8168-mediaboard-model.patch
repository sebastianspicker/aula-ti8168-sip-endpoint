+
+static void ti8168_mediaboard_validate(const MachineState *machine)
+{
+    const TI8168AulaMachineState *s = TI8168_MEDIABOARD_MACHINE(machine);
+    uint64_t boot_size = s->boot_ram_size ? s->boot_ram_size : machine->ram_size;
+    uint64_t ram_end = (uint64_t)TI8168_RAM_BASE + machine->ram_size;
+
+    if (machine->ram_size != 512 * MiB && machine->ram_size != 1 * GiB &&
+        machine->ram_size != 2 * GiB) {
+        error_report("ti8168-mediaboard requires 512 MiB, 1 GiB, or 2 GiB RAM");
+        exit(EXIT_FAILURE);
+    }
+    /* Subtraction avoids overflow for untrusted uint64 property values. */
+    if (s->boot_ram_start < TI8168_RAM_BASE || s->boot_ram_start >= ram_end ||
+        boot_size > ram_end - s->boot_ram_start ||
+        (s->boot_ram_start & 0xfff) || (boot_size & 0xfff)) {
+        error_report("boot RAM must be a nonempty 4 KiB-aligned window "
+                     "inside mapped DDR");
+        exit(EXIT_FAILURE);
+    }
+    if (machine->smp.cpus != 1) {
+        error_report("ti8168-mediaboard models exactly one Cortex-A8");
+        exit(EXIT_FAILURE);
+    }
+}
+
+static ARMCPU *ti8168_mediaboard_map_memory(TI8168AulaMachineState *s,
+                                       MachineState *machine)
+{
+    MemoryRegion *system_memory = get_system_memory();
+    ARMCPU *cpu = ARM_CPU(cpu_create(machine->cpu_type));
+
+    memory_region_add_subregion(system_memory, TI8168_RAM_BASE, machine->ram);
+    /* The machine retains the region; RAM migration registration needs a Device. */
+    memory_region_init_ram(&s->sram, OBJECT(cpu), "ti8168.sram.4020f800",
+                           TI8168_SRAM_SIZE, &error_fatal);
+    memory_region_add_subregion(system_memory, TI8168_SRAM_BASE, &s->sram);
+    memory_region_init_ram(&s->wfi_barrier, OBJECT(cpu),
+                           "ti8168.sram.wfi-barrier",
+                           TI8168_WFI_BARRIER_SIZE, &error_fatal);
+    memory_region_add_subregion(system_memory, TI8168_WFI_BARRIER_BASE,
+                                &s->wfi_barrier);
+    memory_region_init_ram(&s->dmm_bootstrap, OBJECT(cpu),
+                           "ti8168.dmm-bootstrap",
+                           TI8168_DMM_BOOTSTRAP_SIZE, &error_fatal);
+    memory_region_add_subregion(system_memory, TI8168_DMM_BASE,
+                                &s->dmm_bootstrap);
+    return cpu;
+}
+
+static void ti8168_mediaboard_create_uarts(TI8168AulaMachineState *s,
+                                      DeviceState *intc)
+{
+    MemoryRegion *system_memory = get_system_memory();
+    SerialMM *uart1;
+
+    uart1 = serial_mm_init(system_memory, TI8168_UART1_BASE, 2,
+                           ti8168_intc_get_irq(intc, TI8168_IRQ_UART1),
+                           3000000, serial_hd(0), DEVICE_LITTLE_ENDIAN);
+    serial_mm_enable_omap_compat(uart1);
+    s->early_uart_target = sysbus_mmio_get_region(SYS_BUS_DEVICE(uart1), 0);
+    serial_mm_enable_omap_compat(
+        serial_mm_init(system_memory, TI8168_UART2_BASE, 2,
+                       ti8168_intc_get_irq(intc, TI8168_IRQ_UART2),
+                       3000000, serial_hd(1), DEVICE_LITTLE_ENDIAN));
+    serial_mm_enable_omap_compat(
+        serial_mm_init(system_memory, TI8168_UART3_BASE, 2,
+                       ti8168_intc_get_irq(intc, TI8168_IRQ_UART3),
+                       3000000, serial_hd(2), DEVICE_LITTLE_ENDIAN));
+    /* serial-mm supplies the legacy 16550 window; these cover OMAP probes. */
+    ti8168_probe_create(OBJECT(s), "uart-ext[*]", TI8168_UART1_BASE + 0x20, 0xe0,
+                        PROBE_UART);
+    ti8168_probe_create(OBJECT(s), "uart-ext[*]", TI8168_UART2_BASE + 0x20, 0xe0,
+                        PROBE_UART);
+    ti8168_probe_create(OBJECT(s), "uart-ext[*]", TI8168_UART3_BASE + 0x20, 0xe0,
+                        PROBE_UART);
+}
+
+static void ti8168_mediaboard_create_early_uart_alias(
+    TI8168AulaMachineState *s)
+{
+    MemoryRegion *system_memory = get_system_memory();
+    MemoryRegionSection overlap;
+
+    if (!s->early_uart_base) {
+        return;
+    }
+    if ((s->early_uart_base & 0x1f) ||
+        s->early_uart_base > UINT32_MAX - 0x1f) {
+        error_report("early-uart-base must be a 0x20-aligned ARM32 address");
+        exit(EXIT_FAILURE);
+    }
+    /* Check after all fixed peripherals exist; never shadow another mapping. */
+    overlap = memory_region_find(system_memory, s->early_uart_base, 0x20);
+    if (overlap.mr) {
+        memory_region_unref(overlap.mr);
+        error_report("early-uart-base overlaps mapped memory");
+        exit(EXIT_FAILURE);
+    }
+    memory_region_init_alias(&s->early_uart_alias, OBJECT(s),
+                              "ti8168.early-uart-alias", s->early_uart_target,
+                              0, 0x20);
+    memory_region_add_subregion(system_memory, s->early_uart_base,
+                                &s->early_uart_alias);
+}
+
+static DeviceState *ti8168_mediaboard_create_peripherals(
+    TI8168AulaMachineState *s, DeviceState *intc)
+{
+    static const hwaddr timer_bases[] = {
+        0x4802e000, 0x48040000, 0x48042000, 0x48044000,
+        0x48046000, 0x48048000, 0x4804a000,
+    };
+    static const unsigned timer_irqs[] = { 67, 68, 69, 92, 93, 94, 95 };
+    DeviceState *nand = NULL;
+    DeviceState *prcm = ti8168_prcm_create(OBJECT(s), TI8168_PRCM_BASE);
+    int i;
+
+    for (i = 0; i < ARRAY_SIZE(timer_bases); i++) {
+        DeviceState *timer = ti8168_timer_create(
+            OBJECT(s), timer_bases[i], ti8168_intc_get_irq(intc, timer_irqs[i]),
+            ti8168_prcm_timer_clock(prcm, i));
+
+        qdev_connect_gpio_out_named(prcm, "timer-enable", i,
+                                    qdev_get_gpio_in_named(timer,
+                                                          "module-enable", 0));
+    }
+
+    ti8168_control_create(OBJECT(s), "control-probe", TI8168_CONTROL_BASE,
+                          0x21000, s->control_init_file);
+    ti8168_edma_cc_bootstrap_create(OBJECT(s), TI8168_EDMA_CC_BASE);
+    ti8168_pciess_bootstrap_create(OBJECT(s), TI8168_PCIESS_BASE);
+    ti8168_mcspi_bootstrap_create(OBJECT(s), TI8168_MCSPI_BASE);
+    if (s->nand_profile == TI8168_NAND_SYNTHETIC_READ_ONLY) {
+        nand = ti8168_synthetic_nand_create(OBJECT(s), s->nand_images,
+                                             s->nand_oob_images,
+                                             s->nand_read_only, s->nand_cow);
+    }
+    ti8168_gpmc_create(OBJECT(s), nand, TI8168_GPMC_BASE);
+    ti8168_probe_create(OBJECT(s), "elm-probe", 0x48080000, 0x2000,
+                        PROBE_ELM);
+    return nand;
+}
+
+static void ti8168_mediaboard_add_placeholders(TI8168AulaMachineState *s,
+                                          DeviceState *intc)
+{
+    /* SPRUGX8C table 1-68: GPIO0 IRQ0/1 = 96/97; GPIO1 = 98/99.
+     * No board-specific pad wiring or external input levels are inferred.
+     */
+    ti8168_gpio_create(OBJECT(s), "gpio0", 0x48032000,
+                       ti8168_intc_get_irq(intc, 96),
+                       ti8168_intc_get_irq(intc, 97));
+    ti8168_gpio_create(OBJECT(s), "gpio1", 0x4804c000,
+                       ti8168_intc_get_irq(intc, 98),
+                       ti8168_intc_get_irq(intc, 99));
+    /* Explicit placeholders: every region has a named fidelity gap. */
+    create_unimplemented_device("ti8168.i2c1", 0x48028000, 0x1000);
+    create_unimplemented_device("ti8168.i2c2", 0x4802a000, 0x1000);
+    /* Unimplemented TI8168 peripheral apertures. */
+    create_unimplemented_device("ti8168.mcasp0", 0x48038000, 0x1000);
+    create_unimplemented_device("ti8168.mcasp1", 0x4803c000, 0x1000);
+    create_unimplemented_device("ti8168.mcasp2", 0x48050000, 0x1000);
+    create_unimplemented_device("ti8168.mmc1", 0x48060000, 0x1000);
+    create_unimplemented_device("ti8168.rtc", 0x480c0000, 0x1000);
+    ti8168_watchdog_create(OBJECT(s), 0x480c2000);
+    create_unimplemented_device("ti8168.mailbox", 0x480c8000, 0x1000);
+    ti8168_emac_create(OBJECT(s), "emac0", 0x4a100000,
+                       ti8168_intc_get_irq(intc, TI8168_IRQ_EMAC0_RX_THRESH),
+                       ti8168_intc_get_irq(intc, TI8168_IRQ_EMAC0_RX),
+                       ti8168_intc_get_irq(intc, TI8168_IRQ_EMAC0_TX),
+                       ti8168_intc_get_irq(intc, TI8168_IRQ_EMAC0_MISC));
+    create_unimplemented_device("ti8168.emac1", 0x4a120000, 0x2000);
+    create_unimplemented_device("ti8168.sata", 0x4a140000, 0x10000);
+    create_unimplemented_device("ti8168.usb-otg-hs", 0x47400000, 0x1000);
+    create_unimplemented_device("ti8168.usb", 0x47401000, 0x10000);
+}
+
+static void ti8168_mediaboard_load_kernel(TI8168AulaMachineState *s,
+                                     MachineState *machine, ARMCPU *cpu)
+{
+    s->bootinfo = (struct arm_boot_info) {
+        .ram_size = s->boot_ram_size ? s->boot_ram_size : machine->ram_size,
+        .loader_start = s->boot_ram_start,
+        .board_id = s->boot_machine_id,
+        .kernel_filename = machine->kernel_filename,
+        .kernel_cmdline = machine->kernel_cmdline,
+        .initrd_filename = machine->initrd_filename,
+        .dtb_filename = NULL,
+    };
+    arm_load_kernel(cpu, machine, &s->bootinfo);
+}
+
+static void ti8168_mediaboard_init(MachineState *machine)
+{
+    TI8168AulaMachineState *s = TI8168_MEDIABOARD_MACHINE(machine);
+    ARMCPU *cpu;
+    DeviceState *intc;
+
+    ti8168_mediaboard_validate(machine);
+    cpu = ti8168_mediaboard_map_memory(s, machine);
+    intc = ti8168_intc_create(OBJECT(s), TI8168_INTC_BASE,
+                              qdev_get_gpio_in(DEVICE(cpu), ARM_CPU_IRQ),
+                              qdev_get_gpio_in(DEVICE(cpu), ARM_CPU_FIQ));
+    ti8168_mediaboard_create_uarts(s, intc);
+    ti8168_mediaboard_create_peripherals(s, intc);
+
+    error_setg(&s->migration_blocker,
+               "ti8168-mediaboard has no migration or snapshot state contract");
+    if (migrate_add_blocker(&s->migration_blocker, &error_fatal) < 0) {
+        g_assert_not_reached();
+    }
+    ti8168_mediaboard_add_placeholders(s, intc);
+    ti8168_mediaboard_create_early_uart_alias(s);
+    ti8168_mediaboard_load_kernel(s, machine, cpu);
+}
+
+static void ti8168_mediaboard_machine_class_init(ObjectClass *oc, const void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+
+    mc->desc = "Synthetic TI8168 media board model";
+    mc->init = ti8168_mediaboard_init;
+    mc->default_cpu_type = ARM_CPU_TYPE_NAME("cortex-a8");
+    mc->default_ram_size = TI8168_RAM_SIZE;
+    mc->min_cpus = 1;
+    mc->max_cpus = 1;
+    mc->default_cpus = 1;
+    mc->no_floppy = true;
+    mc->no_cdrom = true;
+    mc->no_parallel = true;
+    mc->default_ram_id = "ti8168.ddr3";
+    object_class_property_add_str(oc, "control-init-file",
+                                  ti8168_get_control_init_file,
+                                  ti8168_set_control_init_file);
+    object_class_property_set_description(oc, "control-init-file",
+        "Optional exact 0x1000-byte little-endian CONTROL initial snapshot");
+    object_class_property_add(oc, "early-uart-base", "uint64",
+                              ti8168_get_early_uart_base,
+                              ti8168_set_early_uart_base, NULL, NULL);
+    object_class_property_set_description(oc, "early-uart-base",
+        "Optional unmapped address for a UART1 legacy-window alias (0 disables)");
+    object_class_property_add(oc, "boot-machine-id", "uint32",
+                              ti8168_get_boot_machine_id,
+                              ti8168_set_boot_machine_id, NULL, NULL);
+    object_class_property_set_description(oc, "boot-machine-id",
+        "Caller-selected ARM Linux machine ID (default 0)");
+    object_class_property_add(oc, "boot-ram-start", "uint64",
+                              ti8168_get_boot_ram_start,
+                              ti8168_set_boot_ram_start, NULL, NULL);
+    object_class_property_set_description(oc, "boot-ram-start",
+        "ARM Linux boot window base inside DDR (default 0x80000000)");
+    object_class_property_add(oc, "boot-ram-size", "uint64",
+                              ti8168_get_boot_ram_size,
+                              ti8168_set_boot_ram_size, NULL, NULL);
+    object_class_property_set_description(oc, "boot-ram-size",
+        "ARM Linux boot window bytes (0 selects full configured DDR capacity)");
+    object_class_property_add_enum(oc, "nand-profile", "TI8168NandProfile",
+                                   &ti8168_nand_profile_lookup,
+                                   ti8168_get_nand_profile,
+                                   ti8168_set_nand_profile);
+    object_class_property_set_description(oc, "nand-profile",
+                                          "none (default) or synthetic-read-only");
+    ADD_TI8168_NAND_MTD_PROPERTIES(oc, 0);
+    ADD_TI8168_NAND_MTD_PROPERTIES(oc, 1);
+    object_class_property_add_str(oc, "nand-image", ti8168_get_nand_image,
+                                  ti8168_set_nand_image);
+    object_class_property_set_description(oc, "nand-image",
+                                          "compatibility alias for nand-mtd0-image");
+    object_class_property_add_str(oc, "nand-oob-image",
+                                  ti8168_get_nand_oob_image,
+                                  ti8168_set_nand_oob_image);
+    object_class_property_set_description(oc, "nand-oob-image",
+                                          "compatibility alias for nand-mtd0-oob-image");
+    object_class_property_add_bool(oc, "nand-read-only",
+                                   ti8168_get_nand_read_only,
+                                   ti8168_set_nand_read_only);
+    object_class_property_add_bool(oc, "nand-cow", ti8168_get_nand_cow,
+                                   ti8168_set_nand_cow);
+    object_class_property_set_description(oc, "nand-cow",
+        "opt-in volatile NAND copy-on-write overlay; backing files stay read-only");
+}
+
+static void ti8168_mediaboard_instance_init(Object *obj)
+{
+    TI8168AulaMachineState *s = TI8168_MEDIABOARD_MACHINE(obj);
+
+    s->nand_read_only = true;
+    s->boot_ram_start = TI8168_RAM_BASE;
+}
+
+static void ti8168_mediaboard_instance_finalize(Object *obj)
+{
+    TI8168AulaMachineState *s = TI8168_MEDIABOARD_MACHINE(obj);
+    unsigned i;
+
+    g_clear_pointer(&s->control_init_file, g_free);
+    for (i = 0; i < ARRAY_SIZE(s->nand_images); i++) {
+        g_clear_pointer(&s->nand_images[i], g_free);
+        g_clear_pointer(&s->nand_oob_images[i], g_free);
+    }
+}
+
+static const TypeInfo ti8168_mediaboard_machine_type_info = {
+    .name = TYPE_TI8168_MEDIABOARD_MACHINE,
+    .parent = TYPE_MACHINE,
+    .instance_size = sizeof(TI8168AulaMachineState),
+    .instance_init = ti8168_mediaboard_instance_init,
+    .instance_finalize = ti8168_mediaboard_instance_finalize,
+    .class_init = ti8168_mediaboard_machine_class_init,
+    .interfaces = arm_machine_interfaces,
+};
+
+static void ti8168_mediaboard_register_types(void)
+{
+    type_register_static(&ti8168_mediaboard_machine_type_info);
+}
+
+type_init(ti8168_mediaboard_register_types)
