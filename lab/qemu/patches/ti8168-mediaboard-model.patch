diff --git a/hw/arm/ti8168_bootstrap.c b/hw/arm/ti8168_bootstrap.c
new file mode 100644
index 0000000..bd8c337
--- /dev/null
+++ b/hw/arm/ti8168_bootstrap.c
@@ -0,0 +1,402 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* TI8168 bootstrap-only EDMA, PCIESS, and McSPI register devices. */
+
+#include "qemu/osdep.h"
+#include "ti8168_internal.h"
+
+OBJECT_DECLARE_SIMPLE_TYPE(TI8168EDMACCBootstrapState,
+                           TI8168_EDMA_CC_BOOTSTRAP)
+OBJECT_DECLARE_SIMPLE_TYPE(TI8168PCIESSBootstrapState,
+                           TI8168_PCIESS_BOOTSTRAP)
+OBJECT_DECLARE_SIMPLE_TYPE(TI8168MCSPIBootstrapState,
+                           TI8168_MCSPI_BOOTSTRAP)
+
+enum {
+    TI8168_EDMA_CC_BOOTSTRAP_SIZE = 0x8000,
+    TI8168_PCIESS_BOOTSTRAP_SIZE = 0x4000,
+    TI8168_MCSPI_BOOTSTRAP_SIZE = 0x100,
+};
+struct TI8168EDMACCBootstrapState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    uint8_t storage[TI8168_EDMA_CC_BOOTSTRAP_SIZE];
+};
+
+static uint64_t ti8168_bootstrap_storage_read(const uint8_t *storage,
+                                               hwaddr offset, unsigned size)
+{
+    switch (size) {
+    case 1: return storage[offset];
+    case 2: return lduw_le_p(storage + offset);
+    case 4: return ldl_le_p(storage + offset);
+    default: g_assert_not_reached();
+    }
+}
+
+static void ti8168_bootstrap_storage_write(uint8_t *storage, hwaddr offset,
+                                            uint64_t value, unsigned size)
+{
+    switch (size) {
+    case 1: storage[offset] = value; return;
+    case 2: stw_le_p(storage + offset, value); return;
+    case 4: stl_le_p(storage + offset, value); return;
+    default: g_assert_not_reached();
+    }
+}
+
+static uint64_t ti8168_edma_cc_bootstrap_read(void *opaque, hwaddr offset,
+                                               unsigned size)
+{
+    TI8168EDMACCBootstrapState *s = opaque;
+
+    return ti8168_bootstrap_storage_read(s->storage, offset, size);
+}
+
+static void ti8168_edma_cc_bootstrap_write(void *opaque, hwaddr offset,
+                                            uint64_t value, unsigned size)
+{
+    TI8168EDMACCBootstrapState *s = opaque;
+
+    ti8168_bootstrap_storage_write(s->storage, offset, value, size);
+}
+
+static bool ti8168_edma_cc_bootstrap_accepts(void *opaque, hwaddr offset,
+                                              unsigned size, bool is_write,
+                                              MemTxAttrs attrs)
+{
+    return (size == 1 || size == 2 || size == 4) &&
+           !(offset & (size - 1)) &&
+           offset <= TI8168_EDMA_CC_BOOTSTRAP_SIZE - size;
+}
+
+static const MemoryRegionOps ti8168_edma_cc_bootstrap_ops = {
+    .read = ti8168_edma_cc_bootstrap_read,
+    .write = ti8168_edma_cc_bootstrap_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {
+        .min_access_size = 1,
+        .max_access_size = 4,
+        .accepts = ti8168_edma_cc_bootstrap_accepts,
+    },
+};
+
+static void ti8168_edma_cc_bootstrap_reset(DeviceState *dev)
+{
+    TI8168EDMACCBootstrapState *s = TI8168_EDMA_CC_BOOTSTRAP(dev);
+
+    memset(s->storage, 0, sizeof(s->storage));
+}
+
+static void ti8168_edma_cc_bootstrap_realize(DeviceState *dev, Error **errp)
+{
+    TI8168EDMACCBootstrapState *s = TI8168_EDMA_CC_BOOTSTRAP(dev);
+
+    memory_region_init_io(&s->iomem, OBJECT(dev), &ti8168_edma_cc_bootstrap_ops,
+                          s, "ti8168.edma-cc-bootstrap",
+                          TI8168_EDMA_CC_BOOTSTRAP_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->iomem);
+}
+
+static void ti8168_edma_cc_bootstrap_class_init(ObjectClass *klass,
+                                                 const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = ti8168_edma_cc_bootstrap_realize;
+    device_class_set_legacy_reset(dc, ti8168_edma_cc_bootstrap_reset);
+}
+
+static const TypeInfo ti8168_edma_cc_bootstrap_type_info = {
+    .name = TYPE_TI8168_EDMA_CC_BOOTSTRAP,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(TI8168EDMACCBootstrapState),
+    .class_init = ti8168_edma_cc_bootstrap_class_init,
+};
+
+/*
+ * A modeled PCIESS setup reads +0x180c and sets bit 17, then
+ * configures controller setup fields and the 32 outbound translation pairs.
+ * The config routes report only an absent device unless an explicitly selected
+ * controller setup field is selected below.  This object therefore retains
+ * setup storage, but deliberately creates no PCI bus, link, DMA, MSI,
+ * interrupt, or endpoint behaviour.
+ */
+struct TI8168PCIESSBootstrapState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    uint8_t storage[TI8168_PCIESS_BOOTSTRAP_SIZE];
+};
+
+static bool ti8168_pciess_bootstrap_range(hwaddr offset, unsigned size,
+                                          hwaddr base, unsigned length)
+{
+    return offset >= base && offset + size <= base + length;
+}
+
+static bool ti8168_pciess_bootstrap_is_storage(hwaddr offset, unsigned size)
+{
+    static const struct {
+        hwaddr offset;
+        unsigned length;
+    } setup_fields[] = {
+        { 0x004, 4 }, { 0x008, 4 }, { 0x030, 4 },
+        { 0x188, 4 }, { 0x18c, 4 },
+        { 0x100a, 2 }, { 0x1010, 4 }, { 0x1014, 4 }, { 0x101c, 2 },
+        { 0x180c, 4 },
+    };
+
+    for (size_t index = 0; index < ARRAY_SIZE(setup_fields); index++) {
+        if (ti8168_pciess_bootstrap_range(offset, size,
+                                          setup_fields[index].offset,
+                                          setup_fields[index].length)) {
+            return true;
+        }
+    }
+    return ti8168_pciess_bootstrap_range(offset, size, 0x200, 0x100);
+}
+
+static uint64_t ti8168_pciess_bootstrap_absent(unsigned size)
+{
+    switch (size) {
+    case 1:
+        return UINT8_MAX;
+    case 2:
+        return UINT16_MAX;
+    case 4:
+        return UINT32_MAX;
+    default:
+        g_assert_not_reached();
+    }
+}
+
+static uint64_t ti8168_pciess_bootstrap_read(void *opaque, hwaddr offset,
+                                              unsigned size)
+{
+    TI8168PCIESSBootstrapState *s = opaque;
+
+    if (!ti8168_pciess_bootstrap_is_storage(offset, size)) {
+        return ti8168_pciess_bootstrap_absent(size);
+    }
+    return ti8168_bootstrap_storage_read(s->storage, offset, size);
+}
+
+static void ti8168_pciess_bootstrap_write(void *opaque, hwaddr offset,
+                                           uint64_t value, unsigned size)
+{
+    TI8168PCIESSBootstrapState *s = opaque;
+
+    if (!ti8168_pciess_bootstrap_is_storage(offset, size)) {
+        return;
+    }
+    ti8168_bootstrap_storage_write(s->storage, offset, value, size);
+}
+
+static bool ti8168_pciess_bootstrap_accepts(void *opaque, hwaddr offset,
+                                             unsigned size, bool is_write,
+                                             MemTxAttrs attrs)
+{
+    return (size == 1 || size == 2 || size == 4) &&
+           !(offset & (size - 1)) &&
+           offset <= TI8168_PCIESS_BOOTSTRAP_SIZE - size;
+}
+
+static const MemoryRegionOps ti8168_pciess_bootstrap_ops = {
+    .read = ti8168_pciess_bootstrap_read,
+    .write = ti8168_pciess_bootstrap_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {
+        .min_access_size = 1,
+        .max_access_size = 4,
+        .accepts = ti8168_pciess_bootstrap_accepts,
+    },
+};
+
+static void ti8168_pciess_bootstrap_reset(DeviceState *dev)
+{
+    TI8168PCIESSBootstrapState *s = TI8168_PCIESS_BOOTSTRAP(dev);
+
+    memset(s->storage, 0, sizeof(s->storage));
+}
+
+static void ti8168_pciess_bootstrap_realize(DeviceState *dev, Error **errp)
+{
+    TI8168PCIESSBootstrapState *s = TI8168_PCIESS_BOOTSTRAP(dev);
+
+    memory_region_init_io(&s->iomem, OBJECT(dev), &ti8168_pciess_bootstrap_ops,
+                          s, "ti8168.pciess-bootstrap",
+                          TI8168_PCIESS_BOOTSTRAP_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->iomem);
+}
+
+static void ti8168_pciess_bootstrap_class_init(ObjectClass *klass,
+                                                const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = ti8168_pciess_bootstrap_realize;
+    device_class_set_legacy_reset(dc, ti8168_pciess_bootstrap_reset);
+}
+
+static const TypeInfo ti8168_pciess_bootstrap_type_info = {
+    .name = TYPE_TI8168_PCIESS_BOOTSTRAP,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(TI8168PCIESSBootstrapState),
+    .class_init = ti8168_pciess_bootstrap_class_init,
+};
+
+/*
+ * A modeled McSPI path enables its two clocks, then
+ * writes controller setup words at +0x28, +0x10, +0x20, and conditionally
+ * +0x2c.  The exact 0x100-byte resource is known, but clock-gated live reads
+ * could not recover hardware reset values.  This is therefore a no-device,
+ * writable bootstrap store for only those static accesses.  The documented
+ * reset-completion handshake is also modelled narrowly: a SYSCONFIG.SOFTRESET
+ * bit-1 write makes SYSSTATUS.RESETDONE bit 0 readable.  This is not McSPI,
+ * FIFO, DMA, interrupt, chip-select, or broader reset behaviour.
+ */
+struct TI8168MCSPIBootstrapState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    uint32_t setup[4];
+    bool resetdone;
+};
+
+static int ti8168_mcspi_bootstrap_index(hwaddr offset)
+{
+    switch (offset) {
+    case 0x10:
+        return 0;
+    case 0x20:
+        return 1;
+    case 0x28:
+        return 2;
+    case 0x2c:
+        return 3;
+    default:
+        return -1;
+    }
+}
+
+static uint64_t ti8168_mcspi_bootstrap_read(void *opaque, hwaddr offset,
+                                             unsigned size)
+{
+    TI8168MCSPIBootstrapState *s = opaque;
+    int index = ti8168_mcspi_bootstrap_index(offset);
+
+    if (offset == 0x14) {
+        g_assert(size == 4);
+        return s->resetdone;
+    }
+    g_assert(size == 4 && index >= 0);
+    return s->setup[index];
+}
+
+static void ti8168_mcspi_bootstrap_write(void *opaque, hwaddr offset,
+                                         uint64_t value, unsigned size)
+{
+    TI8168MCSPIBootstrapState *s = opaque;
+    int index = ti8168_mcspi_bootstrap_index(offset);
+
+    g_assert(size == 4 && index >= 0);
+    if (offset == 0x10 && (value & 2)) {
+        /* TI McSPI: software requests reset, then polls RESETDONE. */
+        s->resetdone = true;
+    }
+    s->setup[index] = value;
+}
+
+static bool ti8168_mcspi_bootstrap_accepts(void *opaque, hwaddr offset,
+                                           unsigned size, bool is_write,
+                                           MemTxAttrs attrs)
+{
+    if (size != 4 || (offset & 3)) {
+        return false;
+    }
+    if (offset == 0x14) {
+        return !is_write;
+    }
+    return ti8168_mcspi_bootstrap_index(offset) >= 0;
+}
+
+static const MemoryRegionOps ti8168_mcspi_bootstrap_ops = {
+    .read = ti8168_mcspi_bootstrap_read,
+    .write = ti8168_mcspi_bootstrap_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {
+        .min_access_size = 1,
+        .max_access_size = 4,
+        .accepts = ti8168_mcspi_bootstrap_accepts,
+    },
+};
+
+static void ti8168_mcspi_bootstrap_reset(DeviceState *dev)
+{
+    TI8168MCSPIBootstrapState *s = TI8168_MCSPI_BOOTSTRAP(dev);
+
+    /* Deterministic synthetic model storage. */
+    memset(s->setup, 0, sizeof(s->setup));
+    s->resetdone = false;
+}
+
+static void ti8168_mcspi_bootstrap_realize(DeviceState *dev, Error **errp)
+{
+    TI8168MCSPIBootstrapState *s = TI8168_MCSPI_BOOTSTRAP(dev);
+
+    memory_region_init_io(&s->iomem, OBJECT(dev), &ti8168_mcspi_bootstrap_ops,
+                          s, "ti8168.mcspi-bootstrap",
+                          TI8168_MCSPI_BOOTSTRAP_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->iomem);
+}
+
+static void ti8168_mcspi_bootstrap_class_init(ObjectClass *klass,
+                                               const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = ti8168_mcspi_bootstrap_realize;
+    device_class_set_legacy_reset(dc, ti8168_mcspi_bootstrap_reset);
+}
+
+static const TypeInfo ti8168_mcspi_bootstrap_type_info = {
+    .name = TYPE_TI8168_MCSPI_BOOTSTRAP,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(TI8168MCSPIBootstrapState),
+    .class_init = ti8168_mcspi_bootstrap_class_init,
+};
+
+static void ti8168_bootstrap_create(Object *parent, const char *name,
+                                    const char *type, hwaddr base)
+{
+    DeviceState *dev = qdev_new(type);
+
+    object_property_add_child(parent, name, OBJECT(dev));
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(dev), 0, base);
+}
+
+void ti8168_edma_cc_bootstrap_create(Object *parent, hwaddr base)
+{
+    ti8168_bootstrap_create(parent, "edma-cc-bootstrap",
+                            TYPE_TI8168_EDMA_CC_BOOTSTRAP, base);
+}
+
+void ti8168_pciess_bootstrap_create(Object *parent, hwaddr base)
+{
+    ti8168_bootstrap_create(parent, "pciess-bootstrap",
+                            TYPE_TI8168_PCIESS_BOOTSTRAP, base);
+}
+
+void ti8168_mcspi_bootstrap_create(Object *parent, hwaddr base)
+{
+    ti8168_bootstrap_create(parent, "mcspi-bootstrap",
+                            TYPE_TI8168_MCSPI_BOOTSTRAP, base);
+}
+
+static void ti8168_bootstrap_register_types(void)
+{
+    type_register_static(&ti8168_edma_cc_bootstrap_type_info);
+    type_register_static(&ti8168_pciess_bootstrap_type_info);
+    type_register_static(&ti8168_mcspi_bootstrap_type_info);
+}
+
+type_init(ti8168_bootstrap_register_types)
diff --git a/hw/arm/ti8168_emac.c b/hw/arm/ti8168_emac.c
