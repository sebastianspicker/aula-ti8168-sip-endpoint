@@ -0,0 +1,559 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Synthetic TI8168 media board experiment.
+ *
+ * Register behavior is partial and synthetic.  Machine defaults do not
+ * represent a physical board or a hardware reset snapshot.
+ *
+ * Copyright (c) 2026 Sebastian Spicker
+ *
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/visitor.h"
+#include "hw/gpio/ti8168_gpio.h"
+#include "ti8168_internal.h"
+
+#define TYPE_TI8168_MEDIABOARD_MACHINE MACHINE_TYPE_NAME("ti8168-mediaboard")
+OBJECT_DECLARE_SIMPLE_TYPE(TI8168AulaMachineState, TI8168_MEDIABOARD_MACHINE)
+
+typedef enum TI8168NandProfile {
+    TI8168_NAND_DISABLED,
+    TI8168_NAND_SYNTHETIC_READ_ONLY,
+} TI8168NandProfile;
+
+enum {
+    TI8168_RAM_BASE = 0x80000000,
+    TI8168_RAM_SIZE = 512 * MiB,
+    /* Synthetic SRAM aperture for bounded software tests. */
+    TI8168_SRAM_BASE = 0x4020f800,
+    TI8168_SRAM_SIZE = 0x800,
+    /* TI81xx idle code reads this SRAM page as a WFI ordering barrier. */
+    TI8168_WFI_BARRIER_BASE = 0x40300000,
+    TI8168_WFI_BARRIER_SIZE = 0x1000,
+    /* Synthetic DMM register storage. */
+    TI8168_DMM_BASE = 0x4e000000,
+    TI8168_DMM_BOOTSTRAP_SIZE = 0x1000,
+    TI8168_INTC_BASE = 0x48200000,
+    TI8168_GPMC_BASE = 0x50000000,
+    TI8168_PRCM_BASE = 0x48180000,
+    TI8168_CONTROL_BASE = 0x48140000,
+    /* EDMA CC registers plus exactly 512 32-byte PaRAM entries. */
+    TI8168_EDMA_CC_BASE = 0x49000000,
+    TI8168_EDMA_CC_BOOTSTRAP_SIZE = 0x8000,
+    /* PCIESS setup space only; no PCI fabric or link model is present. */
+    TI8168_PCIESS_BASE = 0x51000000,
+    TI8168_PCIESS_BOOTSTRAP_SIZE = 0x4000,
+    /* Bounded McSPI placeholder; no SPI controller is modelled. */
+    TI8168_MCSPI_BASE = 0x48030100,
+    TI8168_MCSPI_BOOTSTRAP_SIZE = 0x100,
+    TI8168_UART1_BASE = 0x48020000,
+    TI8168_UART2_BASE = 0x48022000,
+    TI8168_UART3_BASE = 0x48024000,
+};
+
+static const char *const ti8168_nand_profile_names[] = {
+    [TI8168_NAND_DISABLED] = "none",
+    [TI8168_NAND_SYNTHETIC_READ_ONLY] = "synthetic-read-only",
+};
+
+static const QEnumLookup ti8168_nand_profile_lookup = {
+    .array = ti8168_nand_profile_names,
+    .size = ARRAY_SIZE(ti8168_nand_profile_names),
+};
+
+enum {
+    TI8168_IRQ_UART1 = 72,
+    TI8168_IRQ_UART2 = 73,
+    TI8168_IRQ_UART3 = 74,
+    TI8168_IRQ_EMAC0_RX_THRESH = 40,
+    TI8168_IRQ_EMAC0_RX = 41,
+    TI8168_IRQ_EMAC0_TX = 42,
+    TI8168_IRQ_EMAC0_MISC = 43,
+    TI8168_NUM_IRQS = 128,
+};
+
+/* OMAP INTCPS register layout used by TI81xx. */
+struct TI8168AulaMachineState {
+    MachineState parent_obj;
+    struct arm_boot_info bootinfo;
+    uint32_t boot_machine_id;
+    uint64_t boot_ram_start;
+    uint64_t boot_ram_size;
+    uint64_t early_uart_base;
+    char *control_init_file;
+    MemoryRegion early_uart_alias;
+    MemoryRegion *early_uart_target;
+    MemoryRegion sram;
+    MemoryRegion wfi_barrier;
+    MemoryRegion dmm_bootstrap;
+    TI8168NandProfile nand_profile;
+    char *nand_images[TI8168_NAND_MTD_COUNT];
+    char *nand_oob_images[TI8168_NAND_MTD_COUNT];
+    bool nand_read_only;
+    bool nand_cow;
+    Error *migration_blocker;
+};
+
+/*
+ * These are caller-supplied Linux boot parameters, independent of DDR size.
+ * A zero boot-ram-size selects the full configured DDR capacity. No vendor
+ * machine identity, reserved-memory arrangement, or firmware is implied.
+ */
+#define DEFINE_TI8168_BOOT_PROPERTY(field, type) \
+static void ti8168_get_##field(Object *obj, Visitor *v, const char *name, \
+                               void *opaque, Error **errp) \
+{ \
+    TI8168AulaMachineState *s = TI8168_MEDIABOARD_MACHINE(obj); \
+    visit_type_##type(v, name, &s->field, errp); \
+} \
+static void ti8168_set_##field(Object *obj, Visitor *v, const char *name, \
+                               void *opaque, Error **errp) \
+{ \
+    TI8168AulaMachineState *s = TI8168_MEDIABOARD_MACHINE(obj); \
+    type##_t value; \
+    if (visit_type_##type(v, name, &value, errp)) { \
+        s->field = value; \
+    } \
+}
+
+DEFINE_TI8168_BOOT_PROPERTY(boot_machine_id, uint32)
+DEFINE_TI8168_BOOT_PROPERTY(boot_ram_start, uint64)
+DEFINE_TI8168_BOOT_PROPERTY(boot_ram_size, uint64)
+DEFINE_TI8168_BOOT_PROPERTY(early_uart_base, uint64)
+
+static char *ti8168_get_control_init_file(Object *obj, Error **errp)
+{
+    return g_strdup(TI8168_MEDIABOARD_MACHINE(obj)->control_init_file);
+}
+
+static void ti8168_set_control_init_file(Object *obj, const char *value,
+                                         Error **errp)
+{
+    TI8168AulaMachineState *s = TI8168_MEDIABOARD_MACHINE(obj);
+
+    g_free(s->control_init_file);
+    s->control_init_file = g_strdup(value);
+}
+
+static int ti8168_get_nand_profile(Object *obj, Error **errp)
+{
+    return TI8168_MEDIABOARD_MACHINE(obj)->nand_profile;
+}
+
+static void ti8168_set_nand_profile(Object *obj, int value, Error **errp)
+{
+    if (value < TI8168_NAND_DISABLED ||
+        value > TI8168_NAND_SYNTHETIC_READ_ONLY) {
+        error_setg(errp, "invalid ti8168-mediaboard NAND profile");
+        return;
+    }
+    TI8168_MEDIABOARD_MACHINE(obj)->nand_profile = value;
+}
+
+#define DEFINE_TI8168_NAND_MTD_PROPERTIES(index) \
+static char *ti8168_get_nand_mtd##index##_image(Object *obj, Error **errp) \
+{ \
+    return g_strdup(TI8168_MEDIABOARD_MACHINE(obj)->nand_images[index]); \
+} \
+static void ti8168_set_nand_mtd##index##_image(Object *obj, \
+                                                const char *value, \
+                                                Error **errp) \
+{ \
+    TI8168AulaMachineState *s = TI8168_MEDIABOARD_MACHINE(obj); \
+    g_free(s->nand_images[index]); \
+    s->nand_images[index] = g_strdup(value); \
+} \
+static char *ti8168_get_nand_mtd##index##_oob_image(Object *obj, \
+                                                      Error **errp) \
+{ \
+    return g_strdup(TI8168_MEDIABOARD_MACHINE(obj)->nand_oob_images[index]); \
+} \
+static void ti8168_set_nand_mtd##index##_oob_image(Object *obj, \
+                                                    const char *value, \
+                                                    Error **errp) \
+{ \
+    TI8168AulaMachineState *s = TI8168_MEDIABOARD_MACHINE(obj); \
+    g_free(s->nand_oob_images[index]); \
+    s->nand_oob_images[index] = g_strdup(value); \
+}
+
+DEFINE_TI8168_NAND_MTD_PROPERTIES(0)
+DEFINE_TI8168_NAND_MTD_PROPERTIES(1)
+
+#define ADD_TI8168_NAND_MTD_PROPERTIES(oc, index) \
+    object_class_property_add_str(oc, "nand-mtd" #index "-image", \
+                                  ti8168_get_nand_mtd##index##_image, \
+                                  ti8168_set_nand_mtd##index##_image); \
+    object_class_property_set_description(oc, "nand-mtd" #index "-image", \
+                                          "mtd" #index " synthetic bank main image"); \
+    object_class_property_add_str(oc, "nand-mtd" #index "-oob-image", \
+                                  ti8168_get_nand_mtd##index##_oob_image, \
+                                  ti8168_set_nand_mtd##index##_oob_image); \
+    object_class_property_set_description(oc, "nand-mtd" #index "-oob-image", \
+                                          "mtd" #index " synthetic bank OOB image")
+
+static char *ti8168_get_nand_image(Object *obj, Error **errp)
+{
+    return ti8168_get_nand_mtd0_image(obj, errp);
+}
