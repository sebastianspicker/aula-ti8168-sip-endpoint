index 0e0be26..2514645 100644
--- a/hw/char/serial-mm.c
+++ b/hw/char/serial-mm.c
@@ -30,18 +30,102 @@
 #include "qapi/error.h"
 #include "hw/core/qdev-properties.h"

+enum {
+    OMAP_UART_LCR_CONF_MODE_A = 0x80,
+    OMAP_UART_LCR_CONF_MODE_B = 0xbf,
+    OMAP_UART_MCR_TCRTLR = 0x40,
+};
+
+static bool serial_mm_omap_read(SerialMM *smm, hwaddr reg, uint64_t *value)
+{
+    if (!smm->omap_compat) {
+        return false;
+    }
+
+    if (smm->serial.lcr == OMAP_UART_LCR_CONF_MODE_B) {
+        switch (reg) {
+        case 2: *value = smm->omap_efr; return true;
+        case 4: *value = smm->omap_xon1; return true;
+        case 5: *value = smm->omap_xon2; return true;
+        case 6: *value = smm->omap_xoff1; return true;
+        case 7: *value = smm->omap_xoff2; return true;
+        default: break;
+        }
+    }
+    if (smm->serial.lcr == OMAP_UART_LCR_CONF_MODE_A &&
+        smm->omap_mcr_extra & OMAP_UART_MCR_TCRTLR) {
+        if (reg == 6) {
+            *value = smm->omap_tcr;
+            return true;
+        }
+        if (reg == 7) {
+            *value = smm->omap_tlr;
+            return true;
+        }
+    }
+    if (reg == 4) {
+        *value = serial_io_ops.read(&smm->serial, reg, 1) |
+                 smm->omap_mcr_extra;
+        return true;
+    }
+    return false;
+}
+
+static bool serial_mm_omap_write(SerialMM *smm, hwaddr reg, uint8_t value)
+{
+    if (!smm->omap_compat) {
+        return false;
+    }
+
+    if (smm->serial.lcr == OMAP_UART_LCR_CONF_MODE_B) {
+        switch (reg) {
+        case 2: smm->omap_efr = value; return true;
+        case 4: smm->omap_xon1 = value; return true;
+        case 5: smm->omap_xon2 = value; return true;
+        case 6: smm->omap_xoff1 = value; return true;
+        case 7: smm->omap_xoff2 = value; return true;
+        default: break;
+        }
+    }
+    if (smm->serial.lcr == OMAP_UART_LCR_CONF_MODE_A &&
+        smm->omap_mcr_extra & OMAP_UART_MCR_TCRTLR) {
+        if (reg == 6) {
+            smm->omap_tcr = value;
+            return true;
+        }
+        if (reg == 7) {
+            smm->omap_tlr = value;
+            return true;
+        }
+    }
+    if (reg == 4) {
+        smm->omap_mcr_extra = value & OMAP_UART_MCR_TCRTLR;
+    }
+    return false;
+}
+
 static uint64_t serial_mm_read(void *opaque, hwaddr addr, unsigned size)
 {
     SerialMM *s = SERIAL_MM(opaque);
-    return serial_io_ops.read(&s->serial, addr >> s->regshift, 1);
+    hwaddr reg = addr >> s->regshift;
+    uint64_t value;
+
+    if (serial_mm_omap_read(s, reg, &value)) {
+        return value;
+    }
+    return serial_io_ops.read(&s->serial, reg, 1);
 }

 static void serial_mm_write(void *opaque, hwaddr addr,
                             uint64_t value, unsigned size)
 {
     SerialMM *s = SERIAL_MM(opaque);
+    hwaddr reg = addr >> s->regshift;
+
     value &= 255;
-    serial_io_ops.write(&s->serial, addr >> s->regshift, value, 1);
+    if (!serial_mm_omap_write(s, reg, value)) {
+        serial_io_ops.write(&s->serial, reg, value, 1);
+    }
 }

 static const MemoryRegionOps serial_mm_ops[] = {
@@ -116,6 +200,11 @@ SerialMM *serial_mm_init(MemoryRegion *address_space,
     return smm;
 }

+void serial_mm_enable_omap_compat(SerialMM *smm)
+{
+    smm->omap_compat = true;
+}
+
 static void serial_mm_instance_init(Object *o)
 {
     SerialMM *smm = SERIAL_MM(o);
