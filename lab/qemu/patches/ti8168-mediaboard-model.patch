+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Synthetic NAND transport with explicit backing geometry. */
+
+#include "qemu/osdep.h"
+#include "ti8168_internal.h"
+
+OBJECT_DECLARE_SIMPLE_TYPE(TI8168SyntheticNANDState, TI8168_SYNTHETIC_NAND)
+enum {
+    TI8168_SYNTHETIC_NAND_SIZE = 0x20000000,
+    TI8168_SYNTHETIC_NAND_PAGE_SIZE = 0x800,
+    TI8168_SYNTHETIC_NAND_OOB_SIZE = 0x40,
+    TI8168_SYNTHETIC_NAND_PAGE_DATA_SIZE =
+        TI8168_SYNTHETIC_NAND_PAGE_SIZE + TI8168_SYNTHETIC_NAND_OOB_SIZE,
+    TI8168_SYNTHETIC_NAND_PAGES_PER_BLOCK = 0x40,
+    TI8168_SYNTHETIC_NAND_PARAMETER_PAGE_SIZE = 256,
+    TI8168_SYNTHETIC_NAND_ID = 0x00a5f0e1,
+    TI8168_GPMC_NAND_COMMAND = 0x7c,
+    TI8168_GPMC_NAND_ADDRESS = 0x80,
+    TI8168_GPMC_NAND_DATA = 0x84,
+    TI8168_GPMC_CS0_CONFIG1 = 0x60,
+    TI8168_GPMC_CS0_CONFIG7 = 0x78,
+    TI8168_GPMC_CSVALID = BIT(6),
+    TI8168_GPMC_APERTURE_SIZE = 16 * MiB,
+};
+
+typedef enum TI8168SyntheticNandMode {
+    TI8168_NAND_IDLE,
+    TI8168_NAND_READ_ID,
+    TI8168_NAND_READ_PARAMETER_PAGE,
+    TI8168_NAND_READ_STATUS,
+    TI8168_NAND_READ_PAGE,
+    TI8168_NAND_READ_CACHE,
+    TI8168_NAND_PROGRAM,
+    TI8168_NAND_ERASE,
+} TI8168SyntheticNandMode;
+
+typedef struct TI8168NandRegion {
+    uint64_t offset;
+    uint64_t size;
+    uint64_t oob_size;
+    char *image;
+    char *oob_image;
+    GMappedFile *image_map;
+    GMappedFile *oob_map;
+} TI8168NandRegion;
+
+/* A COW page includes main and OOB bytes so program and erase stay atomic. */
+typedef struct TI8168NandCowPage {
+    uint8_t data[TI8168_SYNTHETIC_NAND_PAGE_DATA_SIZE];
+} TI8168NandCowPage;
+
+static const TI8168NandRegion ti8168_nand_region_layout[
+    TI8168_NAND_MTD_COUNT] = {
+    { 0x00000000, 0x10000000, 0x00800000 },
+    { 0x10000000, 0x10000000, 0x00800000 },
+};
+
+struct TI8168SyntheticNANDState {
+    DeviceState parent_obj;
+    uint32_t id;
+    uint32_t page_size;
+    uint32_t oob_size;
+    bool read_only;
+    bool cow;
+    TI8168NandRegion regions[TI8168_NAND_MTD_COUNT];
+    GHashTable *cow_pages;
+    uint8_t address[5];
+    unsigned address_count;
+    uint8_t read_id_address;
+    uint8_t parameter_page[TI8168_SYNTHETIC_NAND_PARAMETER_PAGE_SIZE];
+    uint64_t data_offset;
+    uint64_t main_data_limit;
+    uint64_t data_limit;
+    uint32_t row;
+    uint8_t program_data[TI8168_SYNTHETIC_NAND_PAGE_DATA_SIZE];
+    uint32_t program_count;
+    bool program_error;
+    uint8_t status;
+    TI8168SyntheticNandMode mode;
+};
+
+static void ti8168_synthetic_nand_instance_init(Object *obj);
+static void ti8168_synthetic_nand_init_parameter_page(
+    TI8168SyntheticNANDState *s);
+
+static uint8_t ti8168_synthetic_nand_ready_status(
+    const TI8168SyntheticNANDState *s)
+{
+    return 0x40 | (s->cow ? 0x80 : 0);
+}
+
+static void ti8168_synthetic_nand_fail(TI8168SyntheticNANDState *s,
+                                       const char *operation)
+{
+    s->status = ti8168_synthetic_nand_ready_status(s) | 0x01;
+    qemu_log_mask(LOG_GUEST_ERROR,
+                  "ti8168 synthetic NAND: rejected %s"
+                  " (mode=%u addresses=%u count=%u)\n",
+                  operation, s->mode, s->address_count, s->program_count);
+}
+
+static void ti8168_synthetic_nand_status_fail(TI8168SyntheticNANDState *s)
+{
+    s->status = ti8168_synthetic_nand_ready_status(s) | 0x01;
+}
+
+static TI8168NandRegion *ti8168_synthetic_nand_region(
+    TI8168SyntheticNANDState *s, uint64_t offset)
+{
+    unsigned i;
+
+    for (i = 0; i < ARRAY_SIZE(s->regions); i++) {
+        TI8168NandRegion *region = &s->regions[i];
+
+        if (offset >= region->offset && offset < region->offset + region->size) {
+            return region;
+        }
+    }
+    return NULL;
+}
+
+static gpointer ti8168_synthetic_nand_cow_key(uint32_t row)
+{
+    return GUINT_TO_POINTER(row + 1);
+}
+
+static uint8_t ti8168_synthetic_nand_read_backing(
+    TI8168SyntheticNANDState *s, uint32_t row, uint32_t column)
+{
+    uint64_t page_offset = (uint64_t)row * s->page_size;
+    TI8168NandRegion *region = ti8168_synthetic_nand_region(s, page_offset);
+    uint64_t oob_offset;
+
+    if (!region) {
+        return 0xff;
+    }
+    if (column < s->page_size) {
+        if (!region->image_map) {
+            return 0xff;
+        }
+        return ((const uint8_t *)g_mapped_file_get_contents(region->image_map))[
+            page_offset - region->offset + column];
+    }
+    if (!region->oob_map) {
+        return 0xff;
+    }
+    oob_offset = ((page_offset - region->offset) /
+                  s->page_size) * s->oob_size + column - s->page_size;
+    return oob_offset < region->oob_size ?
+        ((const uint8_t *)g_mapped_file_get_contents(region->oob_map))[oob_offset] :
+        0xff;
+}
+
+static TI8168NandCowPage *ti8168_synthetic_nand_cow_page(
+    TI8168SyntheticNANDState *s, uint32_t row, bool create, bool erased)
+{
+    TI8168NandCowPage *page;
+    unsigned column;
+
+    if (!s->cow_pages) {
+        return NULL;
+    }
+    page = g_hash_table_lookup(s->cow_pages,
+                               ti8168_synthetic_nand_cow_key(row));
+    if (page || !create) {
+        return page;
+    }
+    page = g_new(TI8168NandCowPage, 1);
+    if (erased) {
+        memset(page->data, 0xff, sizeof(page->data));
+    } else {
+        for (column = 0; column < ARRAY_SIZE(page->data); column++) {
+            page->data[column] = ti8168_synthetic_nand_read_backing(
+                s, row, column);
+        }
+    }
+    g_hash_table_insert(s->cow_pages, ti8168_synthetic_nand_cow_key(row),
+                        page);
+    return page;
+}
+
+static uint8_t ti8168_synthetic_nand_read_page_byte(
+    TI8168SyntheticNANDState *s, uint32_t row, uint32_t column)
+{
+    TI8168NandCowPage *page = ti8168_synthetic_nand_cow_page(
+        s, row, false, false);
+
+    if (page) {
+        return page->data[column];
+    }
+    return ti8168_synthetic_nand_read_backing(s, row, column);
+}
+
+static uint8_t ti8168_synthetic_nand_oob(TI8168SyntheticNANDState *s,
+                                         uint64_t offset)
+{
+    return ti8168_synthetic_nand_read_page_byte(s, s->row,
+                                                s->page_size + offset);
+}
+
+static bool ti8168_synthetic_nand_set_read_window(
+    TI8168SyntheticNANDState *s, uint64_t column)
+{
+    uint64_t page_offset = (uint64_t)s->row * s->page_size;
+
+    if (column >= s->page_size + s->oob_size ||
+        page_offset >= TI8168_SYNTHETIC_NAND_SIZE) {
+        ti8168_synthetic_nand_status_fail(s);
+        s->mode = TI8168_NAND_IDLE;
+        return false;
+    }
+    s->data_offset = page_offset + column;
+    s->main_data_limit = ((uint64_t)s->row + 1) * s->page_size;
+    s->data_limit = s->main_data_limit + s->oob_size;
+    s->status = ti8168_synthetic_nand_ready_status(s);
+    s->mode = TI8168_NAND_READ_PAGE;
+    return true;
+}
+
+static void ti8168_synthetic_nand_start_read(TI8168SyntheticNANDState *s)
+{
+    uint64_t column;
+
+    if (s->address_count < 5) {
+        ti8168_synthetic_nand_status_fail(s);
+        s->mode = TI8168_NAND_IDLE;
+        return;
+    }
+    column = s->address[0] | ((uint64_t)s->address[1] << 8);
+    s->row = s->address[2] | ((uint32_t)s->address[3] << 8) |
+             ((uint32_t)s->address[4] << 16);
+    ti8168_synthetic_nand_set_read_window(s, column);
+}
+
+static void ti8168_synthetic_nand_program(TI8168SyntheticNANDState *s)
+{
+    TI8168NandCowPage *page;
+    uint64_t page_offset;
+    uint32_t column;
+    unsigned i;
+
+    if (s->address_count < 5 || s->program_error) {
+        ti8168_synthetic_nand_fail(s, "program");
+        return;
+    }
+    column = s->address[0] | ((uint32_t)s->address[1] << 8);
+    s->row = s->address[2] | ((uint32_t)s->address[3] << 8) |
+             ((uint32_t)s->address[4] << 16);
+    page_offset = (uint64_t)s->row * s->page_size;
+    if (column >= TI8168_SYNTHETIC_NAND_PAGE_DATA_SIZE ||
+        s->program_count > TI8168_SYNTHETIC_NAND_PAGE_DATA_SIZE - column ||
+        page_offset >= TI8168_SYNTHETIC_NAND_SIZE) {
+        ti8168_synthetic_nand_fail(s, "program outside a page");
+        return;
+    }
+    /* Programming preserves every untouched main/OOB byte from backing. */
+    page = ti8168_synthetic_nand_cow_page(s, s->row, true, false);
+    g_assert(page);
+    for (i = 0; i < s->program_count; i++) {
+        page->data[column + i] &= s->program_data[i];
+    }
+    s->status = ti8168_synthetic_nand_ready_status(s);
+}
+
+static void ti8168_synthetic_nand_erase(TI8168SyntheticNANDState *s)
+{
+    uint64_t page_offset;
+    uint32_t first_row;
+    unsigned page;
+
+    if (s->address_count < 3) {
+        ti8168_synthetic_nand_fail(s, "erase");
+        return;
+    }
+    s->row = s->address[0] | ((uint32_t)s->address[1] << 8) |
+             ((uint32_t)s->address[2] << 16);
+    page_offset = (uint64_t)s->row * s->page_size;
+    if (page_offset >= TI8168_SYNTHETIC_NAND_SIZE) {
+        ti8168_synthetic_nand_fail(s, "erase outside NAND");
+        return;
+    }
+    first_row = s->row & ~(TI8168_SYNTHETIC_NAND_PAGES_PER_BLOCK - 1);
+    for (page = 0; page < TI8168_SYNTHETIC_NAND_PAGES_PER_BLOCK; page++) {
+        TI8168NandCowPage *cow_page =
+            ti8168_synthetic_nand_cow_page(s, first_row + page, true, true);
+
+        g_assert(cow_page);
+        memset(cow_page->data, 0xff, sizeof(cow_page->data));
+    }
+    s->status = ti8168_synthetic_nand_ready_status(s);
+}
+
+static void ti8168_synthetic_nand_random_read(TI8168SyntheticNANDState *s)
+{
+    uint64_t column;
+
+    if (s->address_count < 2) {
+        ti8168_synthetic_nand_status_fail(s);
+        s->mode = TI8168_NAND_IDLE;
+        return;
+    }
+    column = s->address[0] | ((uint64_t)s->address[1] << 8);
+    ti8168_synthetic_nand_set_read_window(s, column);
+}
+
+static bool ti8168_synthetic_nand_read_command(TI8168SyntheticNANDState *s,
+                                                uint8_t command)
+{
+    switch (command) {
+    case 0x90: /* READ ID */
+        s->address_count = 0;
+        s->read_id_address = 0;
+        s->data_offset = 0;
+        s->mode = TI8168_NAND_READ_ID;
+        return true;
+    case 0xec: /* READ PARAMETER PAGE */
+        s->data_offset = 0;
+        s->mode = TI8168_NAND_READ_PARAMETER_PAGE;
+        return true;
+    case 0x70: /* STATUS */
+        s->mode = TI8168_NAND_READ_STATUS;
+        return true;
+    case 0x00: /* READ PAGE setup */
+        s->address_count = 0;
+        s->mode = TI8168_NAND_READ_PAGE;
+        return true;
+    case 0x30: /* READ PAGE confirm */
+        ti8168_synthetic_nand_start_read(s);
+        return true;
+    case 0x05: /* RANDOM DATA OUTPUT setup (read cache) */
+        s->address_count = 0;
+        s->mode = TI8168_NAND_READ_CACHE;
+        return true;
+    case 0xe0: /* RANDOM DATA OUTPUT confirm */
+        ti8168_synthetic_nand_random_read(s);
+        return true;
+    default:
+        return false;
+    }
+}
+
+static bool ti8168_synthetic_nand_write_command(TI8168SyntheticNANDState *s,
+                                                 uint8_t command)
+{
+    switch (command) {
+    case 0x80: /* PROGRAM setup */
+        s->address_count = 0;
+        s->program_count = 0;
+        s->program_error = false;
+        s->mode = TI8168_NAND_PROGRAM;
+        if (!s->cow) {
+            ti8168_synthetic_nand_fail(s, "program");
+        }
+        return true;
+    case 0x10: /* PROGRAM confirm */
+        if (s->cow) {
+            ti8168_synthetic_nand_program(s);
+        } else {
+            ti8168_synthetic_nand_fail(s, "program");
+        }
+        s->mode = TI8168_NAND_IDLE;
+        return true;
+    case 0x60: /* ERASE setup */
+        s->address_count = 0;
+        s->mode = TI8168_NAND_ERASE;
+        if (!s->cow) {
+            ti8168_synthetic_nand_fail(s, "erase");
+        }
+        return true;
+    case 0xd0: /* ERASE confirm */
+        if (s->cow) {
+            ti8168_synthetic_nand_erase(s);
+        } else {
+            ti8168_synthetic_nand_fail(s, "erase");
+        }
+        s->mode = TI8168_NAND_IDLE;
+        return true;
+    default:
+        return false;
+    }
+}
+
+static void ti8168_synthetic_nand_do_command(TI8168SyntheticNANDState *s,
+                                              uint8_t command)
+{
+    if (command == 0xff) { /* RESET */
+        s->address_count = 0;
+        s->read_id_address = 0;
+        s->data_offset = 0;
+        s->main_data_limit = 0;
+        s->data_limit = 0;
+        s->status = ti8168_synthetic_nand_ready_status(s);
+        s->mode = TI8168_NAND_IDLE;
+        return;
+    }
+    if (!ti8168_synthetic_nand_read_command(s, command) &&
+        !ti8168_synthetic_nand_write_command(s, command)) {
+        s->mode = TI8168_NAND_IDLE;
+    }
+}
+
+static void ti8168_synthetic_nand_do_address(TI8168SyntheticNANDState *s,
+                                              uint8_t value)
+{
+    if (s->mode == TI8168_NAND_READ_ID && s->address_count == 0) {
+        s->read_id_address = value;
+        s->data_offset = 0;
+    }
+    if (s->address_count < ARRAY_SIZE(s->address)) {
+        s->address[s->address_count++] = value;
+    } else {
+        ti8168_synthetic_nand_status_fail(s);
+    }
+}
+
+static uint8_t ti8168_synthetic_nand_do_data_read(TI8168SyntheticNANDState *s)
+{
+    uint8_t value;
+
+    switch (s->mode) {
+    case TI8168_NAND_READ_ID:
+        if (s->read_id_address == 0x20) {
+            static const uint8_t onfi_signature[] = "ONFI";
+
+            if (s->data_offset >= sizeof(onfi_signature) - 1) {
+                return 0xff;
+            }
+            return onfi_signature[s->data_offset++];
+        }
+        if (s->data_offset >= sizeof(s->id)) {
+            return 0xff;
+        }
+        value = s->id >> (s->data_offset++ * 8);
+        return value;
+    case TI8168_NAND_READ_PARAMETER_PAGE:
+        if (s->data_offset >= sizeof(s->parameter_page)) {
+            return 0xff;
+        }
+        return s->parameter_page[s->data_offset++];
+    case TI8168_NAND_READ_STATUS:
+        return s->status;
+    case TI8168_NAND_READ_PAGE:
+        if (s->data_offset >= s->data_limit) {
+            ti8168_synthetic_nand_status_fail(s);
+            return 0xff;
+        }
+        if (s->data_offset >= s->main_data_limit) {
+            return ti8168_synthetic_nand_oob(
+                s, s->data_offset++ - s->main_data_limit);
+        }
+        value = ti8168_synthetic_nand_read_page_byte(
+            s, s->row, s->data_offset - (uint64_t)s->row * s->page_size);
+        s->data_offset++;
+        return value;
+    default:
+        return 0xff;
+    }
+}
+
+static void ti8168_synthetic_nand_do_data_write(TI8168SyntheticNANDState *s,
+                                                 uint8_t value)
+{
+    if (s->mode == TI8168_NAND_PROGRAM) {
+        if (!s->cow) {
+            ti8168_synthetic_nand_fail(s, "program data");
+        } else if (s->address_count < 5 ||
+                   s->program_count == ARRAY_SIZE(s->program_data)) {
+            s->program_error = true;
+            ti8168_synthetic_nand_fail(s, "program data outside a page");
+        } else {
+            s->program_data[s->program_count++] = value;
+        }
+    }
+}
+
+static void ti8168_synthetic_nand_reset(DeviceState *dev)
+{
+    TI8168SyntheticNANDState *s = TI8168_SYNTHETIC_NAND(dev);
+
+    s->address_count = 0;
+    s->read_id_address = 0;
+    s->data_offset = 0;
+    s->main_data_limit = 0;
+    s->data_limit = 0;
+    s->row = 0;
+    s->program_count = 0;
+    s->program_error = false;
+    s->status = ti8168_synthetic_nand_ready_status(s);
+    s->mode = TI8168_NAND_IDLE;
+}
+
+#include "ti8168_nand_device.inc"
+
+DeviceState *ti8168_synthetic_nand_create(
+    Object *parent, char *const images[TI8168_NAND_MTD_COUNT],
+    char *const oob_images[TI8168_NAND_MTD_COUNT],
+    bool read_only, bool cow)
+{
+    DeviceState *dev = qdev_new(TYPE_TI8168_SYNTHETIC_NAND);
+    TI8168SyntheticNANDState *s = TI8168_SYNTHETIC_NAND(dev);
+    unsigned i;
+
+    object_property_add_child(parent, "synthetic-nand", OBJECT(dev));
+    for (i = 0; i < ARRAY_SIZE(s->regions); i++) {
+        s->regions[i].image = g_strdup(images[i]);
+        s->regions[i].oob_image = g_strdup(oob_images[i]);
+    }
+    qdev_prop_set_bit(dev, "read-only", read_only);
+    qdev_prop_set_bit(dev, "cow", cow);
+    qdev_realize_and_unref(dev, NULL, &error_fatal);
+    return dev;
+}
+
+uint8_t ti8168_synthetic_nand_data_read(DeviceState *dev)
+{
+    return ti8168_synthetic_nand_do_data_read(TI8168_SYNTHETIC_NAND(dev));
+}
+
+void ti8168_synthetic_nand_data_write(DeviceState *dev, uint8_t value)
+{
+    ti8168_synthetic_nand_do_data_write(TI8168_SYNTHETIC_NAND(dev), value);
+}
+
+void ti8168_synthetic_nand_command(DeviceState *dev, uint8_t command)
+{
+    ti8168_synthetic_nand_do_command(TI8168_SYNTHETIC_NAND(dev), command);
+}
+
+void ti8168_synthetic_nand_address(DeviceState *dev, uint8_t value)
+{
+    ti8168_synthetic_nand_do_address(TI8168_SYNTHETIC_NAND(dev), value);
+}
+
+static void ti8168_synthetic_nand_register_types(void)
+{
+    type_register_static(&ti8168_synthetic_nand_type_info);
+}
+
+type_init(ti8168_synthetic_nand_register_types)
diff --git a/hw/arm/ti8168_nand_device.inc b/hw/arm/ti8168_nand_device.inc
new file mode 100644
index 0000000..727cfff
--- /dev/null
+++ b/hw/arm/ti8168_nand_device.inc
@@ -0,0 +1,199 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+static void ti8168_synthetic_nand_init_parameter_page(
+    TI8168SyntheticNANDState *s)
+{
+    uint16_t crc = 0x4f4e;
+    unsigned i;
+
+    memset(s->parameter_page, 0, sizeof(s->parameter_page));
+    memcpy(s->parameter_page, "ONFI", 4);
+    s->parameter_page[4] = 0x02; /* ONFI revision bit 1. */
+    s->parameter_page[80] = 0x00;
+    s->parameter_page[81] = 0x08; /* 0x800-byte main page, little-endian. */
+    s->parameter_page[84] = 0x40;
+    s->parameter_page[92] = 0x40; /* 0x40 pages per block. */
+    s->parameter_page[96] = 0x00;
+    s->parameter_page[97] = 0x10; /* 4096 blocks per LUN: one 512 MiB chip. */
+    s->parameter_page[100] = 0x01;
+    s->parameter_page[101] = 0x32; /* 2 column, 3 row address cycles. */
+
+    for (i = 0; i < sizeof(s->parameter_page) - sizeof(crc); i++) {
+        unsigned bit;
+
+        crc ^= (uint16_t)s->parameter_page[i] << 8;
+        for (bit = 0; bit < 8; bit++) {
+            crc = (crc & 0x8000) ? (crc << 1) ^ 0x8005 : crc << 1;
+        }
+    }
+    s->parameter_page[254] = crc;
+    s->parameter_page[255] = crc >> 8;
+}
+
+static bool ti8168_synthetic_nand_open_region(TI8168NandRegion *region,
+                                               unsigned index, Error **errp)
+{
+    Error *local_err = NULL;
+    GError *map_err = NULL;
+    struct stat st;
+
+    if (!!region->image != !!region->oob_image) {
+        error_setg(errp, "ti8168 NAND mtd%u requires both main and OOB images",
+                   index);
+        return false;
+    }
+    if (!region->image) {
+        return true;
+    }
+    int fd = qemu_open(region->image, O_RDONLY | O_BINARY, &local_err);
+
+    if (fd < 0) {
+        error_propagate(errp, local_err);
+        return false;
+    }
+    if (fstat(fd, &st) < 0 || !S_ISREG(st.st_mode)) {
+        error_setg_errno(errp, errno,
+                         "ti8168 NAND mtd%u main image is not a regular file",
+                         index);
+        close(fd);
+        return false;
+    }
+    if (st.st_size != region->size) {
+        error_setg(errp, "ti8168 NAND mtd%u main image size is 0x%" PRIx64
+                   ", expected 0x%" PRIx64, index, (uint64_t)st.st_size,
+                   region->size);
+        close(fd);
+        return false;
+    }
+    close(fd);
+    region->image_map = g_mapped_file_new(region->image, false, &map_err);
+    if (!region->image_map) {
+        error_setg(errp, "cannot map ti8168 NAND mtd%u main image: %s", index,
+                   map_err->message);
+        g_error_free(map_err);
+        return false;
+    }
+    if (g_mapped_file_get_length(region->image_map) != region->size) {
+        error_setg(errp, "ti8168 NAND mtd%u main image changed while mapping",
+                   index);
+        return false;
+    }
+    fd = qemu_open(region->oob_image, O_RDONLY | O_BINARY, &local_err);
+    if (fd < 0) {
+        error_propagate(errp, local_err);
+        return false;
+    }
+    if (fstat(fd, &st) < 0 || !S_ISREG(st.st_mode)) {
+        error_setg_errno(errp, errno,
+                         "ti8168 NAND mtd%u OOB image is not a regular file",
+                         index);
+        close(fd);
+        return false;
+    }
+    if (st.st_size != region->oob_size) {
+        error_setg(errp, "ti8168 NAND mtd%u OOB image size is 0x%" PRIx64
+                   ", expected 0x%" PRIx64, index, (uint64_t)st.st_size,
+                   region->oob_size);
+        close(fd);
+        return false;
+    }
+    close(fd);
+    region->oob_map = g_mapped_file_new(region->oob_image, false, &map_err);
+    if (!region->oob_map) {
+        error_setg(errp, "cannot map ti8168 NAND mtd%u OOB image: %s", index,
+                   map_err->message);
+        g_error_free(map_err);
+        return false;
+    }
+    if (g_mapped_file_get_length(region->oob_map) != region->oob_size) {
+        error_setg(errp, "ti8168 NAND mtd%u OOB image changed while mapping",
+                   index);
+        return false;
+    }
+    return true;
+}
+
+static void ti8168_synthetic_nand_realize(DeviceState *dev, Error **errp)
+{
+    TI8168SyntheticNANDState *s = TI8168_SYNTHETIC_NAND(dev);
+    unsigned i;
+
+    if (!s->read_only) {
+        error_setg(errp, "ti8168 synthetic NAND rejects writable backends");
+        return;
+    }
+    if (s->page_size != TI8168_SYNTHETIC_NAND_PAGE_SIZE ||
+        s->oob_size != TI8168_SYNTHETIC_NAND_OOB_SIZE) {
+        error_setg(errp, "ti8168 synthetic NAND supports only page-size 0x%x and "
+                   "synthetic erased oob-size 0x%x",
+                   TI8168_SYNTHETIC_NAND_PAGE_SIZE,
+                   TI8168_SYNTHETIC_NAND_OOB_SIZE);
+        return;
+    }
+    for (i = 0; i < ARRAY_SIZE(s->regions); i++) {
+        if (!ti8168_synthetic_nand_open_region(&s->regions[i], i, errp)) {
+            return;
+        }
+    }
+    if (s->cow) {
+        s->cow_pages = g_hash_table_new_full(g_direct_hash, g_direct_equal,
+                                             NULL, g_free);
+    }
+    ti8168_synthetic_nand_init_parameter_page(s);
+}
+
+static void ti8168_synthetic_nand_finalize(Object *obj)
+{
+    TI8168SyntheticNANDState *s = TI8168_SYNTHETIC_NAND(obj);
+
+    unsigned i;
+
+    for (i = 0; i < ARRAY_SIZE(s->regions); i++) {
+        TI8168NandRegion *region = &s->regions[i];
+
+        g_clear_pointer(&region->image_map, g_mapped_file_unref);
+        g_clear_pointer(&region->oob_map, g_mapped_file_unref);
+        g_clear_pointer(&region->image, g_free);
+        g_clear_pointer(&region->oob_image, g_free);
+    }
+    g_clear_pointer(&s->cow_pages, g_hash_table_destroy);
+}
+
+static const Property ti8168_synthetic_nand_properties[] = {
+    DEFINE_PROP_UINT32("id", TI8168SyntheticNANDState, id,
+                       TI8168_SYNTHETIC_NAND_ID),
+    DEFINE_PROP_UINT32("page-size", TI8168SyntheticNANDState, page_size,
+                       TI8168_SYNTHETIC_NAND_PAGE_SIZE),
+    DEFINE_PROP_UINT32("oob-size", TI8168SyntheticNANDState, oob_size,
+                       TI8168_SYNTHETIC_NAND_OOB_SIZE),
+    DEFINE_PROP_BOOL("read-only", TI8168SyntheticNANDState, read_only, true),
+    DEFINE_PROP_BOOL("cow", TI8168SyntheticNANDState, cow, false),
+};
+
+static void ti8168_synthetic_nand_class_init(ObjectClass *klass,
+                                              const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = ti8168_synthetic_nand_realize;
+    device_class_set_legacy_reset(dc, ti8168_synthetic_nand_reset);
+    device_class_set_props(dc, ti8168_synthetic_nand_properties);
+}
+
+static const TypeInfo ti8168_synthetic_nand_type_info = {
+    .name = TYPE_TI8168_SYNTHETIC_NAND,
+    .parent = TYPE_DEVICE,
+    .instance_size = sizeof(TI8168SyntheticNANDState),
+    .instance_init = ti8168_synthetic_nand_instance_init,
+    .class_init = ti8168_synthetic_nand_class_init,
+    .instance_finalize = ti8168_synthetic_nand_finalize,
+};
+
+static void ti8168_synthetic_nand_instance_init(Object *obj)
+{
+    TI8168SyntheticNANDState *s = TI8168_SYNTHETIC_NAND(obj);
+    unsigned i;
+
+    for (i = 0; i < ARRAY_SIZE(s->regions); i++) {
+        s->regions[i] = ti8168_nand_region_layout[i];
+    }
+}
diff --git a/hw/arm/ti8168_prcm.c b/hw/arm/ti8168_prcm.c
new file mode 100644
index 0000000..110b7b5
--- /dev/null
+++ b/hw/arm/ti8168_prcm.c
@@ -0,0 +1,202 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Public DM816x timer-clock subset of PRCM (SPRUGX8C chapter 18). */
+#include "qemu/osdep.h"
+#include "hw/core/qdev-clock.h"
+#include "ti8168_internal.h"
+
+OBJECT_DECLARE_SIMPLE_TYPE(TI8168PRCMState, TI8168_PRCM)
+
+#define TI8168_PRCM_TIMER_COUNT 7
+#define TI8168_PRCM_SIZE 0x4000
+#define TI8168_PRCM_TIMER_CLKSEL 0x390
+#define TI8168_PRCM_TIMER_CLKCTRL 0x1570
+
+struct TI8168PRCMState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    Clock *timer_clock[TI8168_PRCM_TIMER_COUNT];
+    qemu_irq timer_enable[TI8168_PRCM_TIMER_COUNT];
+    uint32_t timer_select[TI8168_PRCM_TIMER_COUNT];
+    uint32_t timer_mode[TI8168_PRCM_TIMER_COUNT];
+    uint32_t clkin_frequency;
+    uint32_t sysclk18_frequency;
+    uint32_t tclkin_frequency;
+    unsigned unimp_logs;
+};
+
+static uint32_t ti8168_prcm_timer_rate(TI8168PRCMState *s, unsigned index)
+{
+    if (s->timer_mode[index] != 2) {
+        return 0;
+    }
+    switch (s->timer_select[index]) {
+    case 0: return s->tclkin_frequency;
+    case 1: return s->sysclk18_frequency;
+    case 2: return s->clkin_frequency;
+    default: g_assert_not_reached();
+    }
+}
+
+static void ti8168_prcm_update_timer(TI8168PRCMState *s, unsigned index)
+{
+    /* Only implemented timers receive an immediate clock/idle handshake. */
+    qemu_set_irq(s->timer_enable[index], s->timer_mode[index] == 2);
+    clock_update_hz(s->timer_clock[index], ti8168_prcm_timer_rate(s, index));
+}
+
+static int ti8168_prcm_timer_index(hwaddr offset, hwaddr base)
+{
+    if (offset < base || offset >= base + TI8168_PRCM_TIMER_COUNT * 4 ||
+        (offset & 3)) {
+        return -1;
+    }
+    return (offset - base) / 4;
+}
+
+static void ti8168_prcm_unimplemented(TI8168PRCMState *s, hwaddr offset,
+                                      bool write)
+{
+    if (s->unimp_logs++ < 16) {
+        qemu_log_mask(LOG_UNIMP, "ti8168-prcm: unimplemented %s offset 0x%"
+                      HWADDR_PRIx "\n", write ? "write" : "read", offset);
+    }
+}
+
+static uint64_t ti8168_prcm_read(void *opaque, hwaddr offset, unsigned size)
+{
+    TI8168PRCMState *s = opaque;
+    int index = ti8168_prcm_timer_index(offset, TI8168_PRCM_TIMER_CLKSEL);
+
+    if (index >= 0) {
+        return s->timer_select[index];
+    }
+    index = ti8168_prcm_timer_index(offset, TI8168_PRCM_TIMER_CLKCTRL);
+    if (index >= 0) {
+        /* Never acknowledge functional state without an available source.
+         * Clock-domain idle requests and finite transition delays are absent. */
+        unsigned idle = s->timer_mode[index] != 2 ? 3 :
+                        ti8168_prcm_timer_rate(s, index) ? 0 : 1;
+
+        return s->timer_mode[index] | (idle << 16);
+    }
+    ti8168_prcm_unimplemented(s, offset, false);
+    return 0;
+}
+
+static void ti8168_prcm_write(void *opaque, hwaddr offset, uint64_t value,
+                               unsigned size)
+{
+    TI8168PRCMState *s = opaque;
+    int index = ti8168_prcm_timer_index(offset, TI8168_PRCM_TIMER_CLKSEL);
+    unsigned field = value & 3;
+
+    if (index >= 0) {
+        if (field == 3) {
+            qemu_log_mask(LOG_GUEST_ERROR,
+                          "ti8168-prcm: reserved timer clock selection ignored\n");
+            return;
+        }
+        s->timer_select[index] = field;
+        ti8168_prcm_update_timer(s, index);
+        return;
+    }
+    index = ti8168_prcm_timer_index(offset, TI8168_PRCM_TIMER_CLKCTRL);
+    if (index >= 0) {
+        if (field != 0 && field != 2) {
+            qemu_log_mask(LOG_GUEST_ERROR,
+                          "ti8168-prcm: reserved timer module mode ignored\n");
+            return;
+        }
+        s->timer_mode[index] = field;
+        ti8168_prcm_update_timer(s, index);
+        return;
+    }
+    ti8168_prcm_unimplemented(s, offset, true);
+}
+
+static const MemoryRegionOps ti8168_prcm_ops = {
+    .read = ti8168_prcm_read,
+    .write = ti8168_prcm_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void ti8168_prcm_reset(DeviceState *dev)
+{
+    TI8168PRCMState *s = TI8168_PRCM(dev);
+    unsigned index;
+
+    /* QEMU machine reset is cold reset; warm-reset control is unimplemented. */
+    s->unimp_logs = 0;
+    for (index = 0; index < TI8168_PRCM_TIMER_COUNT; index++) {
+        s->timer_select[index] = 1;
+        s->timer_mode[index] = 0;
+        ti8168_prcm_update_timer(s, index);
+    }
+}
+
+static void ti8168_prcm_init(Object *obj)
+{
+    TI8168PRCMState *s = TI8168_PRCM(obj);
+    unsigned index;
+
+    memory_region_init_io(&s->iomem, obj, &ti8168_prcm_ops, s,
+                          TYPE_TI8168_PRCM, TI8168_PRCM_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    qdev_init_gpio_out_named(DEVICE(obj), s->timer_enable, "timer-enable",
+                             TI8168_PRCM_TIMER_COUNT);
+    for (index = 0; index < TI8168_PRCM_TIMER_COUNT; index++) {
+        g_autofree char *name = g_strdup_printf("timer%u-fclk", index + 1);
+
+        s->timer_clock[index] = qdev_init_clock_out(DEVICE(obj), name);
+    }
+}
+
+static const Property ti8168_prcm_properties[] = {
+    /* These are explicit inputs to the bounded mux, not an emulated FAPLL. */
+    DEFINE_PROP_UINT32("clkin-frequency", TI8168PRCMState,
+                       clkin_frequency, 27000000),
+    DEFINE_PROP_UINT32("sysclk18-frequency", TI8168PRCMState,
+                       sysclk18_frequency, 32768),
+    DEFINE_PROP_UINT32("tclkin-frequency", TI8168PRCMState,
+                       tclkin_frequency, 0),
+};
+
+static void ti8168_prcm_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    device_class_set_legacy_reset(dc, ti8168_prcm_reset);
+    device_class_set_props(dc, ti8168_prcm_properties);
+}
+
+static const TypeInfo ti8168_prcm_type_info = {
+    .name = TYPE_TI8168_PRCM,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(TI8168PRCMState),
+    .instance_init = ti8168_prcm_init,
+    .class_init = ti8168_prcm_class_init,
+};
+
+DeviceState *ti8168_prcm_create(Object *parent, hwaddr base)
+{
+    DeviceState *dev = qdev_new(TYPE_TI8168_PRCM);
+
+    object_property_add_child(parent, "prcm", OBJECT(dev));
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(dev), 0, base);
+    return dev;
+}
+
+Clock *ti8168_prcm_timer_clock(DeviceState *dev, unsigned index)
+{
+    g_assert(index < TI8168_PRCM_TIMER_COUNT);
+    return TI8168_PRCM(dev)->timer_clock[index];
+}
+
+static void ti8168_prcm_register_types(void)
+{
+    type_register_static(&ti8168_prcm_type_info);
+}
+
+type_init(ti8168_prcm_register_types)
diff --git a/hw/arm/ti8168_probe_regs.c b/hw/arm/ti8168_probe_regs.c
new file mode 100644
index 0000000..bd3e086
--- /dev/null
+++ b/hw/arm/ti8168_probe_regs.c
@@ -0,0 +1,349 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* TI8168 bounded probe-register compatibility device. */
+
+#include "qemu/osdep.h"
+#include "ti8168_internal.h"
+
+OBJECT_DECLARE_SIMPLE_TYPE(TI8168ProbeRegsState, TI8168_PROBE_REGS)
+
+/* These offsets are relative to the UART extension window at UART_BASE + 0x20. */
+enum {
+    TI8168_UART_EXT_MDR1 = 0x00, /* UART_MDR1, absolute offset 0x20 */
+    TI8168_UART_EXT_SCR = 0x20,  /* UART_SCR,  absolute offset 0x40 */
+    TI8168_UART_EXT_SYSC = 0x34, /* UART_SYSC, absolute offset 0x54 */
+    TI8168_UART_EXT_SYSS = 0x38, /* UART_SYSS, absolute offset 0x58 */
+    TI8168_UART_EXT_WER = 0x3c,  /* UART_WER,  absolute offset 0x5c */
+};
+
+struct TI8168ProbeRegsState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    uint32_t role;
+    uint32_t size;
+    uint32_t config;
+    uint32_t mdr1;
+    uint32_t scr;
+    uint16_t wer;
+    char *initial_registers;
+    uint8_t control_initial[0x1000];
+    uint8_t control_regs[0x1000];
+    unsigned unimp_logs;
+};
+
+/* Unknown CONTROL registers use zero-initialized synthetic storage. */
+static void ti8168_probe_log_unimplemented(TI8168ProbeRegsState *s,
+                                            bool write, hwaddr offset,
+                                            uint64_t value)
+{
+    if (s->unimp_logs == 16) {
+        qemu_log_mask(LOG_UNIMP,
+                      "ti8168-probe[%u]: further unimplemented accesses suppressed\n",
+                      s->role);
+    }
+    if (s->unimp_logs++ >= 16) {
+        return;
+    }
+    if (write) {
+        qemu_log_mask(LOG_UNIMP,
+                      "ti8168-probe[%u]: unimplemented write offset 0x%" HWADDR_PRIx
+                      " = 0x%" PRIx64 "\n", s->role, offset, value);
+    } else {
+        qemu_log_mask(LOG_UNIMP,
+                      "ti8168-probe[%u]: unimplemented read offset 0x%" HWADDR_PRIx
+                      "\n", s->role, offset);
+    }
+}
+
+static bool ti8168_probe_control_read(TI8168ProbeRegsState *s, hwaddr offset,
+                                      unsigned size, uint64_t *value)
+{
+    unsigned i;
+
+    if (offset >= sizeof(s->control_regs) ||
+        size > sizeof(s->control_regs) - offset) {
+        return false;
+    }
+    *value = 0;
+    for (i = 0; i < size; i++) {
+        *value |= (uint64_t)s->control_regs[offset + i] << (i * 8);
+    }
+    return true;
+}
+
+static bool ti8168_probe_gpmc_read(TI8168ProbeRegsState *s, hwaddr offset,
+                                   uint64_t *value)
+{
+    switch (offset) {
+    case 0x00: *value = 0x50; return true;
+    case 0x10: *value = s->config; return true;
+    case 0x14: *value = 1; return true;
+    default: return false;
+    }
+}
+
+static bool ti8168_probe_elm_read(TI8168ProbeRegsState *s, hwaddr offset,
+                                  uint64_t *value)
+{
+    switch (offset) {
+    case 0x10: *value = s->config; return true;
+    case 0x14: *value = 1; return true; /* SYSSTATUS.RESETDONE */
+    default: return false;
+    }
+}
+
+static bool ti8168_probe_uart_read(TI8168ProbeRegsState *s, hwaddr offset,
+                                   uint64_t *value)
+{
+    switch (offset) {
+    case TI8168_UART_EXT_MDR1: *value = s->mdr1; return true;
+    case TI8168_UART_EXT_SCR: *value = s->scr; return true;
+    case TI8168_UART_EXT_SYSC: *value = s->config; return true;
+    case TI8168_UART_EXT_SYSS: *value = 1; return true;
+    case TI8168_UART_EXT_WER: *value = s->wer; return true;
+    default: return false;
+    }
+}
+
+static uint64_t ti8168_probe_read(void *opaque, hwaddr offset, unsigned size)
+{
+    TI8168ProbeRegsState *s = opaque;
+    uint64_t value = 0;
+    bool handled = false;
+
+    switch (s->role) {
+    case PROBE_CONTROL:
+        handled = ti8168_probe_control_read(s, offset, size, &value);
+        break;
+    case PROBE_GPMC:
+        handled = ti8168_probe_gpmc_read(s, offset, &value);
+        break;
+    case PROBE_ELM:
+        handled = ti8168_probe_elm_read(s, offset, &value);
+        break;
+    case PROBE_UART:
+        /*
+         * This is an OMAP-UART extension probe stub layered beside serial-mm,
+         * not a claim of an exact UART model.  These reset/poll values let the
+         * early OMAP driver complete its reset and mode-selection probes.
+         */
+        handled = ti8168_probe_uart_read(s, offset, &value);
+        break;
+    case PROBE_PRCM:
+        break;
+    }
+    if (handled) {
+        return value;
+    }
+    ti8168_probe_log_unimplemented(s, false, offset, 0);
+    return 0;
+}
+
+static void ti8168_probe_write(void *opaque, hwaddr offset, uint64_t value,
+                               unsigned size)
+{
+    TI8168ProbeRegsState *s = opaque;
+    if (s->role == PROBE_GPMC && offset == 0x10) {
+        s->config = value & 0x1;
+        return;
+    }
+    if (s->role == PROBE_ELM && offset == 0x10) {
+        s->config = value;
+        return;
+    }
+    if (s->role == PROBE_CONTROL && offset < sizeof(s->control_regs) &&
+        size <= sizeof(s->control_regs) - offset) {
+        unsigned i;
+
+        for (i = 0; i < size; i++) {
+            s->control_regs[offset + i] = value >> (i * 8);
+        }
+        return;
+    }
+    if (s->role == PROBE_UART) {
+        switch (offset) {
+        case TI8168_UART_EXT_MDR1: s->mdr1 = value & 0x7; return;
+        case TI8168_UART_EXT_SCR: s->scr = value & 0xff; return;
+        case TI8168_UART_EXT_SYSC:
+            s->config = value & 0x1;
+            if (value & 0x2) {
+                s->mdr1 = 0x7;
+                s->scr = 0;
+                s->wer = 0;
+            }
+            return;
+        case TI8168_UART_EXT_WER: s->wer = value & 0xffff; return;
+        default: break;
+        }
+    }
+    ti8168_probe_log_unimplemented(s, true, offset, value);
+}
+
+static bool ti8168_probe_accepts(void *opaque, hwaddr offset, unsigned size,
+                                 bool is_write, MemTxAttrs attrs)
+{
+    TI8168ProbeRegsState *s = opaque;
+    if (s->role == PROBE_UART) {
+        return size == 1 || (size == 2 && !(offset & 1)) ||
+               (size == 4 && !(offset & 3));
+    }
+    if (s->role == PROBE_CONTROL && offset < sizeof(s->control_regs)) {
+        return (size == 2 || size == 4) && !(offset & (size - 1)) &&
+               size <= sizeof(s->control_regs) - offset;
+    }
+    return size == 4 && !(offset & 3);
+}
+
+static const MemoryRegionOps ti8168_probe_ops = {
+    .read = ti8168_probe_read,
+    .write = ti8168_probe_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {
+        .min_access_size = 1,
+        .max_access_size = 4,
+        .accepts = ti8168_probe_accepts,
+    },
+};
+
+static void ti8168_probe_reset(DeviceState *dev)
+{
+    TI8168ProbeRegsState *s = TI8168_PROBE_REGS(dev);
+    s->config = 0;
+    s->mdr1 = 0x7;
+    s->scr = 0;
+    s->wer = 0;
+    memcpy(s->control_regs, s->control_initial, sizeof(s->control_regs));
+    s->unimp_logs = 0;
+}
+
+/* Caller-supplied register state is a snapshot, never a reset-value claim. */
+static bool ti8168_probe_load_initial(TI8168ProbeRegsState *s, Error **errp)
+{
+    struct stat st;
+    size_t loaded = 0;
+    int fd;
+
+    if (!s->initial_registers) {
+        return true;
+    }
+    if (s->role != PROBE_CONTROL) {
+        error_setg(errp, "initial-registers is supported only for CONTROL");
+        return false;
+    }
+    /* NONBLOCK prevents a caller-selected FIFO from hanging realization. */
+    fd = qemu_open(s->initial_registers, O_RDONLY | O_NONBLOCK, errp);
+    if (fd < 0) {
+        return false;
+    }
+    if (fstat(fd, &st) < 0) {
+        error_setg_errno(errp, errno, "cannot stat CONTROL initial-registers");
+        close(fd);
+        return false;
+    }
+    if (!S_ISREG(st.st_mode) || st.st_size != sizeof(s->control_initial)) {
+        error_setg(errp, "CONTROL initial-registers must be a regular "
+                   "file of exactly 0x1000 bytes");
+        close(fd);
+        return false;
+    }
+    while (loaded < sizeof(s->control_initial)) {
+        ssize_t result = read(fd, s->control_initial + loaded,
+                              sizeof(s->control_initial) - loaded);
+
+        if (result < 0 && errno == EINTR) {
+            continue;
+        }
+        if (result <= 0) {
+            if (result < 0) {
+                error_setg_errno(errp, errno,
+                                 "cannot read CONTROL initial-registers");
+            } else {
+                error_setg(errp, "short read of CONTROL initial-registers");
+            }
+            close(fd);
+            return false;
+        }
+        loaded += result;
+    }
+    close(fd);
+    memcpy(s->control_regs, s->control_initial, sizeof(s->control_regs));
+    return true;
+}
+
+static void ti8168_probe_realize(DeviceState *dev, Error **errp)
+{
+    TI8168ProbeRegsState *s = TI8168_PROBE_REGS(dev);
+
+    if (!s->size) {
+        error_setg(errp, "ti8168-probe-regs size must be non-zero");
+        return;
+    }
+    if (!ti8168_probe_load_initial(s, errp)) {
+        return;
+    }
+    memory_region_init_io(&s->iomem, OBJECT(dev), &ti8168_probe_ops, s,
+                          "ti8168.probe-regs", s->size);
+    sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->iomem);
+}
+
+static const Property ti8168_probe_properties[] = {
+    DEFINE_PROP_STRING("initial-registers", TI8168ProbeRegsState,
+                       initial_registers),
+    DEFINE_PROP_UINT32("role", TI8168ProbeRegsState, role, PROBE_CONTROL),
+    DEFINE_PROP_UINT32("size", TI8168ProbeRegsState, size, 0x1000),
+};
+
+static void ti8168_probe_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = ti8168_probe_realize;
+    device_class_set_legacy_reset(dc, ti8168_probe_reset);
+    device_class_set_props(dc, ti8168_probe_properties);
+}
+
+static const TypeInfo ti8168_probe_type_info = {
+    .name = TYPE_TI8168_PROBE_REGS,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(TI8168ProbeRegsState),
+    .class_init = ti8168_probe_class_init,
+};
+
+static DeviceState *ti8168_probe_create_initialized(
+    Object *parent, const char *child_name, hwaddr base, uint32_t size,
+    enum TI8168ProbeRole role, const char *initial_registers)
+{
+    DeviceState *dev = qdev_new(TYPE_TI8168_PROBE_REGS);
+
+    object_property_add_child(parent, child_name, OBJECT(dev));
+    qdev_prop_set_uint32(dev, "role", role);
+    if (initial_registers) {
+        qdev_prop_set_string(dev, "initial-registers", initial_registers);
+    }
+    qdev_prop_set_uint32(dev, "size", size);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(dev), 0, base);
+    return dev;
+}
+
+DeviceState *ti8168_probe_create(Object *parent, const char *child_name,
+                                 hwaddr base, uint32_t size,
+                                 enum TI8168ProbeRole role)
+{
+    return ti8168_probe_create_initialized(parent, child_name, base, size,
+                                            role, NULL);
+}
+
+DeviceState *ti8168_control_create(Object *parent, const char *child_name,
+                                   hwaddr base, uint32_t size,
+                                   const char *initial_registers)
+{
+    return ti8168_probe_create_initialized(parent, child_name, base, size,
+                                            PROBE_CONTROL, initial_registers);
+}
+
+static void ti8168_probe_register_types(void)
+{
+    type_register_static(&ti8168_probe_type_info);
+}
+
+type_init(ti8168_probe_register_types)
diff --git a/hw/arm/ti8168_timer.c b/hw/arm/ti8168_timer.c
new file mode 100644
index 0000000..02dd3e8
--- /dev/null
+++ b/hw/arm/ti8168_timer.c
@@ -0,0 +1,412 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* TI8168 dual-mode timer, register contract from SPRUGX8C chapter 21. */
+
+#include "qemu/osdep.h"
+#include "hw/core/qdev-clock.h"
+#include "ti8168_internal.h"
+
+OBJECT_DECLARE_SIMPLE_TYPE(TI8168TimerState, TI8168_TIMER)
+struct TI8168TimerState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    QEMUTimer *qtimer;
+    QEMUTimer *match_timer;
+    Clock *fclk;
+    uint32_t frequency;
+    bool module_enabled;
+    uint32_t config;
+    uint32_t tisr;
+    uint32_t tier;
+    uint32_t twer;
+    uint32_t tclr;
+    uint32_t tcrr;
+    uint32_t tldr;
+    uint32_t tmar;
+    uint32_t tsicr;
+    int64_t started_ns;
+    uint32_t input_fraction; /* Consumed source-clock fraction, /1e9. */
+    uint32_t prescale_progress; /* Whole source clocks toward next count. */
+};
+
+static void ti8168_timer_reset(DeviceState *dev);
+
+static unsigned ti8168_timer_divisor(TI8168TimerState *s)
+{
+    return s->tclr & BIT(5) ? 1U << (((s->tclr >> 2) & 7) + 1) : 1;
+}
+
+static void ti8168_timer_update_irq(TI8168TimerState *s)
+{
+    qemu_set_irq(s->irq, !!(s->tier & s->tisr));
+}
+
+static bool ti8168_timer_running(TI8168TimerState *s)
+{
+    return s->module_enabled && s->frequency && (s->tclr & 1);
+}
+
+static uint64_t ti8168_timer_progress(TI8168TimerState *s, uint32_t *fraction)
+{
+    uint64_t elapsed, clocks, remainder;
+
+    if (!ti8168_timer_running(s)) {
+        *fraction = s->input_fraction;
+        return s->prescale_progress;
+    }
+    elapsed = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) - s->started_ns;
+    clocks = muldiv64(elapsed, s->frequency, NANOSECONDS_PER_SECOND);
+    remainder = (elapsed % NANOSECONDS_PER_SECOND) * s->frequency %
+                NANOSECONDS_PER_SECOND;
+    remainder += s->input_fraction;
+    *fraction = remainder % NANOSECONDS_PER_SECOND;
+    return clocks + s->prescale_progress +
+           remainder / NANOSECONDS_PER_SECOND;
+}
+
+static uint32_t ti8168_timer_count(TI8168TimerState *s)
+{
+    uint32_t fraction;
+    uint64_t ticks = ti8168_timer_progress(s, &fraction) /
+                     ti8168_timer_divisor(s);
+
+    /* The overflow callback owns wrapping and reload, including AR=0 stop. */
+    return s->tcrr + MIN(ticks, (uint64_t)UINT32_MAX - s->tcrr);
+}
+
+static void ti8168_timer_snapshot(TI8168TimerState *s)
+{
+    uint32_t fraction;
+    uint64_t clocks = ti8168_timer_progress(s, &fraction);
+    unsigned divisor = ti8168_timer_divisor(s);
+
+    s->tcrr += MIN(clocks / divisor, (uint64_t)UINT32_MAX - s->tcrr);
+    s->prescale_progress = clocks % divisor;
+    s->input_fraction = fraction;
+    s->started_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+}
+
+static int64_t ti8168_timer_deadline(TI8168TimerState *s, uint64_t ticks)
+{
+    uint64_t clocks = ticks * ti8168_timer_divisor(s) - s->prescale_progress;
+    uint64_t delay = muldiv64(clocks, NANOSECONDS_PER_SECOND, s->frequency);
+    int64_t remainder = (clocks % s->frequency) *
+                        (NANOSECONDS_PER_SECOND % s->frequency) % s->frequency;
+
+    remainder -= s->input_fraction;
+    if (remainder < 0) {
+        uint64_t borrow = (-remainder + s->frequency - 1) / s->frequency;
+
+        delay -= borrow;
+        remainder += borrow * s->frequency;
+    }
+    /* Round upward: an event cannot precede its input-clock edge. */
+    return s->started_ns + delay + !!remainder;
+}
+
+static void ti8168_timer_check_match(TI8168TimerState *s)
+{
+    if ((s->tclr & BIT(6)) && ti8168_timer_count(s) == s->tmar) {
+        s->tisr |= 1;
+        ti8168_timer_update_irq(s);
+    }
+}
+
+static void ti8168_timer_schedule(TI8168TimerState *s)
+{
+    int64_t deadline;
+
+    timer_del(s->qtimer);
+    timer_del(s->match_timer);
+    if (!ti8168_timer_running(s)) {
+        return;
+    }
+    timer_mod(s->qtimer,
+              ti8168_timer_deadline(s, (1ULL << 32) - s->tcrr));
+    if ((s->tclr & BIT(6)) && s->tmar > s->tcrr) {
+        deadline = ti8168_timer_deadline(s, (uint64_t)s->tmar - s->tcrr);
+        if (deadline > qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL)) {
+            timer_mod(s->match_timer, deadline);
+        }
+    }
+}
+
+static void ti8168_timer_match(void *opaque)
+{
+    TI8168TimerState *s = opaque;
+
+    s->tisr |= 1;
+    ti8168_timer_update_irq(s);
+}
+
+static void ti8168_timer_expire(void *opaque)
+{
+    TI8168TimerState *s = opaque;
+    uint32_t fraction;
+
+    /* Retain the continuous input-clock phase at integer-ns delivery time. */
+    ti8168_timer_progress(s, &fraction);
+    s->input_fraction = fraction;
+    s->prescale_progress = 0;
+    s->tisr |= 2;
+    if (s->tclr & 2) {
+        s->tcrr = s->tldr;
+    } else {
+        /* One-shot overflow freezes at zero and clears ST (21.2.1.1). */
+        s->tcrr = 0;
+        s->tclr &= ~1U;
+        s->input_fraction = 0;
+    }
+    s->started_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    ti8168_timer_check_match(s);
+    ti8168_timer_update_irq(s);
+    ti8168_timer_schedule(s);
+}
+
+static void ti8168_timer_clock_update(void *opaque, ClockEvent event)
+{
+    TI8168TimerState *s = opaque;
+
+    if (event == ClockPreUpdate) {
+        ti8168_timer_snapshot(s);
+    } else if (event == ClockUpdate) {
+        s->frequency = clock_get_hz(s->fclk);
+        ti8168_timer_schedule(s);
+    }
+}
+
+static void ti8168_timer_module_enable(void *opaque, int n, int level)
+{
+    TI8168TimerState *s = opaque;
+
+    ti8168_timer_snapshot(s);
+    s->module_enabled = !!level;
+    ti8168_timer_schedule(s);
+}
+
+static uint64_t ti8168_timer_read(void *opaque, hwaddr offset, unsigned size)
+{
+    TI8168TimerState *s = opaque;
+
+    switch (offset) {
+    case 0x00: return 0x4fff1301; /* SPRUGX8C Table 21-7. */
+    case 0x10: return s->config;
+    case 0x20: return 0; /* EOI is unused for the level output. */
+    case 0x24: return s->tisr;
+    case 0x28: return s->tisr & s->tier;
+    case 0x2c:
+    case 0x30: return s->tier;
+    case 0x34: return s->twer;
+    case 0x38: return s->tclr;
+    case 0x3c: return ti8168_timer_count(s);
+    case 0x40: return s->tldr;
+    case 0x44: return UINT32_MAX;
+    case 0x48: return 0; /* TWPS: all writes take effect immediately. */
+    case 0x4c: return s->tmar;
+    case 0x54: return s->tsicr;
+    default: return 0;
+    }
+}
+
+static void ti8168_timer_write(void *opaque, hwaddr offset, uint64_t value,
+                               unsigned size)
+{
+    TI8168TimerState *s = opaque;
+    uint32_t old_count = ti8168_timer_count(s);
+    uint32_t old_tclr = s->tclr;
+
+    switch (offset) {
+    case 0x10:
+        if (value & 1) {
+            ti8168_timer_reset(DEVICE(s));
+        } else {
+            s->config = value & 0xe;
+        }
+        return;
+    case 0x24:
+        s->tisr |= value & 7;
+        ti8168_timer_update_irq(s);
+        return;
+    case 0x28:
+        s->tisr &= ~(value & 7);
+        ti8168_timer_update_irq(s);
+        return;
+    case 0x2c:
+        s->tier |= value & 7;
+        ti8168_timer_update_irq(s);
+        return;
+    case 0x30:
+        s->tier &= ~(value & 7);
+        ti8168_timer_update_irq(s);
+        return;
+    case 0x34: s->twer = value & 7; return;
+    case 0x38:
+        s->tclr = value & 0x7fff;
+        /* Preserve fractional input-clock phase for compare-only changes. */
+        if ((old_tclr ^ s->tclr) & 0x3d) {
+            s->tcrr = old_count;
+            s->started_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+            s->input_fraction = s->prescale_progress = 0;
+        }
+        if (!(old_tclr & BIT(6)) && (s->tclr & BIT(6))) {
+            ti8168_timer_check_match(s);
+        }
+        if (!(old_tclr & 0x300) && (s->tclr & 0x300)) {
+            s->tisr &= ~4U; /* Enabling capture resets capture status. */
+            ti8168_timer_update_irq(s);
+        }
+        ti8168_timer_schedule(s);
+        return;
+    case 0x3c:
+        s->tcrr = value;
+        s->started_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        s->input_fraction = s->prescale_progress = 0;
+        ti8168_timer_check_match(s);
+        ti8168_timer_schedule(s);
+        return;
+    case 0x40: s->tldr = value; return;
+    case 0x44:
+        s->tcrr = s->tldr;
+        s->started_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        s->input_fraction = s->prescale_progress = 0;
+        ti8168_timer_check_match(s);
+        ti8168_timer_schedule(s);
+        return;
+    case 0x4c:
+        s->tmar = value;
+        ti8168_timer_check_match(s);
+        ti8168_timer_schedule(s);
+        return;
+    case 0x54:
+        if (value & 2) {
+            ti8168_timer_reset(DEVICE(s));
+        }
+        s->tsicr = value & 4;
+        return;
+    default: return;
+    }
+}
+
+static MemTxResult ti8168_timer_read_with_attrs(void *opaque, hwaddr offset,
+                                                uint64_t *value, unsigned size,
+                                                MemTxAttrs attrs)
+{
+    TI8168TimerState *s = opaque;
+
+    if (!s->module_enabled) {
+        *value = 0;
+        return MEMTX_ERROR;
+    }
+    *value = ti8168_timer_read(opaque, offset, size);
+    return MEMTX_OK;
+}
+
+static MemTxResult ti8168_timer_write_with_attrs(void *opaque, hwaddr offset,
+                                                 uint64_t value, unsigned size,
+                                                 MemTxAttrs attrs)
+{
+    if (!TI8168_TIMER(opaque)->module_enabled) {
+        return MEMTX_ERROR;
+    }
+    ti8168_timer_write(opaque, offset, value, size);
+    return MEMTX_OK;
+}
+
+static const MemoryRegionOps ti8168_timer_ops = {
+    .read_with_attrs = ti8168_timer_read_with_attrs,
+    .write_with_attrs = ti8168_timer_write_with_attrs,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void ti8168_timer_reset(DeviceState *dev)
+{
+    TI8168TimerState *s = TI8168_TIMER(dev);
+
+    timer_del(s->qtimer);
+    timer_del(s->match_timer);
+    s->config = s->tisr = s->tier = s->twer = s->tclr = s->tsicr = 0;
+    s->tcrr = s->tldr = s->tmar = 0;
+    s->started_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    s->input_fraction = s->prescale_progress = 0;
+    ti8168_timer_update_irq(s);
+}
+
+static void ti8168_timer_unrealize(DeviceState *dev)
+{
+    TI8168TimerState *s = TI8168_TIMER(dev);
+
+    if (s->qtimer) {
+        timer_free(s->qtimer);
+        s->qtimer = NULL;
+    }
+    if (s->match_timer) {
+        timer_free(s->match_timer);
+        s->match_timer = NULL;
+    }
+}
+
+static void ti8168_timer_realize(DeviceState *dev, Error **errp)
+{
+    TI8168TimerState *s = TI8168_TIMER(dev);
+
+    if (!clock_has_source(s->fclk)) {
+        error_setg(errp, "ti8168-timer fclk must be connected to PRCM");
+        return;
+    }
+    s->frequency = clock_get_hz(s->fclk);
+    s->qtimer = timer_new_ns(QEMU_CLOCK_VIRTUAL, ti8168_timer_expire, s);
+    s->match_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, ti8168_timer_match, s);
+}
+
+static void ti8168_timer_init(Object *obj)
+{
+    TI8168TimerState *s = TI8168_TIMER(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->iomem, obj, &ti8168_timer_ops, s,
+                          "ti8168.timer", 0x2000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+    s->fclk = qdev_init_clock_in(DEVICE(obj), "fclk", ti8168_timer_clock_update,
+                                s, ClockPreUpdate | ClockUpdate);
+    qdev_init_gpio_in_named(DEVICE(obj), ti8168_timer_module_enable,
+                            "module-enable", 1);
+}
+
+static void ti8168_timer_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = ti8168_timer_realize;
+    dc->unrealize = ti8168_timer_unrealize;
+    device_class_set_legacy_reset(dc, ti8168_timer_reset);
+}
+
+static const TypeInfo ti8168_timer_type_info = {
+    .name = TYPE_TI8168_TIMER,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(TI8168TimerState),
+    .instance_init = ti8168_timer_init,
+    .class_init = ti8168_timer_class_init,
+};
+
+DeviceState *ti8168_timer_create(Object *parent, hwaddr base, qemu_irq irq,
+                                  Clock *fclk)
+{
+    DeviceState *dev = qdev_new(TYPE_TI8168_TIMER);
+
+    object_property_add_child(parent, "timer[*]", OBJECT(dev));
+    qdev_connect_clock_in(dev, "fclk", fclk);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(dev), 0, base);
+    sysbus_connect_irq(SYS_BUS_DEVICE(dev), 0, irq);
+    return dev;
+}
+
+static void ti8168_timer_register_types(void)
+{
+    type_register_static(&ti8168_timer_type_info);
+}
+
+type_init(ti8168_timer_register_types)
diff --git a/hw/arm/ti8168_watchdog.c b/hw/arm/ti8168_watchdog.c
new file mode 100644
index 0000000..173ae8b
--- /dev/null
+++ b/hw/arm/ti8168_watchdog.c
@@ -0,0 +1,372 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Public TI8168 WDT contract: SPRUGX8C chapter 22; see WATCHDOG.md. */
+#include "qemu/osdep.h"
+#include "ti8168_internal.h"
+#include "system/watchdog.h"
+
+OBJECT_DECLARE_SIMPLE_TYPE(TI8168WatchdogState, TI8168_WATCHDOG)
+
+struct TI8168WatchdogState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    QEMUTimer *event_timer;
+    uint32_t frequency;
+    uint32_t config, status, enable, control, count, load, trigger, delay, spr;
+    uint32_t shadow;
+    unsigned divisor;
+    uint16_t sequence;
+    bool enabled, running, delay_fired;
+    int64_t started_ns, force_at;
+};
+
+static void ti8168_watchdog_reset(DeviceState *dev);
+
+static int64_t wd_now(void)
+{
+    return qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+}
+
+static uint64_t wd_duration(TI8168WatchdogState *s, uint64_t clocks)
+{
+    uint64_t ns;
+
+    if (s->frequency < NANOSECONDS_PER_SECOND &&
+        clocks > muldiv64(INT64_MAX, s->frequency,
+                         NANOSECONDS_PER_SECOND)) {
+        return INT64_MAX;
+    }
+    ns = muldiv64(clocks, NANOSECONDS_PER_SECOND, s->frequency);
+    /* Round up, so a functional edge is never observed early. */
+    return ns + !!((clocks % s->frequency) *
+                   (NANOSECONDS_PER_SECOND % s->frequency) % s->frequency);
+}
+
+static uint32_t wd_count(TI8168WatchdogState *s)
+{
+    uint64_t ticks;
+
+    if (!s->running) {
+        return s->count;
+    }
+    ticks = muldiv64(wd_now() - s->started_ns, s->frequency,
+                     NANOSECONDS_PER_SECOND) / s->divisor;
+    /* The event callback, not a read, owns overflow and automatic reload. */
+    return s->count + MIN(ticks, (uint64_t)UINT32_MAX - s->count);
+}
+
+static void wd_irq(TI8168WatchdogState *s)
+{
+    qemu_set_irq(s->irq, !!(s->status & s->enable));
+}
+
+static int64_t wd_deadline(TI8168WatchdogState *s, uint64_t clocks)
+{
+    uint64_t duration = wd_duration(s, clocks);
+
+    return duration >= INT64_MAX - s->started_ns ? INT64_MAX :
+           s->started_ns + duration;
+}
+
+static int64_t wd_overflow_at(TI8168WatchdogState *s)
+{
+    return wd_deadline(s, ((1ULL << 32) - s->count) * s->divisor);
+}
+
+static int64_t wd_delay_at(TI8168WatchdogState *s)
+{
+    /* Section 22.2.11 gives (WDLY - WLDR + 1) functional periods. */
+    return wd_deadline(s, ((uint64_t)s->delay - s->count + 1) * s->divisor);
+}
+
+static void wd_schedule(TI8168WatchdogState *s)
+{
+    int64_t next = s->force_at;
+
+    timer_del(s->event_timer);
+    if (s->running) {
+        next = MIN(next, wd_overflow_at(s));
+        if (!s->delay_fired && s->delay >= s->count && s->delay >= s->load) {
+            next = MIN(next, wd_delay_at(s));
+        }
+    }
+    if (next != INT64_MAX) {
+        timer_mod(s->event_timer, next);
+    }
+}
+
+static void wd_reload(TI8168WatchdogState *s)
+{
+    s->count = s->load;
+    s->started_ns = wd_now();
+    s->divisor = s->control & BIT(5) ? 1U << ((s->control >> 2) & 7) : 1;
+    s->delay_fired = false;
+    if (s->enabled) {
+        s->running = true;
+    }
+    /* Section 22.2.6: max load triggers reset even when disabled. */
+    s->force_at = s->load == UINT32_MAX ? wd_deadline(s, 1) : INT64_MAX;
+    wd_schedule(s);
+}
+
+static void wd_event(void *opaque)
+{
+    TI8168WatchdogState *s = opaque;
+    int64_t now = wd_now();
+    bool overflow = s->force_at <= now ||
+                    (s->running && wd_overflow_at(s) <= now);
+
+    if (s->running && !s->delay_fired && s->delay >= s->count &&
+        s->delay >= s->load && wd_delay_at(s) <= now) {
+        s->delay_fired = true;
+        s->status |= BIT(1);
+    }
+    if (overflow) {
+        int64_t edge = MIN(s->force_at,
+                          s->running ? wd_overflow_at(s) : INT64_MAX);
+
+        s->status |= BIT(0);
+        s->count = s->load;
+        s->started_ns = edge;
+        s->divisor = s->control & BIT(5) ? 1U << ((s->control >> 2) & 7) : 1;
+        s->delay_fired = false;
+        s->force_at = INT64_MAX;
+        wd_irq(s);
+        wd_schedule(s);
+        /* Default QEMU action is reset; QMP WATCHDOG identifies the cause. */
+        watchdog_perform_action();
+        return;
+    }
+    wd_irq(s);
+    wd_schedule(s);
+}
+
+static void wd_apply(TI8168WatchdogState *s, unsigned reg, uint32_t value)
+{
+    switch (reg) {
+    case 0: /* WCLR */
+    case 1: /* WCRR */
+    case 2: /* WLDR */
+    case 5: /* WDLY */
+        if (s->enabled) {
+            qemu_log_mask(LOG_GUEST_ERROR, "ti8168 WDT: configuration while "
+                          "enabled (SPRUGX8C 22.2.9 requires disable)\n");
+            return;
+        }
+        if (reg == 0) {
+            s->control = value & 0x3c;
+        } else if (reg == 1) {
+            s->count = value;
+            s->started_ns = wd_now();
+        } else if (reg == 2) {
+            s->load = value;
+        } else {
+            s->delay = value;
+        }
+        break;
+    case 3: /* WTGR */
+        if (value != s->trigger) {
+            s->trigger = value;
+            wd_reload(s);
+        }
+        break;
+    case 4: /* WSPR: only low 16 bits participate in the magic sequence. */
+        s->spr = value;
+        if (s->sequence == 0xaaaa && (uint16_t)value == 0x5555) {
+            s->count = wd_count(s);
+            s->enabled = s->running = false;
+            s->sequence = 0;
+        } else if (s->sequence == 0xbbbb && (uint16_t)value == 0x4444) {
+            s->enabled = true;
+            if (!s->running) {
+                s->running = true;
+                s->started_ns = wd_now();
+            }
+            s->sequence = 0;
+        } else {
+            s->sequence = (uint16_t)value;
+        }
+        break;
+    default:
+        g_assert_not_reached();
+    }
+    wd_schedule(s);
+}
+
+static uint32_t wd_reg(TI8168WatchdogState *s, hwaddr offset)
+{
+    switch (offset) {
+    case 0x00: return 0; /* Table 22-12 revision reset value. */
+    case 0x10: return s->config;
+    case 0x14: return 1;
+    case 0x18: return s->status;
+    case 0x1c: return s->enable;
+    case 0x24: return s->control;
+    case 0x28: return wd_count(s);
+    case 0x2c: return s->load;
+    case 0x30: return s->trigger;
+    case 0x34: return 0; /* Nonposted writes complete before MMIO returns. */
+    case 0x44: return s->delay;
+    case 0x48: return s->spr;
+    case 0x54: return s->status;
+    case 0x58: return s->status & s->enable;
+    case 0x5c:
+    case 0x60: return s->enable;
+    default: return 0;
+    }
+}
+
+static uint64_t wd_read(void *opaque, hwaddr offset, unsigned size)
+{
+    TI8168WatchdogState *s = opaque;
+    uint32_t value;
+
+    if (offset == 0x28 && size == 2) {
+        s->shadow = wd_count(s);
+        return s->shadow & 0xffff;
+    }
+    if (offset == 0x2a && size == 2) {
+        return s->shadow >> 16;
+    }
+    value = wd_reg(s, offset & ~3ULL);
+    return size == 2 ? (value >> ((offset & 2) * 8)) & 0xffff : value;
+}
+
+static void wd_write(void *opaque, hwaddr offset, uint64_t value, unsigned size)
+{
+    TI8168WatchdogState *s = opaque;
+    hwaddr reg = offset & ~3ULL;
+    uint32_t shifted = value << ((offset & 2) * 8);
+    unsigned bit;
+
+    switch (reg) {
+    case 0x10:
+        if (size == 2 && (offset & 2)) {
+            return;
+        }
+        s->config = shifted & BIT(5);
+        if (shifted & BIT(1)) {
+            ti8168_watchdog_reset(DEVICE(s));
+        }
+        return;
+    case 0x18:
+    case 0x58: s->status &= ~(shifted & 3); wd_irq(s); return;
+    case 0x1c:
+        if (!(size == 2 && (offset & 2))) {
+            s->enable = shifted & 3;
+            wd_irq(s);
+        }
+        return;
+    case 0x54: s->status |= shifted & 3; wd_irq(s); return;
+    case 0x5c: s->enable |= shifted & 3; wd_irq(s); return;
+    case 0x60: s->enable &= ~(shifted & 3); wd_irq(s); return;
+    case 0x24: bit = 0; break;
+    case 0x28: bit = 1; break;
+    case 0x2c: bit = 2; break;
+    case 0x30: bit = 3; break;
+    case 0x48: bit = 4; break;
+    case 0x44: bit = 5; break;
+    default: return;
+    }
+    if (size == 2) {
+        uint32_t mask = 0xffffU << ((offset & 2) * 8);
+        value = (wd_reg(s, reg) & ~mask) | shifted;
+    }
+    /* SPRUGX8C 22.1.3: this integration supports nonposted writes only.
+     * Model their completed effects, not the unmodeled L4 bus wait states.
+     */
+    wd_apply(s, bit, value);
+}
+
+static const MemoryRegionOps wd_ops = {
+    .read = wd_read,
+    .write = wd_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 2, .max_access_size = 4 },
+    .impl = { .min_access_size = 2, .max_access_size = 4 },
+};
+
+static void ti8168_watchdog_reset(DeviceState *dev)
+{
+    TI8168WatchdogState *s = TI8168_WATCHDOG(dev);
+
+    timer_del(s->event_timer);
+    s->config = s->status = s->enable = s->count = s->trigger = s->delay = 0;
+    s->spr = s->shadow = s->sequence = 0;
+    s->control = BIT(5); /* Table 22-17: PRE=1, PTV=0. */
+    s->load = 0xffffffbe; /* Integration-specific Table 22-2, not generic 22-19. */
+    s->divisor = 1;
+    s->enabled = true;
+    s->running = s->delay_fired = false;
+    s->force_at = INT64_MAX;
+    s->started_ns = wd_now();
+    wd_irq(s);
+}
+
+static void wd_realize(DeviceState *dev, Error **errp)
+{
+    TI8168WatchdogState *s = TI8168_WATCHDOG(dev);
+
+    if (!s->frequency) {
+        error_setg(errp, "ti8168-watchdog frequency must be nonzero");
+        return;
+    }
+    s->event_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, wd_event, s);
+}
+
+static void wd_unrealize(DeviceState *dev)
+{
+    TI8168WatchdogState *s = TI8168_WATCHDOG(dev);
+
+    timer_free(s->event_timer);
+}
+
+static void wd_init(Object *obj)
+{
+    TI8168WatchdogState *s = TI8168_WATCHDOG(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->iomem, obj, &wd_ops, s, "ti8168.watchdog", 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+}
+
+static const Property wd_properties[] = {
+    DEFINE_PROP_UINT32("frequency", TI8168WatchdogState, frequency, 32768),
+};
+
+static void wd_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = wd_realize;
+    dc->unrealize = wd_unrealize;
+    device_class_set_legacy_reset(dc, ti8168_watchdog_reset);
+    device_class_set_props(dc, wd_properties);
+    set_bit(DEVICE_CATEGORY_WATCHDOG, dc->categories);
+}
+
+static const TypeInfo wd_type = {
+    .name = TYPE_TI8168_WATCHDOG,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(TI8168WatchdogState),
+    .instance_init = wd_init,
+    .class_init = wd_class_init,
+};
+
+void ti8168_watchdog_create(Object *parent, hwaddr base)
+{
+    DeviceState *dev = qdev_new(TYPE_TI8168_WATCHDOG);
+
+    object_property_add_child(parent, "watchdog", OBJECT(dev));
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(dev), 0, base);
+    /* SPRUGX8C Table 1-68 provides no MPU INTC source for WDTINT. */
+}
+
+static void wd_register_types(void)
+{
+    type_register_static(&wd_type);
+}
+
+type_init(wd_register_types)
