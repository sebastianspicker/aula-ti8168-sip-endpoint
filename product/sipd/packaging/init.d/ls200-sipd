#!/bin/sh
### BEGIN INIT INFO
# Provides:          ls200-sipd
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:
# Default-Stop:
# Short-Description: disabled LS-200 SIP endpoint service
### END INIT INFO

# Deliberately not installed by the overlay manifest and has no Default-Start
# links. It is a future template, not an enablement mechanism.
case "${1:-}" in
    start)
        echo "ls200-sipd init script is disabled pending operations validation" >&2
        exit 0
        ;;
    stop)
        echo "ls200-sipd init script is disabled pending operations validation" >&2
        exit 0
        ;;
    restart|force-reload|status)
        echo "ls200-sipd init script is disabled pending operations validation" >&2
        exit 3
        ;;
    *)
        echo "usage: $0 {start|stop|restart|status}" >&2
        exit 2
        ;;
esac
