# macOS, editor, and local agent state
.DS_Store
**/.DS_Store
.claude/
.mcp.json
.repowise/
.vscode/

# Python caches and local environments
.pytest_cache/
**/.pytest_cache/
**/__pycache__/
*.py[cod]
.venv/
**/.venv/

# The complete research corpus is private, including decompiled source and docs.
/evidence/
/.agents/

# Central generated state
/.work/

# Ephemeral dependency link created only while console commands run
product/console/web/node_modules/

# Product-sensitive local artifacts. Build, report, and package output belongs
# below .work and is rejected elsewhere by make check-layout.
product/sipd/.cache/
product/sipd/sysroots/
product/sipd/toolchains/
product/sipd/staging/
product/sipd/**/*.pcap
product/sipd/**/*.pcapng
product/sipd/**/*.cap
product/sipd/**/*.log
!product/sipd/tests/tooling/sanitizer-policy-negative.log
!product/sipd/tests/tooling/sanitizer-policy-positive.log
product/sipd/**/*.key
product/sipd/**/*.pem
product/sipd/**/secrets/
product/sipd/**/live-captures/
