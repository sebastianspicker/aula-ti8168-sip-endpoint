# Private research material
/evidence/

# Ephemeral dependency stores. The console helper normally links its store
# below .work, but keep accidental package-manager installs out everywhere.
**/node_modules/
**/.pnpm-store/

# Local environment and credential files. Safe examples may be committed.
**/.env
**/.env.*
**/*.env
**/*.env.*
!**/.env.example
!**/.env.*.example
!**/*.env.example
!**/*.example.env
!**/example.env
**/.ssh/
**/secrets/

